      ],
      "wire": "@sound",
      "put": "match &$ { Some(sound) => buffer.write(SoundEventNetworkType, sound.clone()), None => panic!(\"ExplosionPacket#sound is null; SoundEvent.NETWORK_TYPE has no null wire form\") }",
      "take": "Some(buffer.read(SoundEventNetworkType))"
    },
