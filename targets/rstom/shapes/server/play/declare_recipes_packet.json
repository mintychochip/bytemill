  "tests": "declare_recipes_packet.tests.rs",
  "hooks": {
    "read.after:property_sets_count": [
      "check_size(property_sets_count, i32::MAX);"
    ],
    "read.after:items_count": [
      "check_size(items_count, MAX_ITEMS_PER_PROPERTY);"
    ],
    "read.after:stonecutter_recipes_count": [
      "check_size(stonecutter_recipes_count, MAX_STONECUTTER_RECIPES);"
    ]
  },
  "accepted": [
    {
      "construct": "read_size",
      "reason": "vanilla wins (design doc, known deviations): the wire is the one the BML schema writes; the counts are checked by check_size"
    },
    {
      "construct": ".min(",
      "reason": "the generated read does not reserve capacity up front"
    },
    {
      "construct": ".unwrap_or_else",
      "reason": "the reads look the property and the material up and panic naming them, as the hand reads did"
    },
    {
      "construct": "panic!",
      "reason": "the reads look the property and the material up and panic naming them, as the hand reads did"
    },
    {
      "construct": "MAX_",
      "reason": "the hooks check the same limits"
    }
  ],
