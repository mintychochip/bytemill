  "module_docs": [
    "Port of",
    "`net.minestom.server.network.packet.client.play.ClientDebugSubscriptionRequestPacket`.",
    "",
    "# Local stub",
    "",
    "[`DebugSubscription`] stands in for",
    "`net.minestom.server.network.debug.DebugSubscription`, a sealed interface",
    "whose constants are registered from the debug-subscriptions table. Java",
    "keys the wire value by an `int id` and hands out the singleton for it",
    "(`VAR_INT.transform(DebugSubscription::fromId, DebugSubscription::id)`), so",
    "that is exactly what the port carries; the sixteen registered constants are",
    "the sixteen consecutive ids recorded by `Client2Probe`."
  ],
  "struct": {
    "docs": [
      "Java: `record ClientDebugSubscriptionRequestPacket(Set<DebugSubscription<?>>",
      "subscriptions) implements ClientPacket.Play`.",
      "",
      "Java stores an immutable `Set.copyOf` whose iteration order is the JDK",
      "`HashSet` order and therefore leaks into the wire form; the port keeps the",
      "caller's order in a `Vec` (membership is still a set \u2014 duplicates are",
      "written as written)."
    ],
    "derives": [
      "Clone",
      "Debug",
      "PartialEq",
      "Eq"
    ],
    "form": "braced"
  },
  "fields": [
    {
      "name": "subscriptions",
      "type": "Vec<DebugSubscription>",
      "docs": [
        "Java: `subscriptions()`."
      ],
      "wire": "subscriptions",
      "item": {
        "fields": [
          {
            "name": "_",
            "type": "DebugSubscription",
            "docs": [],
            "write": "$.id",
            "read": "match DebugSubscription::from_id($) { Some(subscription) => subscription, None => panic!(\"NullPointerException\") }"
          }
        ]
      }
    }
  ],
