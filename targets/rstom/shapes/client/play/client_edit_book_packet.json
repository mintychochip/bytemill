    "docs": [
      "Java: `ClientEditBookPacket(int slot, List<String> pages, @Nullable String",
      "title)`.",
      "",
      "# Panics",
      "",
      "Panics with Java's `IllegalArgumentException` message when a page is",
      "longer than [`MAX_PAGE_LENGTH`] or the title longer than",
      "[`MAX_TITLE_LENGTH`]."
    ],
    "body": [
      "        for page in &pages {",
      "            if page.chars().count() > MAX_PAGE_LENGTH as usize {",
      "                panic!(\"Page length cannot be greater than {MAX_PAGE_LENGTH}\");",
      "            }",
      "        }",
      "        if let Some(value) = &title",
      "            && value.chars().count() > MAX_TITLE_LENGTH as usize",
      "        {",
      "            panic!(\"Title length cannot be greater than {MAX_TITLE_LENGTH}\");",
      "        }",
      "        Self { slot, pages, title }"
    ]
  },
