      "Java: `ClientNameItemPacket(String itemName)`.",
      "",
      "# Panics",
      "",
      "Panics with Java's `IllegalArgumentException` message when the name is",
      "longer than [`i16::MAX`], mirroring",
      "`Check.argCondition(itemName.length() > Short.MAX_VALUE, \u2026)`."
    ],
    "body": [
      "        // Java measures UTF-16 code units; a Rust `String` length is the UTF-8",
      "        // code-point count, which never exceeds it for a shorter name.",
      "        if item_name.chars().count() > i16::MAX as usize {",
      "            panic!(\"Item name cannot be longer than Short.MAX_SIZE\");",
      "        }",
      "        Self { item_name }"
    ]
