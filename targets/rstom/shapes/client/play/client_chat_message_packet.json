      "",
      "# Panics",
      "",
      "Panics with Java's `IllegalArgumentException` message when the message is",
      "longer than 256 and when an `ackList` sets a bit outside the 20 bits",
      "`FixedBitSet(20)` accepts."
    ],
    "body": [
      "        if message.chars().count() > 256 {",
      "            panic!(\"Message length cannot be greater than 256\");",
      "        }",
      "        if ack_list >= 1 << 20 {",
      "            panic!(",
      "                \"BitSet is larger than expected size ({}>20)\",",
      "                32 - ack_list.leading_zeros()",
      "            );",
      "        }",
      "        Self {",
