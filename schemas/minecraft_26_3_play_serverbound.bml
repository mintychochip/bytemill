import "std/integers.bml"
import "std/varint.bml"
import "minecraft_core.bml"

packet accept_teleportation {
    teleport_id: varint
    x:           f64be
    y:           f64be
    z:           f64be
    yaw:         f32be
    pitch:       f32be
}

packet attack {
    entity_id: varint
}

packet block_entity_tag_query {
    transaction_id: varint
    location:       position
}

packet bundle_item_selected {
    slot_of_bundle:  varint
    slot_in_bundle: varint
}

packet change_difficulty_serverbound {
    new_difficulty: varint
}

packet change_game_mode {
    game_mode: varint
}

packet chat_ack {
    message_count: varint
}

packet chat_command {
    command: string(32767)
}

packet chat_command_signed {
    command: string(32767)
    timestamp: i64be
    salt: i64be
    argument_signatures_count: varint
    argument_signatures: {
        argument_name: string(16)
        signature:     bytes(256)
    }[] count = argument_signatures_count
    message_count: varint
    acknowledged:  fixed_bitset(20)
    checksum:      i8
}

packet chat {
    message: string(256)
    timestamp: i64be
    salt: i64be
    signature_flag: boolean
    if signature_flag {
        signature: bytes(256)
    }
    message_count: varint
    acknowledged:  fixed_bitset(20)
    checksum:      i8
}

packet chat_session_update {
    session_id: uuid
    expires_at: i64be
    public_key_byte_len: varint
    public_key:          u8[] count = public_key_byte_len
    key_signature_byte_len: varint
    key_signature:          u8[] count = key_signature_byte_len
}

packet chunk_batch_received {
    chunks_per_tick: f32be
}

packet client_command {
    action_id: varint
}

packet client_tick_end {
}

packet command_suggestion {
    transaction_id: varint
    text:           string(32500)
}

packet configuration_acknowledged {
}

packet container_button_click {
    window_id: varint
    button_id: varint
}

packet container_click {
    window_id: varint
    state_id:  varint
    slot:      i16be
    button:    i8
    mode:      varint
    changed_slots_count: varint
    changed_slots: {
        slot_number: i16be
        slot_data:   hashed_slot
    }[] count = changed_slots_count
    carried_item: hashed_slot
}

packet container_close_serverbound {
    window_id: varint
}

packet container_slot_state_changed {
    slot_id:   varint
    window_id: varint
    state:     boolean
}

packet debug_subscription_request {
    subscriptions_count: varint
    subscriptions:         varint[] count = subscriptions_count
}

packet edit_book {
    slot: varint
    entries_count: varint
    entries:       string(1024)[] count = entries_count
    title_flag: boolean
    if title_flag {
        title: string(32)
    }
}

packet entity_tag_query {
    transaction_id: varint
    entity_id:      varint
}

packet jigsaw_generate {
    location:      position
    levels:        varint
    keep_jigsaws: boolean
}

packet lock_difficulty {
    locked: boolean
}

packet move_player_pos {
    x:      f64be
    feet_y: f64be
    z:      f64be
    flags:  i8
}

packet move_player_pos_rot {
    x:      f64be
    feet_y: f64be
    z:      f64be
    yaw:    f32be
    pitch:  f32be
    flags:  i8
}

packet move_player_rot {
    yaw:   f32be
    pitch: f32be
    flags: i8
}

packet move_player_status_only {
    flags: i8
}

packet move_vehicle_serverbound {
    x:         f64be
    y:         f64be
    z:         f64be
    yaw:       f32be
    pitch:     f32be
    on_ground: boolean
}

packet paddle_boat {
    left_paddle_turning:  boolean
    right_paddle_turning: boolean
}

packet pick_item_from_block {
    location:     position
    include_data: boolean
}

packet pick_item_from_entity {
    entity_id:    varint
    include_data: boolean
}

packet place_recipe {
    window_id: varint
    recipe_id: varint
    make_all:  boolean
}

packet player_abilities_serverbound {
    flags: i8
}

packet player_action {
    status:   varint
    location: position
    face:     i8
    sequence: varint
}

packet player_command {
    entity_id:   varint
    action_id:   varint
    jump_boost:  varint
}

packet player_input {
    flags: u8
}

packet player_loaded {
}

packet punch {
}

packet recipe_book_change_settings {
    book_id:        varint
    book_open:      boolean
    filter_active:  boolean
}

packet recipe_book_seen_recipe {
    recipe_id: varint
}

packet rename_item {
    item_name: string(32767)
}

packet seen_advancements {
    action: varint
    if action == 0 {
        tab_id: identifier
    }
}

packet select_trade {
    selected_slot: varint
}

packet set_beacon {
    primary_effect_flag: boolean
    if primary_effect_flag {
        primary_effect: varint
    }
    secondary_effect_flag: boolean
    if secondary_effect_flag {
        secondary_effect: varint
    }
}

packet set_carried_item {
    slot: i16be
}

packet set_command_block {
    location: position
    command:  string(32767)
    mode:     varint
    flags:    i8
}

packet set_command_minecart {
    entity_id:    varint
    command:      string(32767)
    track_output: boolean
}

packet set_creative_mode_slot {
    slot:         i16be
    clicked_item: slot
}

packet set_game_rule {
    rules_count: varint
    rules: {
        name:  identifier
        value: string(32767)
    }[] count = rules_count
}

packet set_jigsaw_block {
    location:           position
    name:               identifier
    target:             identifier
    pool:               identifier
    final_state:        string(32767)
    joint_type:         string(32767)
    selection_priority: varint
    placement_priority: varint
}

packet set_structure_block {
    location: position
    action:   varint
    mode:     varint
    name:     string(32767)
    offset_x: i8
    offset_y: i8
    offset_z: i8
    size_x:   i8
    size_y:   i8
    size_z:   i8
    mirror:   varint
    rotation: varint
    metadata: string(128)
    integrity: f32be
    seed:      varlong
    flags:     i8
}

packet set_test_block {
    position: position
    mode:     varint
    message:  string(32767)
}

packet sign_update {
    location: position
    line_1:   string(384)
    line_2:   string(384)
    line_3:   string(384)
    line_4:   string(384)
    text_slot: varint
}

// OPTIONAL_VAR_INT: 0 means no entity (stop spectating), otherwise the entity id + 1.
packet spectator_action {
    optional_entity_id: varint
}

packet teleport_to_entity {
    target_player: uuid
}

packet test_instance_block_action {
    position: position
    action:   varint
    test_flag: boolean
    if test_flag {
        test: identifier
    }
    size_x:          varint
    size_y:          varint
    size_z:          varint
    rotation:        varint
    ignore_entities: boolean
    status:          varint
    error_message_flag: boolean
    if error_message_flag {
        error_message: text_component
    }
}

packet use_item_on {
    hand:              varint
    location:          position
    face:              varint
    cursor_position_x: f32be
    cursor_position_y: f32be
    cursor_position_z: f32be
    inside_block:      boolean
    world_border_hit:  boolean
    sequence:          varint
}

packet use_item {
    hand:     varint
    sequence: varint
    yaw:      f32be
    pitch:    f32be
}
