            projectiles: slot[] count = projectiles_count
        }    // charged_projectiles
        41 | 66 => {
            contents_count: varint
            contents: slot[] count = contents_count
        }    // bundle_contents, container
        42 => {
            has_potion_id: boolean
            if has_potion_id {
                potion_id: varint
            }
            has_custom_color: boolean
            if has_custom_color {
                custom_color: i32be
            }
            custom_effects_count: varint
            custom_effects: item_potion_effect[] count = custom_effects_count
            has_custom_name: boolean
            if has_custom_name {
                custom_name: string
            }
        }    // potion_contents
        44 => {
            effects_count: varint
            effects: {
                effect: varint
                duration: varint
            }[] count = effects_count
        }    // suspicious_stew_effects
        45 => {
            pages_count: varint
            pages: item_book_page[] count = pages_count
        }    // writable_book_content
        46 => {
            raw_title: string
            has_filtered_title: boolean
            if has_filtered_title {
                filtered_title: string
            }
            author: string
            generation: varint
            pages_count: varint
            pages: item_written_book_page[] count = pages_count
            resolved: boolean
        }    // written_book_content
        47 => {
            material: {
                id: varint
                if id == 0 {
                    data: armor_trim_material
                }
            }
            pattern: {
                id: varint
                if id == 0 {
                    data: armor_trim_pattern
                }
            }
        }    // trim
        52 => {
            has_holder: boolean
            data: match has_holder {
                1 => {
                    data: {
                        id: varint
                        if id == 0 {
                            data: instrument_data
                        }
                    }
                }    // true
                0 => string    // false
                _ => { }
            }
        }    // instrument
        53 => {
            has_holder: boolean
            material: match has_holder {
                1 => {
                    material: {
                        id: varint
                        if id == 0 {
                            data: armor_trim_material
                        }
                    }
                }    // true
                0 => string    // false
                _ => { }
            }
        }    // provides_trim_material
        55 => {
            has_holder: boolean
            song: match has_holder {
                1 => {
                    song: {
                        id: varint
                        if id == 0 {
                            data: jukebox_song_data
                        }
                    }
                }    // true
                0 => string    // false
                _ => { }
            }
        }    // jukebox_playable
        58 => {
            has_global_position: boolean
            if has_global_position {
                global_position: {
                    dimension: string
                    position: position
                }
            }
            tracked: boolean
        }    // lodestone_tracker
        59 => item_firework_explosion    // firework_explosion
        60 => {
            flight_duration: varint
            explosions_count: varint
            explosions: item_firework_explosion[] count = explosions_count
        }    // fireworks
        61 => {
            has_name: boolean
            if has_name {
                name: string
            }
            has_uuid: boolean
            if has_uuid {
                uuid: uuid
            }
            properties_count: varint
            properties: {
                name: string
                value: string
                has_signature: boolean
                if has_signature {
                    signature: string
                }
            }[] count = properties_count
        }    // profile
        63 => {
            layers_count: varint
            layers: banner_pattern_layer[] count = layers_count
        }    // banner_patterns
        65 => {
            decorations_count: varint
            decorations: varint[] count = decorations_count
        }    // pot_decorations
        67 => {
            properties_count: varint
            properties: {
                name: string
                value: string
            }[] count = properties_count
        }    // block_state
        68 => {
            bees_count: varint
            bees: {
                nbt_data: anonymous_nbt
                ticks_in_hive: varint
                min_ticks_in_hive: varint
            }[] count = bees_count
        }    // bees
        71 => item_sound_holder    // break_sound
        86 => {
            has_holder: boolean
            variant: match has_holder {
                1 => varint    // true
                0 => string    // false
                _ => { }
            }
        }    // chicken/variant
        89 => {
            data: {
                id: varint
                if id == 0 {
                    data: entity_metadata_painting_variant
                }
            }
        }    // painting/variant
        _ => { }
    }
}

encoding slot_component_type = varint

encoding slot_display = {
    type: varint
    data: match type {
        0 | 1 => { }    // empty, any_fuel
        2 => varint    // item
        3 => slot    // item_stack
        4 => string    // tag
        5 => {
            base: slot_display
            material: slot_display
            pattern: {
                id: varint
                if id == 0 {
                    data: armor_trim_pattern
                }
            }
        }    // smithing_trim
        6 => {
            input: slot_display
            remainder: slot_display
        }    // with_remainder
        7 => {
            data_count: varint
            data: slot_display[] count = data_count
        }    // composite
        _ => { }
    }
}

encoding sound_source = varint

encoding spawn_info = {
    dimension: varint
    name: string
    hashed_seed: i64be
    gamemode: i8
    previous_gamemode: u8
    is_debug: boolean
    is_flat: boolean
    has_death: boolean
    if has_death {
        death: {
            dimension_name: string
            location: position
        }
    }
    portal_cooldown: varint
    sea_level: varint
}

encoding string = {
    byte_len: varint
    value: bytes(byte_len) as utf8
}

encoding tags = {
    value_count: varint
    value: {
        tag_name: string
        entries_count: varint
        entries: varint[] count = entries_count
    }[] count = value_count
}

encoding untrusted_slot = {
    item_count: varint
    match item_count {
        0 => { }    // 0
        _ => {
            item_id: varint
            added_component_count: varint
            removed_component_count: varint
            components: untrusted_slot_component[] count = added_component_count
            remove_components: {
                type: slot_component_type
            }[] count = removed_component_count
        }
    }
}

encoding untrusted_slot_component = {
    type: slot_component_type
    data: byte_array
}

encoding vec2f = {
    x: f32be
    y: f32be
}

encoding vec3f = {
    x: f32be
    y: f32be
    z: f32be
}

encoding vec3f64 = {
    x: f64be
    y: f64be
    z: f64be
}

encoding vec3i = {
    x: varint
    y: varint
    z: varint
}

encoding vec3i16 = {
    x: i16be
    y: i16be
    z: i16be
}

encoding vec4f = {
    x: f32be
    y: f32be
    z: f32be
    w: f32be
}

// --- packets ---

packet cookie_request_configuration_clientbound {
    cookie: string
}

packet custom_payload_configuration_clientbound {
    channel: string
    data: rest
}

packet disconnect_configuration_clientbound {
    reason: anonymous_nbt
}

packet finish_configuration_configuration_clientbound { }

packet keep_alive_configuration_clientbound {
    keep_alive_id: i64be
}

packet ping_configuration_clientbound {
    id: i32be
}

packet reset_chat { }

packet registry_data {
    id: string
    entries_count: varint
    entries: {
        key: string
        has_value: boolean
        if has_value {
            value: anonymous_nbt
        }
    }[] count = entries_count
}

packet remove_resource_pack_configuration_clientbound {
    has_uuid: boolean
    if has_uuid {
        uuid: uuid
    }
}

packet add_resource_pack_configuration_clientbound {
