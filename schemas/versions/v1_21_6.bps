    details: {
        key: string
        value: string
    }[] count = details_count
}

packet server_links_configuration_clientbound {
    links_count: varint
    links: {
        has_known_type: boolean
        known_type: match has_known_type {
            1 => server_link_type    // true
            _ => { }
        }
        unknown_type: match has_known_type {
            0 => anonymous_nbt    // false
            _ => { }
        }
        link: string
    }[] count = links_count
}

packet clear_dialog_configuration_clientbound { }

packet show_dialog_configuration_clientbound {
    dialog: anonymous_nbt
}

packet settings_configuration_serverbound {
    locale: string
    view_distance: i8
    chat_flags: varint
