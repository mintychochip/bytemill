protocol minecraft @ v1_21_6 {
    id = 771
    frame default {
        length: varint
        id: varint
        payload: rest
    }

    route configuration.clientbound 0x00 => cookie_request_configuration_clientbound
    route configuration.clientbound 0x01 => custom_payload_configuration_clientbound
    route configuration.clientbound 0x02 => disconnect_configuration_clientbound
    route configuration.clientbound 0x03 => finish_configuration_configuration_clientbound
    route configuration.clientbound 0x04 => keep_alive_configuration_clientbound
