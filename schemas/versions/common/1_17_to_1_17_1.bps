import "../../std/integers.bps"
import "../../std/varint.bps"
import "from_1_13.bps"
import "from_1_14.bps"
import "1_13_to_1_20_1.bps"
import "1_13_2_to_1_20_1.bps"

encoding entity_metadata = {
    value: {
        key: u8
        type: varint
        value: match type {
            0 => i8    // 0
            1 | 11 | 13 | 18 => varint    // 1, 11, 13, 18
            2 => f32be    // 2
            3 | 4 => string    // 3, 4
            5 => {
                has_value: boolean
                if has_value {
                    value: string
                }
            }    // 5
            6 => slot    // 6
            7 => boolean    // 7
            8 => {
                pitch: f32be
                yaw: f32be
                roll: f32be
            }    // 8
            9 => position    // 9
            10 => {
                has_value: boolean
                if has_value {
                    value: position
                }
            }    // 10
            12 => {
                has_value: boolean
                if has_value {
                    value: uuid
                }
            }    // 12
            14 => nbt    // 14
            15 => particle    // 15
            16 => {
                villager_type: varint
                villager_profession: varint
                level: varint
            }    // 16
            17 => optvarint    // 17
            _ => { }
        }
    }[] until 0xff
}

encoding particle = {
    particle_id: varint
    data: match particle_id {
        4 | 25 => {
            block_state: varint
        }    // 4, 25
        15 => {
            red: f32be
            green: f32be
            blue: f32be
            scale: f32be
        }    // 15
        16 => {
            from_red: f32be
            from_green: f32be
            from_blue: f32be
            scale: f32be
            to_red: f32be
            to_green: f32be
            to_blue: f32be
        }    // 16
        36 => {
            item: slot
        }    // 36
        37 => {
            origin: position
            position_type: string
            destination: {
                if position_type == "minecraft:block" {
                    value: position
                }
                if position_type == "minecraft:entity" {
                    value: varint
                }
            }
            ticks: varint
        }    // 37
        _ => { }
    }
}

// --- packets ---

packet entity_metadata {
    entity_id: varint
    metadata: entity_metadata
}

packet login {
    entity_id: i32be
    is_hardcore: boolean
    game_mode: u8
    previous_game_mode: i8
    world_names_count: varint
    world_names: string[] count = world_names_count
    dimension_codec: nbt
    dimension: nbt
    world_name: string
    hashed_seed: i64be
    max_players: varint
    view_distance: varint
    reduced_debug_info: boolean
    enable_respawn_screen: boolean
    is_debug: boolean
    is_flat: boolean
}

packet map_chunk {
    x: i32be
    z: i32be
    bit_map_count: varint
    bit_map: i64be[] count = bit_map_count
    heightmaps: nbt
    biomes_count: varint
    biomes: varint[] count = biomes_count
    chunk_data_len: varint
    chunk_data: bytes(chunk_data_len)
    block_entities_count: varint
    block_entities: nbt[] count = block_entities_count
}

packet settings {
    locale: string
    view_distance: i8
    chat_flags: varint
    chat_colors: boolean
    skin_parts: u8
    main_hand: varint
    disable_text_filtering: boolean
}

packet world_particles {
    particle_id: i32be
    long_distance: boolean
    x: f64be
    y: f64be
    z: f64be
    offset_x: f32be
    offset_y: f32be
    offset_z: f32be
    particle_data: f32be
    particles: i32be
    data: match particle_id {
        4 | 25 => {
            block_state: varint
        }    // 4, 25
        15 => {
            red: f32be
            green: f32be
            blue: f32be
            scale: f32be
        }    // 15
        16 => {
            from_red: f32be
            from_green: f32be
            from_blue: f32be
            scale: f32be
            to_red: f32be
            to_green: f32be
            to_blue: f32be
        }    // 16
        36 => {
            item: slot
        }    // 36
        37 => {
            origin: position
            position_type: string
            destination: {
                if position_type == "minecraft:block" {
                    value: position
                }
                if position_type == "minecraft:entity" {
                    value: varint
                }
            }
            ticks: varint
        }    // 37
        _ => { }
    }
}

