import "../../std/integers.bml"
import "../../std/varint.bml"
import "from_1_13.bml"
import "from_1_14.bml"
import "from_1_20_2.bml"

packet spectator_action {
    entity_id: optvarint
}

packet success {
    uuid: uuid
    username: string
    properties_count: varint
    properties: {
        name: string
        value: string
        has_signature: boolean
        if has_signature {
            signature: string
        }
    }[] count = properties_count
    session_id: uuid
}

packet teams {
    team: string
    mode: i8
    match mode {
        0 | 2 => {
            name: anonymous_nbt
            prefix: anonymous_nbt
            suffix: anonymous_nbt
            name_tag_visibility: varint
            collision_rule: varint
            has_formatting: boolean
            if has_formatting {
                formatting: varint
            }
            flags: u8
            flags_friendly_fire = (flags & 1) != 0
            flags_see_friendly_invisible = (flags & 2) != 0
        }    // add, change
        _ => { }
    }
    players: match mode {
        0 | 3 | 4 => {
            players_count: varint
            players: string[] count = players_count
        }    // add, join, leave
        _ => { }
    }
}

