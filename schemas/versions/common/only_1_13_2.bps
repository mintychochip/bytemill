import "../../std/integers.bps"
import "../../std/varint.bps"
import "from_1_13.bps"
import "1_13_to_1_21_8.bps"
import "1_13_to_1_20_1.bps"
import "1_13_2_to_1_20_1.bps"
import "1_13_to_1_13_2.bps"

encoding entity_metadata = {
    value: {
        key: u8
        type: varint
        value: match type {
            0 => i8    // 0
            1 | 11 | 13 => varint    // 1, 11, 13
            2 => f32be    // 2
            3 | 4 => string    // 3, 4
            5 => {
                has_value: boolean
                if has_value {
                    value: string
                }
            }    // 5
            6 => slot    // 6
            7 => boolean    // 7
            8 => {
                pitch: f32be
                yaw: f32be
                roll: f32be
            }    // 8
            9 => position    // 9
            10 => {
                has_value: boolean
                if has_value {
                    value: position
                }
            }    // 10
            12 => {
                has_value: boolean
                if has_value {
                    value: uuid
                }
            }    // 12
            14 => nbt    // 14
            15 => particle    // 15
            _ => { }
        }
    }[] until 0xff
}

encoding particle = {
    particle_id: varint
    data: match particle_id {
        3 | 20 => {
            block_state: varint
        }    // 3, 20
        11 => {
            red: f32be
            green: f32be
            blue: f32be
            scale: f32be
        }    // 11
        27 => {
            item: slot
        }    // 27
        _ => { }
    }
}

// --- packets ---

packet declare_recipes {
    recipes_count: varint
    recipes: {
        recipe_id: string
        type: string
        data: {
            if type == "crafting_shapeless" {
                group: string
                ingredients_count: varint
                ingredients: ingredient[] count = ingredients_count
                result: slot
            }
            if type == "crafting_shaped" {
                width: varint
                height: varint
                group_2: string
                ingredients_2: {
                    value: ingredient[] count = height
                }[] count = width
                result_2: slot
            }
            if type == "smelting" {
                group_3: string
                ingredient: ingredient
                result_3: slot
                experience: f32be
                cook_time: varint
            }
        }
    }[] count = recipes_count
}

packet entity_metadata {
    entity_id: varint
    metadata: entity_metadata
}

packet named_entity_spawn {
    entity_id: varint
    player_uuid: uuid
    x: f64be
    y: f64be
    z: f64be
    yaw: i8
    pitch: i8
    metadata: entity_metadata
}

packet spawn_entity_living {
    entity_id: varint
    entity_uuid: uuid
    type: varint
    x: f64be
    y: f64be
    z: f64be
    yaw: i8
    pitch: i8
    head_pitch: i8
    velocity: vec3i16
    metadata: entity_metadata
}

packet world_particles {
    particle_id: i32be
    long_distance: boolean
    x: f32be
    y: f32be
    z: f32be
    offset_x: f32be
    offset_y: f32be
    offset_z: f32be
    particle_data: f32be
    particles: i32be
    data: match particle_id {
        3 | 20 => {
            block_state: varint
        }    // 3, 20
        11 => {
            red: f32be
            green: f32be
            blue: f32be
            scale: f32be
        }    // 11
        27 => {
            item: slot
        }    // 27
        _ => { }
    }
}

