import "../../std/integers.bps"
import "../../std/varint.bps"
import "from_1_13.bps"
import "1_13_to_1_20_1.bps"
import "1_13_2_to_1_20_1.bps"

packet login {
    entity_id: i32be
    game_mode: u8
    dimension: i32be
    hashed_seed: i64be
    max_players: u8
    level_type: string
    view_distance: varint
    reduced_debug_info: boolean
    enable_respawn_screen: boolean
}

packet map_chunk {
    x: i32be
    z: i32be
    ground_up: boolean
    bit_map: varint
    heightmaps: nbt
    biomes: match ground_up {
        0 => { }    // false
        1 => {
            biomes: i32be[] count = 1024
        }    // true
        _ => { }
    }
    chunk_data_len: varint
    chunk_data: bytes(chunk_data_len)
    block_entities_count: varint
    block_entities: nbt[] count = block_entities_count
}

packet respawn {
    dimension: i32be
    hashed_seed: i64be
    gamemode: u8
    level_type: string
}

packet world_particles {
    particle_id: i32be
    long_distance: boolean
    x: f64be
    y: f64be
    z: f64be
    offset_x: f32be
    offset_y: f32be
    offset_z: f32be
    particle_data: f32be
    particles: i32be
    data: match particle_id {
        3 | 23 => {
            block_state: varint
        }    // 3, 23
        14 => {
            red: f32be
            green: f32be
            blue: f32be
            scale: f32be
        }    // 14
        32 => {
            item: slot
        }    // 32
        _ => { }
    }
}

