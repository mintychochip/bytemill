}

packet window_click {
    window_id: u8
    slot: i16be
    mouse_button: i8
    action: i16be
    mode: i8
    item: slot
}

packet window_items {
    window_id: u8
    items_count: i16be
    items: slot[] count = items_count
}

packet world_particles {
    particle_id: i32be
    long_distance: boolean
    x: f32be
    y: f32be
    z: f32be
    offset_x: f32be
    offset_y: f32be
    offset_z: f32be
    particle_data: f32be
    particles: i32be
    data: match particle_id {
        3 | 20 => {
            block_state: varint
        }    // 3, 20
        11 => {
            red: f32be
            green: f32be
            blue: f32be
            scale: f32be
        }    // 11
        27 => {
            item: slot
        }    // 27
        _ => { }
    }
}

