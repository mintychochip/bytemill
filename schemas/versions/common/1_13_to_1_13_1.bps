// Shared by: 1.13 (protocol 393) to 1.13.1 (protocol 401).
// GENERATED by `bpsc import-versions` from data/minecraft-data (PrismarineJS/minecraft-data).
// Do not edit: change the importer or schemas/versions/manifest.json and regenerate.

import "../../std/integers.bps"
import "../../std/varint.bps"
import "from_1_13.bps"
import "1_13_to_1_21_8.bps"
import "1_13_to_1_20_1.bps"
import "1_13_to_1_13_2.bps"

encoding entity_metadata = {
    value: {
        key: u8
        type: varint
        value: match type {
            0 => i8    // 0
            1 | 11 | 13 => varint    // 1, 11, 13
            2 => f32be    // 2
            3 | 4 => string    // 3, 4
            5 => {
                has_value: boolean
                if has_value {
                    value: string
                }
            }    // 5
            6 => slot    // 6
            7 => boolean    // 7
            8 => {
                pitch: f32be
                yaw: f32be
                roll: f32be
            }    // 8
            9 => position    // 9
            10 => {
                has_value: boolean
                if has_value {
                    value: position
                }
            }    // 10
            12 => {
                has_value: boolean
                if has_value {
                    value: uuid
                }
            }    // 12
            14 => nbt    // 14
            15 => particle    // 15
            _ => { }
        }
    }[] until 0xff
}

encoding ingredient = {
    value_count: varint
    value: slot[] count = value_count
}

encoding particle = {
    particle_id: varint
    data: match particle_id {
        3 | 20 => {
            block_state: varint
        }    // 3, 20
        11 => {
            red: f32be
            green: f32be
            blue: f32be
            scale: f32be
        }    // 11
        27 => {
            item: slot
        }    // 27
        _ => { }
    }
}

encoding slot = {
    item_id: i16be
    match item_id {
        -1 => { }    // -1
        _ => {
            item_count: i8
            nbt_data: optional_nbt
        }
    }
}

// --- packets ---

packet advancements {
    reset: boolean
    advancement_mapping_count: varint
    advancement_mapping: {
        key: string
        value: {
            has_parent_id: boolean
            if has_parent_id {
                parent_id: string
            }
            has_display_data: boolean
            if has_display_data {
                display_data: {
                    title: string
                    description: string
                    icon: slot
                    frame_type: varint
                    flags: u32be
                    flags_unused = flags >> 3
                    flags_hidden = (flags >> 2) & 1
                    flags_show_toast = (flags >> 1) & 1
                    flags_has_background_texture = flags & 1
                    background_texture: match flags_has_background_texture {
                        1 => string    // 1
                        _ => { }
                    }
                    x_cord: f32be
                    y_cord: f32be
                }
            }
            criteria_count: varint
            criteria: {
                key: string
            }[] count = criteria_count
            requirements_count: varint
            requirements: {
                value_count: varint
                value: string[] count = value_count
            }[] count = requirements_count
        }
    }[] count = advancement_mapping_count
    identifiers_count: varint
    identifiers: string[] count = identifiers_count
    progress_mapping_count: varint
    progress_mapping: {
        key: string
        value_count: varint
        value: {
            criterion_identifier: string
            has_criterion_progress: boolean
            if has_criterion_progress {
                criterion_progress: i64be
            }
        }[] count = value_count
    }[] count = progress_mapping_count
}

packet declare_recipes {
    recipes_count: varint
    recipes: {
        recipe_id: string
        type: string
        data: {
            if type == "crafting_shapeless" {
                group: string
                ingredients_count: varint
                ingredients: ingredient[] count = ingredients_count
                result: slot
            }
            if type == "crafting_shaped" {
                width: varint
                height: varint
                group_2: string
                ingredients_2: {
                    value: ingredient[] count = height
                }[] count = width
                result_2: slot
            }
            if type == "smelting" {
                group_3: string
                ingredient: ingredient
                result_3: slot
                experience: f32be
                cook_time: varint
            }
        }
    }[] count = recipes_count
}

packet entity_equipment {
    entity_id: varint
    slot: varint
    item: slot
}

packet entity_metadata {
    entity_id: varint
    metadata: entity_metadata
}

packet named_entity_spawn {
    entity_id: varint
    player_uuid: uuid
    x: f64be
    y: f64be
    z: f64be
    yaw: i8
    pitch: i8
    metadata: entity_metadata
}

packet set_creative_slot {
    slot: i16be
    item: slot
}

packet set_slot {
