// Shared by: 1.13 (protocol 393) onwards.
// GENERATED by `bml import-versions` from data/minecraft-data (PrismarineJS/minecraft-data).
// Do not edit: change the importer or schemas/versions/manifest.json and regenerate.

import "../../std/integers.bml"
import "../../std/varint.bml"

encoding nbt_byte_array = {
    byte_len: i32be
    data:     bytes(byte_len)
}

encoding nbt_compound_body = {
    entries: nbt_entry[] until 0x00
}

// A compound entry: tag type, name, payload. TAG_End (0) ends a compound before this is read.
encoding nbt_entry = {
    tag_type: u8
    name:     nbt_string
    ...nbt_payload
}

encoding nbt_int_array = {
    count: i32be
    data:  bytes(count * 4)
}

// A list: element type, count, then count payloads without type bytes.
encoding nbt_list_body = {
    elem_type: u8
    count:     i32be
    items: { v: match elem_type {
        0  => nbt_nothing
        1  => i8
        2  => i16be
        3  => i32be
        4  => i64be
        5  => f32be
        6  => f64be
        7  => nbt_byte_array
        8  => nbt_string
        9  => nbt_list_body
        10 => nbt_compound_body
        11 => nbt_int_array
        12 => nbt_long_array
    } }[] count = count
}

encoding nbt_long_array = {
    count: i32be
    data:  bytes(count * 8)
}

encoding nbt_nothing = { }

// The payload of the tag whose type is the enclosing block's `tag_type`.
encoding nbt_payload = {
    value: match tag_type {
        0  => nbt_nothing
        1  => i8
        2  => i16be
        3  => i32be
        4  => i64be
        5  => f32be
        6  => f64be
        7  => nbt_byte_array
        8  => nbt_string
        9  => nbt_list_body
        10 => nbt_compound_body
        11 => nbt_int_array
        12 => nbt_long_array
    }
}

encoding nbt_string = {
    byte_len: u16be
    value:    bytes(byte_len) as utf8
}

encoding string = {
    byte_len: varint
    value: bytes(byte_len) as utf8
}

encoding tags = {
    value_count: varint
    value: {
        tag_name: string
        entries_count: varint
        entries: varint[] count = entries_count
    }[] count = value_count
}

// 128-bit UUID, big endian.
encoding uuid = {
    msb: u64be
    lsb: u64be
}

// --- packets ---

packet abilities_play_clientbound {
    flags: i8
    flying_speed: f32be
    walking_speed: f32be
}

packet advancement_tab {
    action: varint
    tab_id: match action {
        0 => string    // 0
        1 => { }    // 1
        _ => { }
    }
}

packet animation {
    entity_id: varint
    animation: u8
}

packet attach_entity {
    entity_id: i32be
    vehicle_id: i32be
}

packet camera {
    camera_id: varint
}

packet client_command {
    action_id: varint
}

packet collect {
    collected_entity_id: varint
    collector_entity_id: varint
    pickup_item_count: varint
}

packet compress {
    threshold: varint
}

packet custom_payload_play_clientbound {
    channel: string
    data: rest
}

packet custom_payload_play_serverbound {
    channel: string
    data: rest
}

packet entity_action {
    entity_id: varint
    action_id: varint
    jump_boost: varint
}

packet entity_head_rotation {
    entity_id: varint
    head_yaw: i8
}

packet entity_status {
    entity_id: i32be
    entity_status: i8
}

packet experience {
    experience_bar: f32be
    level: varint
    total_experience: varint
}

packet game_state_change {
    reason: u8
    game_mode: f32be
}

packet held_item_slot_play_serverbound {
    slot_id: i16be
}

packet keep_alive_play_clientbound {
    keep_alive_id: i64be
}

packet keep_alive_play_serverbound {
    keep_alive_id: i64be
}

packet legacy_server_list_ping {
    payload: u8
}

packet login_plugin_request {
    message_id: varint
    channel: string
    data: rest
}

packet login_plugin_response {
    message_id: varint
    has_data: boolean
    match has_data {
        1 => {
            data: rest
        }
        _ => { }
    }
}

packet name_item {
    name: string
}

packet ping_start { }

packet ping_status_clientbound {
    time: i64be
}

packet ping_status_serverbound {
    time: i64be
}

packet query_entity_nbt {
    transaction_id: varint
    entity_id: varint
}

packet select_advancement_tab {
    has_id: boolean
    if has_id {
        id: string
    }
}

packet select_trade {
    slot: varint
}

packet server_info {
    response: string
}

packet set_passengers {
    entity_id: varint
    passengers_count: varint
    passengers: varint[] count = passengers_count
}

packet set_protocol {
    protocol_version: varint
    server_host: string
    server_port: u16be
    next_state: varint
}

packet spectate {
    target: uuid
}

packet statistics {
    entries_count: varint
    entries: {
        category_id: varint
        statistic_id: varint
        value: varint
    }[] count = entries_count
}

packet steer_boat {
    left_paddle: boolean
    right_paddle: boolean
}

packet stop_sound {
    flags: i8
    source: match flags {
        1 | 3 => varint    // 1, 3
        _ => { }
    }
    sound: match flags {
        2 | 3 => string    // 2, 3
        _ => { }
    }
}

packet tab_complete_play_serverbound {
    transaction_id: varint
    text: string
}

packet update_command_block_minecart {
    entity_id: varint
    command: string
    track_output: boolean
}

packet update_health {
    health: f32be
    food: varint
    food_saturation: f32be
}

packet vehicle_move_play_clientbound {
    x: f64be
    y: f64be
    z: f64be
    yaw: f32be
    pitch: f32be
}

