// Shared by: 1.19 (protocol 759) only.
// GENERATED by `bml import-versions` from data/minecraft-data (PrismarineJS/minecraft-data).
// Do not edit: change the importer or schemas/versions/manifest.json and regenerate.

import "../../std/integers.bml"
import "../../std/varint.bml"
import "from_1_13.bml"
import "from_1_14.bml"
import "1_13_to_1_20_1.bml"
import "1_13_2_to_1_20_1.bml"
import "1_19_to_1_19_3.bml"

encoding entity_metadata = {
    value: {
        key: u8
        type: varint
        value: match type {
            0 => i8    // 0
            1 | 11 | 13 | 18 => varint    // 1, 11, 13, 18
            2 => f32be    // 2
            3 | 4 => string    // 3, 4
            5 => {
                has_value: boolean
                if has_value {
                    value: string
                }
            }    // 5
            6 => slot    // 6
            7 => boolean    // 7
            8 => {
                pitch: f32be
                yaw: f32be
                roll: f32be
            }    // 8
            9 => position    // 9
            10 => {
                has_value: boolean
                if has_value {
                    value: position
                }
            }    // 10
            12 => {
                has_value: boolean
                if has_value {
                    value: uuid
                }
            }    // 12
            14 => nbt    // 14
            15 => particle    // 15
            16 => {
                villager_type: varint
                villager_profession: varint
                level: varint
            }    // 16
            17 => optvarint    // 17
            _ => { }
        }
    }[] until 0xff
}

// --- packets ---

packet chat_command {
    command: string
    timestamp: i64be
    salt: i64be
    argument_signatures_count: varint
    argument_signatures: {
        argument_name: string
        signature_len: varint
        signature: bytes(signature_len)
    }[] count = argument_signatures_count
    signed_preview: boolean
}

packet chat_message {
    message: string
    timestamp: i64be
    salt: i64be
    signature_len: varint
    signature: bytes(signature_len)
    signed_preview: boolean
}

packet entity_metadata {
    entity_id: varint
    metadata: entity_metadata
}

packet login_start {
    username: string
    has_signature: boolean
    if has_signature {
        signature: {
            timestamp: i64be
            public_key_len: varint
            public_key: bytes(public_key_len)
            signature_len: varint
            signature: bytes(signature_len)
        }
    }
}

packet multi_block_change {
    chunk_coordinates: u64be
    chunk_coordinates_x = sign_extend(chunk_coordinates >> 42, 22)
    chunk_coordinates_z = sign_extend((chunk_coordinates >> 20) & 4194303, 22)
    chunk_coordinates_y = sign_extend(chunk_coordinates & 1048575, 20)
    not_trust_edges: boolean
    records_count: varint
    records: varint[] count = records_count
}

packet player_chat {
    signed_chat_content: string
    has_unsigned_chat_content: boolean
    if has_unsigned_chat_content {
        unsigned_chat_content: string
    }
    type: varint
    sender_uuid: uuid
    sender_name: string
    has_sender_team: boolean
    if has_sender_team {
        sender_team: string
    }
    timestamp: i64be
    salt: i64be
    signature_len: varint
    signature: bytes(signature_len)
}

packet respawn {
    dimension: string
    world_name: string
    hashed_seed: i64be
    gamemode: u8
    previous_gamemode: u8
    is_debug: boolean
    is_flat: boolean
    copy_metadata: boolean
    has_death: boolean
    if has_death {
        death: {
            dimension_name: string
            location: position
        }
    }
}

packet server_data {
    has_motd: boolean
    if has_motd {
        motd: string
    }
    has_icon: boolean
    if has_icon {
        icon: string
    }
    previews_chat: boolean
}

packet system_chat {
    content: string
    type: varint
}

packet trade_list {
    window_id: varint
    trades_count: u8
    trades: {
        input_item1: slot
        output_item: slot
        input_item2: slot
        trade_disabled: boolean
        nb_trade_uses: i32be
        maximum_nb_trade_uses: i32be
        xp: i32be
        special_price: i32be
        price_multiplier: f32be
        demand: i32be
    }[] count = trades_count
    villager_level: varint
    experience: varint
    is_regular_villager: boolean
    can_restock: boolean
}

