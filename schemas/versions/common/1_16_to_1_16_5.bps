encoding entity_metadata = {
    value: {
        key: u8
        type: varint
        value: match type {
            0 => i8    // 0
            1 | 11 | 13 | 18 => varint    // 1, 11, 13, 18
            2 => f32be    // 2
            3 | 4 => string    // 3, 4
            5 => {
                has_value: boolean
                if has_value {
                    value: string
                }
            }    // 5
            6 => slot    // 6
            7 => boolean    // 7
            8 => {
                pitch: f32be
                yaw: f32be
                roll: f32be
            }    // 8
            9 => position    // 9
            10 => {
                has_value: boolean
                if has_value {
                    value: position
                }
            }    // 10
            12 => {
                has_value: boolean
                if has_value {
                    value: uuid
                }
            }    // 12
            14 => nbt    // 14
            15 => particle    // 15
            16 => {
                villager_type: varint
                villager_profession: varint
                level: varint
            }    // 16
            17 => optvarint    // 17
            _ => { }
        }
    }[] until 0xff
}

encoding particle = {
    particle_id: varint
    data: match particle_id {
        3 | 23 => {
            block_state: varint
        }    // 3, 23
        14 => {
            red: f32be
            green: f32be
            blue: f32be
            scale: f32be
        }    // 14
        34 => {
            item: slot
        }    // 34
        _ => { }
    }
}

// --- packets ---

packet entity_metadata {
    entity_id: varint
