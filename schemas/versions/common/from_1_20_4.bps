}

packet map {
    item_damage: varint
    scale: i8
    locked: boolean
    has_icons: boolean
    if has_icons {
        icons: {
            icons_count: varint
            icons: {
                type: varint
                x: i8
                z: i8
                direction: u8
                has_display_name: boolean
                if has_display_name {
                    display_name: anonymous_nbt
                }
            }[] count = icons_count
        }
    }
    columns: u8
    rows: match columns {
        0 => { }    // 0
        _ => u8
    }
    x: match columns {
        0 => { }    // 0
        _ => u8
    }
    y: match columns {
        0 => { }    // 0
        _ => u8
    }
    data: match columns {
        0 => { }    // 0
        _ => {
            data_len: varint
            data: bytes(data_len)
        }
    }
}

