packet boss_bar {
    entity_uuid: uuid
    action: varint
    title: match action {
        0 | 3 => anonymous_nbt    // 0, 3
        _ => { }
    }
    health: match action {
        0 | 2 => f32be    // 0, 2
        _ => { }
    }
    color: match action {
        0 | 4 => varint    // 0, 4
        _ => { }
    }
    dividers: match action {
        0 | 4 => varint    // 0, 4
        _ => { }
    }
    flags: match action {
        0 | 5 => u8    // 0, 5
        _ => { }
    }
}

