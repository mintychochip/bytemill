packet scoreboard_objective {
    name: string
    action: i8
    display_text: match action {
        0 | 2 => anonymous_nbt    // 0, 2
        _ => { }
    }
    type: match action {
        0 | 2 => varint    // 0, 2
        _ => { }
    }
    match action {
        0 | 2 => {
            has_number_format: boolean
            if has_number_format {
                number_format: varint
            }
        }    // 0, 2
        _ => {
            has_number_format = false
        }
    }
    styling: match action {
        0 | 2 => {
            styling: match has_number_format ? number_format : -1 {
                1 | 2 => anonymous_nbt    // 1, 2
                _ => { }
            }
        }    // 0, 2
        _ => { }
    }
}

packet scoreboard_score {
    item_name: string
    score_name: string
    value: varint
    has_display_name: boolean
    if has_display_name {
        display_name: anonymous_nbt
    }
    has_number_format: boolean
    if has_number_format {
        number_format: varint
    }
    styling: match has_number_format ? number_format : -1 {
        1 | 2 => anonymous_nbt    // 1, 2
        _ => { }
    }
}

