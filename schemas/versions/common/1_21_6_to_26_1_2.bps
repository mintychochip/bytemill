import "../../std/integers.bps"
import "../../std/varint.bps"
import "from_1_13.bps"
import "from_1_20_2.bps"

packet teams {
    team: string
    mode: i8
    match mode {
        0 | 2 => {
            name: anonymous_nbt
            flags: u8
            flags_friendly_fire = (flags & 1) != 0
            flags_see_friendly_invisible = (flags & 2) != 0
            name_tag_visibility: varint
            collision_rule: varint
            formatting: varint
            prefix: anonymous_nbt
            suffix: anonymous_nbt
        }    // add, change
        _ => { }
    }
    players: match mode {
        0 | 3 | 4 => {
            players_count: varint
            players: string[] count = players_count
        }    // add, join, leave
        _ => { }
    }
}

