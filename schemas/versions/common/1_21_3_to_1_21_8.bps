import "../../std/integers.bps"
import "../../std/varint.bps"
import "from_1_13.bps"
import "from_1_14.bps"
import "from_1_19_4.bps"

encoding spawn_info = {
    dimension: varint
    name: string
    hashed_seed: i64be
    gamemode: i8
    previous_gamemode: u8
    is_debug: boolean
    is_flat: boolean
    has_death: boolean
    if has_death {
        death: {
            dimension_name: string
            location: position
        }
    }
    portal_cooldown: varint
    sea_level: varint
}

// --- packets ---

packet login {
    entity_id: i32be
    is_hardcore: boolean
    world_names_count: varint
    world_names: string[] count = world_names_count
    max_players: varint
    view_distance: varint
    simulation_distance: varint
    reduced_debug_info: boolean
    enable_respawn_screen: boolean
    do_limited_crafting: boolean
    world_state: spawn_info
    enforces_secure_chat: boolean
}

packet move_minecart {
    entity_id: varint
    steps_count: varint
    steps: {
        position: vec3f
        movement: vec3f
        yaw: f32be
        pitch: f32be
        weight: f32be
    }[] count = steps_count
}

packet player_rotation {
    yaw: f32be
    pitch: f32be
}

packet respawn {
    world_state: spawn_info
    copy_metadata: u8
}

