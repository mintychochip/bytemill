// Shared by: 1.13 (protocol 393) to 1.13.2 (protocol 404).
// GENERATED by `bml import-versions` from data/minecraft-data (PrismarineJS/minecraft-data).
// Do not edit: change the importer or schemas/versions/manifest.json and regenerate.

import "../../std/integers.bps"
import "../../std/varint.bps"
import "from_1_13.bps"
import "1_13_to_1_21_8.bps"
import "1_13_to_1_20_1.bps"

encoding position = {
    raw: u64be
    x = sign_extend(raw >> 38, 26)
    y = sign_extend((raw >> 26) & 4095, 12)
    z = sign_extend(raw & 67108863, 26)
}

// --- packets ---

packet bed {
    entity_id: varint
    location: position
}

packet block_action {
    location: position
    byte1: u8
    byte2: u8
    block_id: varint
}

packet block_break_animation {
    entity_id: varint
    location: position
    destroy_stage: i8
}

packet block_change {
    location: position
    type: varint
}

packet block_dig {
    status: varint
    location: position
    face: i8
}

packet block_place {
    location: position
    direction: varint
    hand: varint
    cursor_x: f32be
    cursor_y: f32be
    cursor_z: f32be
}

packet crafting_book_data {
    type: varint
    match type {
        0 => {
            displayed_recipe: string
        }    // 0
        1 => {
            crafting_book_open: boolean
            crafting_filter: boolean
            smelting_book_open: boolean
            smelting_filter: boolean
        }    // 1
        _ => { }
    }
}

packet difficulty {
    difficulty: u8
}

packet login {
    entity_id: i32be
    game_mode: u8
    dimension: i32be
    difficulty: u8
    max_players: u8
    level_type: string
    reduced_debug_info: boolean
}

packet map {
    item_damage: varint
    scale: i8
    tracking_position: boolean
    icons_count: varint
    icons: {
        type: varint
        x: i8
        z: i8
        direction: u8
        has_display_name: boolean
        if has_display_name {
            display_name: string
        }
    }[] count = icons_count
    columns: i8
    rows: match columns {
        0 => { }    // 0
        _ => i8
    }
    x: match columns {
        0 => { }    // 0
        _ => i8
    }
    y: match columns {
        0 => { }    // 0
        _ => i8
    }
    data: match columns {
        0 => { }    // 0
        _ => {
            data_len: varint
            data: bytes(data_len)
        }
    }
}

packet map_chunk {
    x: i32be
    z: i32be
    ground_up: boolean
    bit_map: varint
    chunk_data_len: varint
    chunk_data: bytes(chunk_data_len)
    block_entities_count: varint
    block_entities: nbt[] count = block_entities_count
}

packet open_sign_entity {
    location: position
}

packet open_window {
    window_id: u8
    inventory_type: string
    window_title: string
    slot_count: u8
    entity_id: {
        if inventory_type == "EntityHorse" {
            value: i32be
        }
    }
}

packet query_block_nbt {
    transaction_id: varint
    location: position
}

packet respawn {
    dimension: i32be
    difficulty: u8
    gamemode: u8
    level_type: string
}

packet spawn_entity {
    entity_id: varint
    object_uuid: uuid
    type: i8
    x: f64be
    y: f64be
    z: f64be
    pitch: i8
    yaw: i8
    object_data: i32be
    velocity: vec3i16
}

packet spawn_entity_painting {
    entity_id: varint
    entity_uuid: uuid
    title: varint
    location: position
    direction: u8
}

packet spawn_position {
    location: position
}

packet tags {
    block_tags: tags
    item_tags: tags
    fluid_tags: tags
}

packet tile_entity_data {
    location: position
    action: u8
    nbt_data: optional_nbt
}

packet update_command_block {
    location: position
    command: string
    mode: varint
    flags: u8
}

packet update_sign {
    location: position
    text1: string
    text2: string
    text3: string
    text4: string
}

packet update_structure_block {
    location: position
    action: varint
    mode: varint
    name: string
    offset_x: i8
    offset_y: i8
    offset_z: i8
    size_x: i8
    size_y: i8
    size_z: i8
    mirror: varint
    rotation: varint
    metadata: string
    integrity: f32be
    seed: varlong
    flags: u8
}

packet world_event {
    effect_id: i32be
    location: position
    data: i32be
    global: boolean
}

