encoding data_component_matchers = {
    exact_matchers: exact_component_matcher
    partial_matchers_count: varint
    partial_matchers: varint[] count = partial_matchers_count
}

encoding entity_equipment_equipments = {
    slot_byte: u8
    slot = slot_byte & 127
    item: slot
    if (slot_byte & 128) != 0 {
        next: entity_equipment_equipments
    }
}

encoding entity_metadata = {
    value: entity_metadata_entry[] until 0xff
}

encoding entity_metadata_entry = {
    key: u8
    type: varint
    value: match type {
        0 => i8    // byte
        1 | 12 | 14 | 21 | 22 | 23 | 24 | 25 | 26 | 27 | 28 | 31 | 32 => varint    // int, direction, block_state, pose, cat_variant, cow_variant, wolf_variant, wolf_sound_variant, frog_variant, pig_variant, chicken_variant, sniffer_state, armadillo_state
        2 => varlong    // long
        3 => f32be    // float
        4 => string    // string
        5 | 16 => anonymous_nbt    // component, compound_tag
        6 => {
            has_value: boolean
            if has_value {
                value: anonymous_nbt
            }
        }    // optional_component
        7 => slot    // item_stack
        8 => boolean    // boolean
        9 => {
            pitch: f32be
            yaw: f32be
            roll: f32be
        }    // rotations
        10 => position    // block_pos
        11 => {
            has_value: boolean
            if has_value {
                value: position
            }
        }    // optional_block_pos
        13 => {
            has_value: boolean
            if has_value {
                value: uuid
            }
        }    // optional_uuid
        15 | 20 => optvarint    // optional_block_state, optional_unsigned_int
        17 => particle    // particle
        18 => {
            value_count: varint
            value: particle[] count = value_count
        }    // particles
        19 => {
            villager_type: varint
            villager_profession: varint
            level: varint
        }    // villager_data
        29 => {
            has_value: boolean
            if has_value {
                value: string
            }
        }    // optional_global_pos
        30 => {
            value: {
                id: varint
                if id == 0 {
                    variant_data: entity_metadata_painting_variant
                }
            }
        }    // painting_variant
        33 => vec3f    // vector3
        34 => vec4f    // quaternion
        _ => { }
    }
}

encoding exact_component_matcher = {
    value_count: varint
    value: slot_component[] count = value_count
}

encoding item_block_predicate = {
