packet login {
    entity_id: i32be
    game_mode: u8
    dimension: i32be
    max_players: u8
    level_type: string
    view_distance: varint
    reduced_debug_info: boolean
}

packet map_chunk {
    x: i32be
    z: i32be
    ground_up: boolean
    bit_map: varint
    heightmaps: nbt
    chunk_data_len: varint
    chunk_data: bytes(chunk_data_len)
    block_entities_count: varint
    block_entities: nbt[] count = block_entities_count
}

packet named_entity_spawn {
    entity_id: varint
    player_uuid: uuid
    x: f64be
    y: f64be
    z: f64be
    yaw: i8
    pitch: i8
    metadata: entity_metadata
}

packet respawn {
    dimension: i32be
    gamemode: u8
    level_type: string
}

packet spawn_entity_living {
    entity_id: varint
    entity_uuid: uuid
    type: varint
    x: f64be
    y: f64be
    z: f64be
    yaw: i8
    pitch: i8
    head_pitch: i8
    velocity: vec3i16
    metadata: entity_metadata
}

packet world_particles {
    particle_id: i32be
    long_distance: boolean
    x: f32be
    y: f32be
    z: f32be
    offset_x: f32be
    offset_y: f32be
    offset_z: f32be
    particle_data: f32be
    particles: i32be
    data: match particle_id {
        3 | 23 => {
            block_state: varint
        }    // 3, 23
        14 => {
            red: f32be
            green: f32be
            blue: f32be
            scale: f32be
        }    // 14
        32 => {
            item: slot
        }    // 32
        _ => { }
    }
}

