        15 => {
            from_red: f32be
            from_green: f32be
            from_blue: f32be
            scale: f32be
            to_red: f32be
            to_green: f32be
            to_blue: f32be
        }    // 15
        30 => {
            rotation: f32be
        }    // 30
        39 => {
            item: slot
        }    // 39
        40 => {
            position_type: string
            entity_id: {
                if position_type == "minecraft:entity" {
                    value: varint
                }
            }
            entity_eye_height: {
                if position_type == "minecraft:entity" {
                    value: varint
                }
            }
            destination: {
                if position_type == "minecraft:block" {
                    value: position
                }
                if position_type == "minecraft:entity" {
                    value: varint
                }
            }
            ticks: varint
        }    // 40
        92 => {
            delay_in_ticks_before_shown: varint
        }    // 92
        _ => { }
    }
}

