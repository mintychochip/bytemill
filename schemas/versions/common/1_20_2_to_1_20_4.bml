// Shared by: 1.20.2 (protocol 764) to 1.20.4 (protocol 765).
// GENERATED by `bml import-versions` from data/minecraft-data (PrismarineJS/minecraft-data).
// Do not edit: change the importer or schemas/versions/manifest.json and regenerate.

import "../../std/integers.bml"
import "../../std/varint.bml"
import "from_1_13.bml"
import "from_1_14.bml"
import "from_1_20_2.bml"

encoding entity_equipment_equipments = {
    slot_byte: u8
    slot = slot_byte & 127
    item: slot
    if (slot_byte & 128) != 0 {
        next: entity_equipment_equipments
    }
}

encoding ingredient = {
    value_count: varint
    value: slot[] count = value_count
}

encoding minecraft_smelting_format = {
    group: string
    category: varint
    ingredient: ingredient
    result: slot
    experience: f32be
    cook_time: varint
}

encoding slot = {
    present: boolean
    match present {
        0 => { }    // false
        1 => {
            item_id: varint
            item_count: i8
            nbt_data: anon_optional_nbt
        }    // true
        _ => { }
    }
}

// --- packets ---

packet entity_effect {
    entity_id: varint
    effect_id: varint
    amplifier: i8
    duration: varint
    hide_particles: i8
    has_factor_codec: boolean
    if has_factor_codec {
        factor_codec: anonymous_nbt
    }
}

packet entity_equipment {
    entity_id: varint
    equipments: entity_equipment_equipments
}

packet login {
    entity_id: i32be
    is_hardcore: boolean
    world_names_count: varint
    world_names: string[] count = world_names_count
    max_players: varint
    view_distance: varint
    simulation_distance: varint
    reduced_debug_info: boolean
    enable_respawn_screen: boolean
    do_limited_crafting: boolean
    world_type: string
    world_name: string
    hashed_seed: i64be
    game_mode: u8
    previous_game_mode: i8
    is_debug: boolean
    is_flat: boolean
    has_death: boolean
    if has_death {
        death: {
            dimension_name: string
            location: position
        }
    }
    portal_cooldown: varint
}

packet registry_data {
    codec: anonymous_nbt
}

packet respawn {
    dimension: string
    world_name: string
    hashed_seed: i64be
    gamemode: i8
    previous_gamemode: u8
    is_debug: boolean
    is_flat: boolean
    has_death: boolean
    if has_death {
        death: {
            dimension_name: string
            location: position
        }
    }
    portal_cooldown: varint
    copy_metadata: boolean
}

packet set_creative_slot {
    slot: i16be
    item: slot
}

packet set_slot {
    window_id: i8
    state_id: varint
    slot: i16be
    item: slot
}

packet trade_list {
    window_id: varint
    trades_count: varint
    trades: {
        input_item1: slot
        output_item: slot
        input_item2: slot
        trade_disabled: boolean
        nb_trade_uses: i32be
        maximum_nb_trade_uses: i32be
        xp: i32be
        special_price: i32be
        price_multiplier: f32be
        demand: i32be
    }[] count = trades_count
    villager_level: varint
    experience: varint
    is_regular_villager: boolean
    can_restock: boolean
}

packet window_click {
    window_id: u8
    state_id: varint
    slot: i16be
    mouse_button: i8
    mode: varint
    changed_slots_count: varint
    changed_slots: {
        location: i16be
        item: slot
    }[] count = changed_slots_count
    cursor_item: slot
}

packet window_items {
    window_id: u8
    state_id: varint
    items_count: varint
    items: slot[] count = items_count
    carried_item: slot
}

