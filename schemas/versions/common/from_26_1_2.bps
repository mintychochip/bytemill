// Shared by: 26.1.2 (protocol 775) onwards.
// GENERATED by `bml import-versions` from data/minecraft-data (PrismarineJS/minecraft-data).
// Do not edit: change the importer or schemas/versions/manifest.json and regenerate.

import "../../std/integers.bps"
import "../../std/varint.bps"
import "from_1_13.bps"
import "from_1_14.bps"
import "from_1_19_3.bps"
import "from_1_19_4.bps"
import "from_1_20_2.bps"
import "from_1_21_10.bps"

encoding damage_type_data = {
    msg_id: string
    scaling: varint
    exhaustion: f32be
    effects: varint
    death_message_type: varint
}

encoding dye_color = varint

encoding game_rule = {
    name: string
    value: string
}

encoding item_block_property = {
    name: string
    is_exact_match: boolean
    value: match is_exact_match {
        1 => {
            exact_value: string
        }    // true
        0 => {
            has_min_value: boolean
            if has_min_value {
                min_value: string
            }
            has_max_value: boolean
            if has_max_value {
                max_value: string
            }
        }    // false
        _ => { }
    }
}

// --- packets ---

packet attack {
    entity_id: varint
}

packet custom_click_action_configuration_serverbound {
    id: string
    payload_size: varint
    nbt: anon_optional_nbt
}

packet custom_click_action_play_serverbound {
    id: string
    payload_size: varint
    nbt: anon_optional_nbt
}

packet game_rule_values {
    values_count: varint
    values: game_rule[] count = values_count
}

packet low_disk_space_warning { }

packet move_minecart {
    entity_id: varint
    steps_count: varint
    steps: {
        position: vec3f64
        velocity: vec3f64
        yaw: i8
        pitch: i8
        weight: f32be
    }[] count = steps_count
}

packet multi_block_change {
    chunk_coordinates: u64be
    chunk_coordinates_x = sign_extend(chunk_coordinates >> 42, 22)
    chunk_coordinates_z = sign_extend((chunk_coordinates >> 20) & 4194303, 22)
    chunk_coordinates_y = sign_extend(chunk_coordinates & 1048575, 20)
    records_count: varint
    records: varlong[] count = records_count
}

packet player_info {
    action: u8
    action_add_player = (action & 1) != 0
    action_initialize_chat = (action & 2) != 0
    action_update_game_mode = (action & 4) != 0
    action_update_listed = (action & 8) != 0
    action_update_latency = (action & 16) != 0
    action_update_display_name = (action & 32) != 0
    action_update_list_order = (action & 64) != 0
    action_update_hat = (action & 128) != 0
    data_count: varint
    data: {
        uuid: uuid
        player: match action_add_player {
            1 => game_profile_name_prop    // true
            _ => { }
        }
        chat_session: match action_initialize_chat {
            1 => chat_session    // true
            _ => { }
        }
        gamemode: match action_update_game_mode {
            1 => varint    // true
            _ => { }
        }
        listed: match action_update_listed {
            1 => boolean    // true
            _ => { }
        }
        latency: match action_update_latency {
            1 => varint    // true
            _ => { }
        }
        match action_update_display_name {
            1 => {
                has_display_name: boolean
                if has_display_name {
                    display_name: anonymous_nbt
                }
            }    // true
            _ => {
                has_display_name = false
            }
        }
        list_priority: match action_update_list_order {
            1 => varint    // true
            _ => { }
        }
        show_hat: match action_update_hat {
            1 => boolean    // true
            _ => { }
        }
    }[] count = data_count
}

packet set_game_rule {
    entries_count: varint
    entries: game_rule[] count = entries_count
}

packet update_structure_block {
    location: position
    action: varint
    mode: varint
    name: string
    offset_x: i8
    offset_y: i8
    offset_z: i8
    size_x: i8
    size_y: i8
    size_z: i8
    mirror: varint
    rotation: varint
    metadata: string
    integrity: f32be
    seed: varlong
    flags: u8
    flags_ignore_entities = (flags & 1) != 0
    flags_show_air = (flags & 2) != 0
    flags_show_bounding_box = (flags & 4) != 0
    flags_strict = (flags & 8) != 0
}

packet update_time {
    age: i64be
    clock_updates_count: varint
    clock_updates: {
        id: varint
        total_ticks: varlong
        partial_tick: f32be
        rate: f32be
    }[] count = clock_updates_count
}

packet use_entity {
    target: varint
    hand: varint
    location: lp_vec3
    sneaking: boolean
}

