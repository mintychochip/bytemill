        23 => slot    // use_remainder
        24 => {
            seconds: f32be
            has_cooldown_group: boolean
            if has_cooldown_group {
                cooldown_group: string
            }
        }    // use_cooldown
        26 => {
            rules_count: varint
            rules: {
                blocks: id_set
                has_speed: boolean
