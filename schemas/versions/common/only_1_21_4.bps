        15 | 16 | 18 | 30 => { }    // hide_additional_tooltip, hide_tooltip, creative_slot_lock, glider
        21 => {
            nutrition: varint
            saturation_modifier: f32be
            can_always_eat: boolean
        }    // food
        22 => {
            consume_seconds: f32be
            animation: varint
            sound: item_sound_holder
            makes_particles: boolean
            effects_count: varint
            effects: item_consume_effect[] count = effects_count
