    data: match type {
        0 | 5 | 6 | 20 | 37 | 46 | 47 | 48 | 49 | 53 | 65 | 66 => anonymous_nbt    // custom_data, custom_name, item_name, intangible_projectile, map_decorations, debug_stick_state, entity_data, bucket_entity_data, block_entity_data, recipes, lock, container_loot
