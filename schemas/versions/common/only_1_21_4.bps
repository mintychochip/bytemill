encoding entity_equipment_equipments = {
    slot_byte: u8
    slot = slot_byte & 127
    item: slot
    if (slot_byte & 128) != 0 {
        next: entity_equipment_equipments
    }
}

encoding entity_metadata = {
    value: entity_metadata_entry[] until 0xff
}

encoding entity_metadata_entry = {
    key: u8
    type: varint
    value: match type {
        0 => i8    // byte
        1 | 12 | 14 | 21 | 22 | 24 | 27 | 28 => varint    // int, direction, block_state, pose, cat_variant, frog_variant, sniffer_state, armadillo_state
        2 => varlong    // long
        3 => f32be    // float
        4 => string    // string
        5 | 16 => anonymous_nbt    // component, compound_tag
        6 => {
            has_value: boolean
            if has_value {
                value: anonymous_nbt
            }
        }    // optional_component
        7 => slot    // item_stack
        8 => boolean    // boolean
        9 => {
            pitch: f32be
            yaw: f32be
            roll: f32be
        }    // rotations
        10 => position    // block_pos
        11 => {
            has_value: boolean
            if has_value {
                value: position
            }
        }    // optional_block_pos
        13 => {
            has_value: boolean
            if has_value {
                value: uuid
            }
        }    // optional_uuid
        15 | 20 => optvarint    // optional_block_state, optional_unsigned_int
        17 => particle    // particle
        18 => {
            value_count: varint
            value: particle[] count = value_count
        }    // particles
        19 => {
            villager_type: varint
            villager_profession: varint
            level: varint
        }    // villager_data
        23 => {
            value: {
                id: varint
                if id == 0 {
                    variant_data: entity_metadata_wolf_variant
                }
            }
        }    // wolf_variant
        25 => {
            has_value: boolean
            if has_value {
                value: string
            }
        }    // optional_global_pos
        26 => {
            value: {
                id: varint
                if id == 0 {
                    variant_data: entity_metadata_painting_variant
                }
            }
        }    // painting_variant
        29 => vec3f    // vector3
        30 => vec4f    // quaternion
        _ => { }
    }
}

encoding particle = {
    type: varint
    data: match type {
        1 | 2 | 28 | 107 | 111 | 101 => varint    // block, block_marker, falling_dust, dust_pillar, block_crumble, shriek
        13 => {
            color: i32be
            scale: f32be
        }    // dust
        14 => {
            from_color: i32be
            to_color: i32be
            scale: f32be
        }    // dust_color_transition
        20 => i32be    // entity_effect
        45 => slot    // item
        36 => f32be    // sculk_charge
        46 => {
            position_type: varint
            position: match position_type {
                0 => position    // block
                1 => {
                    entity_id: varint
                    entity_eye_height: f32be
                }    // entity
                _ => { }
            }
            ticks: varint
        }    // vibration
        47 => {
            target: vec3f64
            color: i32be
            duration: varint
        }    // trail
        _ => { }
    }
}

encoding recipe_display = {
    type: varint
    data: match type {
        0 => {
            ingredients_count: varint
            ingredients: slot_display[] count = ingredients_count
            result: slot_display
            crafting_station: slot_display
        }    // crafting_shapeless
        1 => {
            width: varint
            height: varint
            ingredients_count: varint
            ingredients: slot_display[] count = ingredients_count
            result: slot_display
            crafting_station: slot_display
        }    // crafting_shaped
        2 => {
            ingredient: slot_display
            fuel: slot_display
            result: slot_display
            crafting_station: slot_display
            duration: varint
            experience: f32be
        }    // furnace
        3 => {
            ingredient: slot_display
            result: slot_display
            crafting_station: slot_display
        }    // stonecutter
        4 => {
            template: slot_display
            base: slot_display
            addition: slot_display
            result: slot_display
            crafting_station: slot_display
        }    // smithing
        _ => { }
    }
}

encoding slot = {
    item_count: varint
    match item_count {
        0 => { }    // 0
        _ => {
            item_id: varint
            added_component_count: varint
            removed_component_count: varint
            components: slot_component[] count = added_component_count
            remove_components: {
                type: slot_component_type
            }[] count = removed_component_count
        }
    }
}

encoding slot_component = {
