                camera_overlay: string
            }
            has_allowed_entities: boolean
            if has_allowed_entities {
                allowed_entities: id_set
            }
            dispensable: boolean
            swappable: boolean
            damageable: boolean
        }    // equippable
        29 => {
            items: id_set
        }    // repairable
        32 => {
            effects_count: varint
            effects: item_consume_effect[] count = effects_count
