import "../../std/integers.bml"
import "../../std/varint.bml"
import "from_1_13.bml"
import "from_1_14.bml"

packet multi_block_change {
    chunk_coordinates: u64be
    chunk_coordinates_x = sign_extend(chunk_coordinates >> 42, 22)
    chunk_coordinates_z = sign_extend((chunk_coordinates >> 20) & 4194303, 22)
    chunk_coordinates_y = sign_extend(chunk_coordinates & 1048575, 20)
    suppress_light_updates: boolean
    records_count: varint
    records: varint[] count = records_count
}

packet respawn {
    dimension: string
    world_name: string
    hashed_seed: i64be
    gamemode: i8
    previous_gamemode: u8
    is_debug: boolean
    is_flat: boolean
    copy_metadata: boolean
    has_death: boolean
    if has_death {
        death: {
            dimension_name: string
            location: position
        }
    }
}

