import "../../std/integers.bml"
import "../../std/varint.bml"
import "from_1_13.bml"
import "from_1_14.bml"
import "1_19_to_1_19_2+from_1_20_6.bml"
import "from_1_20_2.bml"
import "from_1_20_6.bml"
import "from_1_21_3.bml"

encoding armor_trim_material = {
    asset_base: string
    override_armor_assets_count: varint
    override_armor_assets: {
        key: string
        value: string
    }[] count = override_armor_assets_count
    description: anonymous_nbt
}

encoding armor_trim_pattern = {
    asset_id: string
    description: anonymous_nbt
    decal: boolean
}

encoding hashed_slot = {
    item_id: varint
    item_count: varint
    components_count: varint
    components: {
        type: slot_component_type
        hash: i32be
    }[] count = components_count
    remove_components_count: varint
    remove_components: {
        type: slot_component_type
    }[] count = remove_components_count
}

encoding untrusted_slot = {
    item_count: varint
    match item_count {
        0 => { }    // 0
        _ => {
            item_id: varint
            added_component_count: varint
            removed_component_count: varint
            components: untrusted_slot_component[] count = added_component_count
            remove_components: {
                type: slot_component_type
            }[] count = removed_component_count
        }
    }
}

encoding untrusted_slot_component = {
    type: slot_component_type
    data: byte_array
}

encoding vec3i = {
    x: varint
    y: varint
    z: varint
}

// --- packets ---

packet chat_message {
    message: string
    timestamp: i64be
    salt: i64be
    has_signature: boolean
    match has_signature {
        1 => {
            signature: {
                signature: bytes(256)
            }
        }
        _ => { }
    }
    offset: varint
    acknowledged: bytes(3)
    checksum: u8
}

packet set_creative_slot {
    slot: i16be
    item: untrusted_slot
}

packet set_test_block {
    position: position
    mode: varint
    message: string
}

packet test_instance_block_action {
    pos: position
    action: varint
    data: {
        has_test: boolean
        if has_test {
            test: string
        }
        size: vec3i
        rotation: varint
        ignore_entities: boolean
        status: varint
        has_error_message: boolean
        if has_error_message {
            error_message: anonymous_nbt
        }
    }
}

packet test_instance_block_status {
    status: anonymous_nbt
    has_size: boolean
    if has_size {
        size: vec3i
    }
}

packet window_click {
    window_id: container_id
    state_id: varint
    slot: i16be
    mouse_button: i8
    mode: varint
    changed_slots_count: varint
    changed_slots: {
        location: i16be
        has_item: boolean
        if has_item {
            item: hashed_slot
        }
    }[] count = changed_slots_count
    has_cursor_item: boolean
    if has_cursor_item {
        cursor_item: hashed_slot
    }
}

