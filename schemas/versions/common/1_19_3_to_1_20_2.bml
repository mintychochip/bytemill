import "../../std/integers.bml"
import "../../std/varint.bml"
import "from_1_13.bml"
import "from_1_19_3.bml"
import "1_19_3_to_1_21_8.bml"

packet explosion {
    x: f64be
    y: f64be
    z: f64be
    radius: f32be
    affected_block_offsets_count: varint
    affected_block_offsets: {
        x: i8
        y: i8
        z: i8
    }[] count = affected_block_offsets_count
    player_motion_x: f32be
    player_motion_y: f32be
    player_motion_z: f32be
}

packet player_chat {
    sender_uuid: uuid
    index: varint
    has_signature: boolean
    match has_signature {
        1 => {
            signature: {
                signature: bytes(256)
            }
        }
        _ => { }
    }
    plain_message: string
    timestamp: i64be
    salt: i64be
    previous_messages: previous_messages
    has_unsigned_chat_content: boolean
    if has_unsigned_chat_content {
        unsigned_chat_content: string
    }
    filter_type: varint
    filter_type_mask: match filter_type {
        2 => {
            filter_type_mask_count: varint
            filter_type_mask: i64be[] count = filter_type_mask_count
        }    // 2
        _ => { }
    }
    type: varint
    network_name: string
    has_network_target_name: boolean
    if has_network_target_name {
        network_target_name: string
    }
}

packet player_info {
    action: u8
    action_add_player = (action & 1) != 0
    action_initialize_chat = (action & 2) != 0
    action_update_game_mode = (action & 4) != 0
    action_update_listed = (action & 8) != 0
    action_update_latency = (action & 16) != 0
    action_update_display_name = (action & 32) != 0
    data_count: varint
    data: {
        uuid: uuid
        player: match action_add_player {
            1 => game_profile    // true
            _ => { }
        }
        chat_session: match action_initialize_chat {
            1 => chat_session    // true
            _ => { }
        }
        gamemode: match action_update_game_mode {
            1 => varint    // true
            _ => { }
        }
        listed: match action_update_listed {
            1 => varint    // true
            _ => { }
        }
        latency: match action_update_latency {
            1 => varint    // true
            _ => { }
        }
        match action_update_display_name {
            1 => {
                has_display_name: boolean
                if has_display_name {
                    display_name: string
                }
            }    // true
            _ => {
                has_display_name = false
            }
        }
    }[] count = data_count
}

packet profileless_chat {
    message: string
    type: varint
    name: string
    has_target: boolean
    if has_target {
        target: string
    }
}

