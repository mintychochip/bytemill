encoding entity_metadata = {
    value: {
        key: u8
        type: varint
        value: match type {
            0 => i8    // byte
            1 | 12 | 14 | 20 | 21 | 22 | 24 | 25 => varint    // int, direction, block_state, pose, cat_variant, frog_variant, painting_variant, sniffer_state
            2 => varlong    // long
            3 => f32be    // float
            4 | 5 => string    // string, component
            6 | 23 => {
                has_value: boolean
                if has_value {
                    value: string
                }
            }    // optional_component, optional_global_pos
            7 => slot    // item_stack
            8 => boolean    // boolean
            9 => {
                pitch: f32be
                yaw: f32be
                roll: f32be
            }    // rotations
            10 => position    // block_pos
            11 => {
                has_value: boolean
                if has_value {
                    value: position
                }
            }    // optional_block_pos
            13 => {
                has_value: boolean
                if has_value {
                    value: uuid
                }
            }    // optional_uuid
            15 | 19 => optvarint    // optional_block_state, optional_unsigned_int
            16 => nbt    // compound_tag
            17 => particle    // particle
            18 => {
                villager_type: varint
                villager_profession: varint
                level: varint
            }    // villager_data
            26 => vec3f    // vector3
            27 => vec4f    // quaternion
            _ => { }
        }
    }[] until 0xff
}

encoding particle = {
    particle_id: varint
    data: match particle_id {
        2 | 3 | 25 => {
            block_state: varint
        }    // 2, 3, 25
        14 => {
            red: f32be
            green: f32be
            blue: f32be
            scale: f32be
        }    // 14
        15 => {
            from_red: f32be
            from_green: f32be
            from_blue: f32be
            scale: f32be
            to_red: f32be
            to_green: f32be
            to_blue: f32be
        }    // 15
        31 => {
            rotation: f32be
        }    // 31
        40 => {
            item: slot
        }    // 40
        41 => {
            position_type: string
            entity_id: {
                if position_type == "minecraft:entity" {
                    value: varint
                }
            }
            entity_eye_height: {
                if position_type == "minecraft:entity" {
                    value: varint
                }
            }
            destination: {
                if position_type == "minecraft:block" {
                    value: position
                }
                if position_type == "minecraft:entity" {
                    value: varint
                }
            }
            ticks: varint
        }    // 41
        93 => {
            delay_in_ticks_before_shown: varint
        }    // 93
        _ => { }
    }
}

// --- packets ---

packet advancements {
    reset: boolean
    advancement_mapping_count: varint
    advancement_mapping: {
        key: string
        value: {
            has_parent_id: boolean
            if has_parent_id {
                parent_id: string
            }
            has_display_data: boolean
            if has_display_data {
                display_data: {
                    title: string
                    description: string
                    icon: slot
                    frame_type: varint
                    flags: u32be
                    flags_unused = flags >> 3
                    flags_hidden = (flags >> 2) & 1
                    flags_show_toast = (flags >> 1) & 1
                    flags_has_background_texture = flags & 1
                    background_texture: match flags_has_background_texture {
                        1 => string    // 1
                        _ => { }
                    }
                    x_cord: f32be
                    y_cord: f32be
                }
            }
            criteria_count: varint
            criteria: {
                key: string
            }[] count = criteria_count
            requirements_count: varint
            requirements: {
                value_count: varint
                value: string[] count = value_count
            }[] count = requirements_count
            sends_telemtry_data: boolean
        }
    }[] count = advancement_mapping_count
    identifiers_count: varint
    identifiers: string[] count = identifiers_count
    progress_mapping_count: varint
    progress_mapping: {
        key: string
        value_count: varint
        value: {
            criterion_identifier: string
            has_criterion_progress: boolean
            if has_criterion_progress {
                criterion_progress: i64be
            }
        }[] count = value_count
    }[] count = progress_mapping_count
}

packet declare_recipes {
    recipes_count: varint
    recipes: {
        type: string
        recipe_id: string
        data: {
            if type == "minecraft:crafting_shapeless" {
                group: string
                category: varint
                ingredients_count: varint
                ingredients: ingredient[] count = ingredients_count
                result: slot
            }
            if type == "minecraft:crafting_shaped" {
                width: varint
                height: varint
                group_2: string
