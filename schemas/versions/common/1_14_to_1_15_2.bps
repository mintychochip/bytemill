import "../../std/integers.bps"
import "../../std/varint.bps"
import "from_1_13.bps"
import "from_1_14.bps"
import "1_13_to_1_20_1.bps"
import "1_13_2_to_1_20_1.bps"
import "1_14_to_1_19_2.bps"

encoding entity_metadata = {
    value: {
        key: u8
        type: varint
        value: match type {
            0 => i8    // 0
            1 | 11 | 13 | 18 => varint    // 1, 11, 13, 18
            2 => f32be    // 2
            3 | 4 => string    // 3, 4
            5 => {
                has_value: boolean
                if has_value {
                    value: string
                }
            }    // 5
            6 => slot    // 6
            7 => boolean    // 7
            8 => {
                pitch: f32be
                yaw: f32be
                roll: f32be
            }    // 8
            9 => position    // 9
            10 => {
                has_value: boolean
                if has_value {
                    value: position
                }
            }    // 10
            12 => {
                has_value: boolean
                if has_value {
                    value: uuid
                }
            }    // 12
            14 => nbt    // 14
            15 => particle    // 15
            16 => {
                villager_type: varint
                villager_profession: varint
                level: varint
            }    // 16
            17 => optvarint    // 17
            _ => { }
        }
    }[] until 0xff
}

encoding particle = {
    particle_id: varint
    data: match particle_id {
        3 | 23 => {
            block_state: varint
        }    // 3, 23
        14 => {
            red: f32be
            green: f32be
            blue: f32be
            scale: f32be
        }    // 14
        32 => {
            item: slot
        }    // 32
        _ => { }
    }
}

// --- packets ---

packet declare_recipes {
    recipes_count: varint
    recipes: {
        type: string
        recipe_id: string
        data: {
            if type == "minecraft:crafting_shapeless" {
                group: string
                ingredients_count: varint
                ingredients: ingredient[] count = ingredients_count
                result: slot
            }
            if type == "minecraft:crafting_shaped" {
                width: varint
                height: varint
                group_2: string
                ingredients_2: {
                    value: ingredient[] count = height
                }[] count = width
                result_2: slot
            }
            if (((type == "minecraft:smelting") || (type == "minecraft:blasting")) || (type == "minecraft:smoking")) || (type == "minecraft:campfire_cooking") {
                value: minecraft_smelting_format
            }
            if type == "minecraft:stonecutting" {
                group_3: string
                ingredient: ingredient
                result_3: slot
            }
        }
    }[] count = recipes_count
}

packet entity_metadata {
    entity_id: varint
    metadata: entity_metadata
}

packet update_jigsaw_block {
    location: position
    attachment_type: string
    target_pool: string
    final_state: string
}

packet update_light {
    chunk_x: varint
    chunk_z: varint
    sky_light_mask: varint
    block_light_mask: varint
    empty_sky_light_mask: varint
    empty_block_light_mask: varint
    data: rest
}

