import "../../std/integers.bps"
import "../../std/varint.bps"
import "from_1_13.bps"
import "from_1_20_2.bps"
import "from_1_21_5.bps"

encoding recipe_book_setting = {
    open: boolean
    filtering: boolean
}

// --- packets ---

packet change_gamemode {
    mode: varint
}

packet clear_dialog_configuration_clientbound { }

packet clear_dialog_play_clientbound { }

packet difficulty {
    difficulty: varint
    difficulty_locked: boolean
}

packet recipe_book_settings {
    crafting: recipe_book_setting
    furnace: recipe_book_setting
    blast: recipe_book_setting
    smoker: recipe_book_setting
}

packet set_difficulty {
    new_difficulty: varint
}

packet show_dialog_configuration_clientbound {
    dialog: anonymous_nbt
}

packet show_dialog_play_clientbound {
    dialog: {
        id: varint
        if id == 0 {
            data: anonymous_nbt
        }
    }
}

packet tracked_waypoint {
    operation: varint
    waypoint: {
        has_uuid: boolean
        match has_uuid {
            1 => {
                uuid: uuid
            }    // true
            0 => {
                id: string
            }    // false
            _ => { }
        }
        icon: {
            style: string
            has_color: boolean
            if has_color {
                color: {
                    red: u8
                    green: u8
                    blue: u8
                }
            }
        }
        type: varint
        data: match type {
            1 => vec3i    // vec3i
            2 => {
                chunk_x: varint
                chunk_z: varint
            }    // chunk
            3 => f32be    // azimuth
            _ => { }
        }
    }
}

