encoding entity_metadata_painting_variant = {
    width: i32be
    height: i32be
    asset_id: string
    has_title: boolean
    if has_title {
        title: anonymous_nbt
    }
    has_author: boolean
    if has_author {
        author: anonymous_nbt
    }
}

encoding id_set = {
    value: {
        set_type: varint
        if set_type == 0 {
            name: string
        }
        match set_type > 0 {
            1 => {
                ids: varint[] count = set_type - 1
            }
            _ => { }
        }
    }
}

encoding instrument_data = {
    sound_event: item_sound_holder
    use_duration: f32be
    range: f32be
    description: anonymous_nbt
}

encoding item_book_page = {
    content: string
    has_filtered_content: boolean
    if has_filtered_content {
        filtered_content: string
    }
}

encoding item_effect_detail = {
    amplifier: varint
    duration: varint
    ambient: boolean
    show_particles: boolean
    show_icon: boolean
    has_hidden_effect: boolean
    if has_hidden_effect {
        hidden_effect: item_effect_detail
    }
}

encoding item_firework_explosion = {
    shape: varint
    colors_count: varint
    colors: i32be[] count = colors_count
    fade_colors_count: varint
    fade_colors: i32be[] count = fade_colors_count
    has_trail: boolean
    has_twinkle: boolean
}

encoding item_potion_effect = {
    id: varint
    details: item_effect_detail
}

encoding item_written_book_page = {
    content: anonymous_nbt
    filtered_content: anon_optional_nbt
}

encoding slot_component_type = varint

