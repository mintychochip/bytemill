encoding entity_metadata = {
    value: {
        key: u8
        type: varint
        value: match type {
            0 => i8    // byte
            1 | 12 | 14 | 20 | 21 | 22 | 24 | 25 => varint    // int, direction, block_state, pose, cat_variant, frog_variant, painting_variant, sniffer_state
            2 => varlong    // long
            3 => f32be    // float
            4 => string    // string
            5 | 16 => anonymous_nbt    // component, compound_tag
            6 => {
                has_value: boolean
                if has_value {
                    value: anonymous_nbt
                }
            }    // optional_component
            7 => slot    // item_stack
            8 => boolean    // boolean
            9 => {
                pitch: f32be
                yaw: f32be
                roll: f32be
            }    // rotations
            10 => position    // block_pos
            11 => {
                has_value: boolean
                if has_value {
                    value: position
                }
            }    // optional_block_pos
            13 => {
                has_value: boolean
                if has_value {
                    value: uuid
                }
            }    // optional_uuid
            15 | 19 => optvarint    // optional_block_state, optional_unsigned_int
            17 => particle    // particle
            18 => {
                villager_type: varint
                villager_profession: varint
                level: varint
            }    // villager_data
            23 => {
                has_value: boolean
                if has_value {
                    value: string
                }
            }    // optional_global_pos
            26 => vec3f    // vector3
            27 => vec4f    // quaternion
            _ => { }
        }
    }[] until 0xff
}

encoding particle = {
    type: varint
}

