encoding entity_equipment_equipments = {
    slot_byte: u8
    slot = slot_byte & 127
    item: slot
    if (slot_byte & 128) != 0 {
        next: entity_equipment_equipments
    }
}

encoding entity_metadata = {
    value: entity_metadata_entry[] until 0xff
}

encoding entity_metadata_entry = {
    key: u8
    type: varint
    value: match type {
        0 => i8    // byte
        1 | 12 | 14 | 21 | 22 | 24 | 27 | 28 => varint    // int, direction, block_state, pose, cat_variant, frog_variant, sniffer_state, armadillo_state
        2 => varlong    // long
        3 => f32be    // float
        4 => string    // string
        5 | 16 => anonymous_nbt    // component, compound_tag
        6 => {
            has_value: boolean
            if has_value {
                value: anonymous_nbt
            }
        }    // optional_component
        7 => slot    // item_stack
        8 => boolean    // boolean
        9 => {
            pitch: f32be
            yaw: f32be
            roll: f32be
        }    // rotations
        10 => position    // block_pos
        11 => {
            has_value: boolean
            if has_value {
                value: position
            }
        }    // optional_block_pos
        13 => {
            has_value: boolean
            if has_value {
                value: uuid
            }
        }    // optional_uuid
        15 | 20 => optvarint    // optional_block_state, optional_unsigned_int
        17 => particle    // particle
        18 => {
            value_count: varint
            value: particle[] count = value_count
        }    // particles
        19 => {
            villager_type: varint
            villager_profession: varint
            level: varint
        }    // villager_data
        23 => {
            value: {
                id: varint
                if id == 0 {
                    variant_data: entity_metadata_wolf_variant
                }
            }
        }    // wolf_variant
        25 => {
            has_value: boolean
            if has_value {
                value: string
            }
        }    // optional_global_pos
        26 => {
            value: {
                id: varint
                if id == 0 {
                    variant_data: entity_metadata_painting_variant
                }
            }
        }    // painting_variant
        29 => vec3f    // vector3
        30 => vec4f    // quaternion
        _ => { }
    }
}

encoding ingredient = {
    value_count: varint
    value: slot[] count = value_count
}

encoding minecraft_smelting_format = {
    group: string
    category: varint
    ingredient: ingredient
    result: slot
    experience: f32be
    cook_time: varint
}

encoding particle = {
    type: varint
    data: match type {
        1 | 2 | 28 | 105 | 99 => varint    // block, block_marker, falling_dust, dust_pillar, shriek
        13 => {
            red: f32be
            green: f32be
            blue: f32be
            scale: f32be
        }    // dust
        14 => {
            from_red: f32be
            from_green: f32be
            from_blue: f32be
            scale: f32be
            to_red: f32be
            to_green: f32be
            to_blue: f32be
        }    // dust_color_transition
        20 => i32be    // entity_effect
        44 => slot    // item
        35 => f32be    // sculk_charge
        45 => {
            position_type: varint
            position: match position_type {
                0 => position    // block
                1 => {
                    entity_id: varint
                    entity_eye_height: f32be
                }    // entity
                _ => { }
            }
            ticks: varint
        }    // vibration
        _ => { }
    }
}

encoding slot = {
    item_count: i8
    match item_count {
        0 => { }    // 0
        _ => {
            item_id: varint
            added_component_count: varint
            removed_component_count: varint
            components: slot_component[] count = added_component_count
            remove_components: {
                type: slot_component_type
            }[] count = removed_component_count
        }
    }
}

encoding slot_component = {
    type: slot_component_type
    data: match type {
        0 | 5 | 6 | 19 | 27 | 36 | 37 | 38 | 39 | 42 | 54 | 55 => anonymous_nbt    // custom_data, custom_name, item_name, intangible_projectile, map_decorations, debug_stick_state, entity_data, bucket_entity_data, block_entity_data, recipes, lock, container_loot
        1 | 2 | 3 | 13 | 16 | 26 | 28 | 41 | 49 => varint    // max_stack_size, max_damage, damage, custom_model_data, repair_cost, map_id, map_post_processing, ominous_bottle_amplifier, base_color
        4 | 18 => boolean    // unbreakable, enchantment_glint_override
        7 => {
            data_count: varint
            data: anon_optional_nbt[] count = data_count
        }    // lore
        8 => varint    // rarity
        9 => {
            enchantments_count: varint
