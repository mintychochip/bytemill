            show_tooltip: boolean
        }    // attribute_modifiers
        14 | 15 | 17 | 21 => { }    // hide_additional_tooltip, hide_tooltip, creative_slot_lock, fire_resistant
        20 => {
            nutrition: varint
            saturation_modifier: f32be
            can_always_eat: boolean
            seconds_to_eat: f32be
            using_converts_to: slot
            effects_count: varint
            effects: {
                effect: varint
                probability: f32be
            }[] count = effects_count
        }    // food
        22 => {
            rules_count: varint
            rules: {
                blocks: id_set
                has_speed: boolean
                if has_speed {
                    speed: f32be
                }
                has_correct_drop_for_blocks: boolean
                if has_correct_drop_for_blocks {
                    correct_drop_for_blocks: boolean
                }
            }[] count = rules_count
            default_mining_speed: f32be
            damage_per_block: varint
        }    // tool
        23 => {
            enchantments_count: varint
            enchantments: {
                id: varint
                level: varint
            }[] count = enchantments_count
            show_in_tooltip: boolean
        }    // stored_enchantments
        24 => {
            color: i32be
            show_tooltip: boolean
        }    // dyed_color
        25 => i32be    // map_color
        29 => {
            projectiles_count: varint
            projectiles: slot[] count = projectiles_count
        }    // charged_projectiles
        30 | 51 => {
            contents_count: varint
            contents: slot[] count = contents_count
        }    // bundle_contents, container
        31 => {
            has_potion_id: boolean
            if has_potion_id {
                potion_id: varint
            }
            has_custom_color: boolean
            if has_custom_color {
                custom_color: i32be
            }
            custom_effects_count: varint
            custom_effects: item_potion_effect[] count = custom_effects_count
            has_custom_name: boolean
            if has_custom_name {
                custom_name: string
            }
        }    // potion_contents
        32 => {
            effects_count: varint
            effects: {
                effect: varint
                duration: varint
            }[] count = effects_count
        }    // suspicious_stew_effects
        33 => {
            pages_count: varint
            pages: item_book_page[] count = pages_count
        }    // writable_book_content
        34 => {
            raw_title: string
            has_filtered_title: boolean
            if has_filtered_title {
                filtered_title: string
            }
            author: string
            generation: varint
            pages_count: varint
            pages: item_written_book_page[] count = pages_count
            resolved: boolean
        }    // written_book_content
        35 => {
            material: {
                id: varint
                if id == 0 {
                    data: armor_trim_material
                }
            }
            pattern: {
                id: varint
                if id == 0 {
                    data: armor_trim_pattern
                }
            }
            show_in_tooltip: boolean
        }    // trim
        40 => {
            data: {
                id: varint
                if id == 0 {
                    data: instrument_data
                }
            }
        }    // instrument
        43 => {
            has_global_position: boolean
            if has_global_position {
                global_position: {
                    dimension: string
                    position: position
                }
            }
            tracked: boolean
        }    // lodestone_tracker
        44 => item_firework_explosion    // firework_explosion
        45 => {
            flight_duration: varint
            explosions_count: varint
            explosions: item_firework_explosion[] count = explosions_count
