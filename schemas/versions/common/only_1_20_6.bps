}

// --- packets ---

packet advancements {
    reset: boolean
    advancement_mapping_count: varint
    advancement_mapping: {
        key: string
        value: {
            has_parent_id: boolean
            if has_parent_id {
                parent_id: string
            }
            has_display_data: boolean
            if has_display_data {
                display_data: {
                    title: anonymous_nbt
                    description: anonymous_nbt
                    icon: slot
                    frame_type: varint
                    flags: u32be
                    flags_unused = flags >> 3
                    flags_hidden = (flags >> 2) & 1
                    flags_show_toast = (flags >> 1) & 1
                    flags_has_background_texture = flags & 1
                    background_texture: match flags_has_background_texture {
                        1 => string    // 1
                        _ => { }
                    }
                    x_cord: f32be
                    y_cord: f32be
                }
            }
            requirements_count: varint
            requirements: {
                value_count: varint
                value: string[] count = value_count
            }[] count = requirements_count
            sends_telemtry_data: boolean
        }
    }[] count = advancement_mapping_count
    identifiers_count: varint
    identifiers: string[] count = identifiers_count
    progress_mapping_count: varint
    progress_mapping: {
        key: string
        value_count: varint
        value: {
            criterion_identifier: string
            has_criterion_progress: boolean
            if has_criterion_progress {
                criterion_progress: i64be
            }
        }[] count = value_count
    }[] count = progress_mapping_count
}

packet declare_recipes {
    recipes_count: varint
    recipes: {
        name: string
        type: varint
        data: match type {
            1 => {
                group: string
                category: varint
                ingredients_count: varint
                ingredients: ingredient[] count = ingredients_count
                result: slot
            }    // minecraft:crafting_shapeless
            0 => {
                group: string
                category: varint
                grid_width: varint
                grid_height: varint
                ingredients: {
                    value: ingredient[] count = grid_height
                }[] count = grid_width
                result: slot
                show_notification: boolean
            }    // minecraft:crafting_shaped
            2 | 3 | 4 | 5 | 6 | 7 | 8 | 15 | 9 | 10 | 11 | 12 | 13 | 14 | 23 => minecraft_simple_recipe_format    // minecraft:crafting_special_armordye, minecraft:crafting_special_bookcloning, minecraft:crafting_special_mapcloning, minecraft:crafting_special_mapextending, minecraft:crafting_special_firework_rocket, minecraft:crafting_special_firework_star, minecraft:crafting_special_firework_star_fade, minecraft:crafting_special_repairitem, minecraft:crafting_special_tippedarrow, minecraft:crafting_special_bannerduplicate, minecraft:crafting_special_banneraddpattern, minecraft:crafting_special_shielddecoration, minecraft:crafting_special_shulkerboxcoloring, minecraft:crafting_special_suspiciousstew, minecraft:crafting_decorated_pot
            16 | 17 | 18 | 19 => minecraft_smelting_format    // minecraft:smelting, minecraft:blasting, minecraft:smoking, minecraft:campfire_cooking
            20 => {
                group: string
                ingredient: ingredient
                result: slot
            }    // minecraft:stonecutting
            21 => {
                template: ingredient
                base: ingredient
                addition: ingredient
                result: slot
            }    // minecraft:smithing_transform
            22 => {
                template: ingredient
                base: ingredient
                addition: ingredient
            }    // minecraft:smithing_trim
            _ => { }
        }
    }[] count = recipes_count
}

packet entity_equipment {
    entity_id: varint
    equipments: entity_equipment_equipments
}

packet entity_metadata {
    entity_id: varint
    metadata: entity_metadata
}

packet entity_update_attributes {
    entity_id: varint
    properties_count: varint
    properties: {
        key: varint
        value: f64be
        modifiers_count: varint
        modifiers: {
            uuid: uuid
            amount: f64be
            operation: i8
        }[] count = modifiers_count
    }[] count = properties_count
}

packet explosion {
    x: f64be
    y: f64be
    z: f64be
    radius: f32be
    affected_block_offsets_count: varint
    affected_block_offsets: {
        x: i8
        y: i8
        z: i8
    }[] count = affected_block_offsets_count
    player_motion_x: f32be
    player_motion_y: f32be
    player_motion_z: f32be
    block_interaction_type: varint
    small_explosion_particle: particle
    large_explosion_particle: particle
    sound: item_sound_holder
}

packet set_creative_slot {
    slot: i16be
    item: slot
}

packet set_projectile_power {
    id: varint
    power: vec3f64
}

packet set_slot {
    window_id: container_id
    state_id: varint
    slot: i16be
    item: slot
}

packet trade_list {
    window_id: container_id
    trades_count: varint
    trades: {
        input_item1: {
            item_id: varint
            item_count: varint
            added_component_count: varint
            components: slot_component[] count = added_component_count
        }
        output_item: slot
        has_input_item2: boolean
        if has_input_item2 {
            input_item2: {
                item_id: varint
                item_count: varint
                added_component_count: varint
                components: slot_component[] count = added_component_count
            }
        }
        trade_disabled: boolean
        nb_trade_uses: i32be
        maximum_nb_trade_uses: i32be
        xp: i32be
        special_price: i32be
        price_multiplier: f32be
        demand: i32be
    }[] count = trades_count
    villager_level: varint
    experience: varint
    is_regular_villager: boolean
    can_restock: boolean
}

packet window_click {
    window_id: container_id
    state_id: varint
    slot: i16be
    mouse_button: i8
    mode: varint
    changed_slots_count: varint
    changed_slots: {
        location: i16be
        item: slot
    }[] count = changed_slots_count
    cursor_item: slot
}

packet window_items {
    window_id: container_id
    state_id: varint
    items_count: varint
    items: slot[] count = items_count
    carried_item: slot
}

packet world_particles {
    long_distance: boolean
    x: f64be
    y: f64be
    z: f64be
    offset_x: f32be
    offset_y: f32be
    offset_z: f32be
    velocity_offset: f32be
    amount: i32be
    particle: particle
}

