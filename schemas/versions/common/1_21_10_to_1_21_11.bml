// Shared by: 1.21.10 (protocol 773) to 1.21.11 (protocol 774).
// GENERATED by `bml import-versions` from data/minecraft-data (PrismarineJS/minecraft-data).
// Do not edit: change the importer or schemas/versions/manifest.json and regenerate.

import "../../std/integers.bml"
import "../../std/varint.bml"
import "from_1_13.bml"
import "from_1_19_3.bml"
import "from_1_19_4.bml"
import "from_1_20_2.bml"
import "from_1_21_10.bml"

encoding spawn_info = {
    dimension: varint
    name: string
    hashed_seed: i64be
    gamemode: i8
    previous_gamemode: u8
    is_debug: boolean
    is_flat: boolean
    has_death: boolean
    if has_death {
        death: global_pos
    }
    portal_cooldown: varint
    sea_level: varint
}

// --- packets ---

packet login {
    entity_id: i32be
    is_hardcore: boolean
    world_names_count: varint
    world_names: string[] count = world_names_count
    max_players: varint
    view_distance: varint
    simulation_distance: varint
    reduced_debug_info: boolean
    enable_respawn_screen: boolean
    do_limited_crafting: boolean
    world_state: spawn_info
    enforces_secure_chat: boolean
}

packet move_minecart {
    entity_id: varint
    steps_count: varint
    steps: {
        position: vec3f
        velocity: vec3f
        yaw: f32be
        pitch: f32be
        weight: f32be
    }[] count = steps_count
}

packet player_info {
    action: u8
    action_add_player = (action & 1) != 0
    action_initialize_chat = (action & 2) != 0
    action_update_game_mode = (action & 4) != 0
    action_update_listed = (action & 8) != 0
    action_update_latency = (action & 16) != 0
    action_update_display_name = (action & 32) != 0
    action_update_hat = (action & 64) != 0
    action_update_list_order = (action & 128) != 0
    data_count: varint
    data: {
        uuid: uuid
        player: match action_add_player {
            1 => game_profile_name_prop    // true
            _ => { }
        }
        chat_session: match action_initialize_chat {
            1 => chat_session    // true
            _ => { }
        }
        gamemode: match action_update_game_mode {
            1 => varint    // true
            _ => { }
        }
        listed: match action_update_listed {
            1 => varint    // true
            _ => { }
        }
        latency: match action_update_latency {
            1 => varint    // true
            _ => { }
        }
        match action_update_display_name {
            1 => {
                has_display_name: boolean
                if has_display_name {
                    display_name: anonymous_nbt
                }
            }    // true
            _ => {
                has_display_name = false
            }
        }
        list_priority: match action_update_list_order {
            1 => varint    // true
            _ => { }
        }
        show_hat: match action_update_hat {
            1 => boolean    // true
            _ => { }
        }
    }[] count = data_count
}

packet respawn {
    world_state: spawn_info
    copy_metadata: u8
}

