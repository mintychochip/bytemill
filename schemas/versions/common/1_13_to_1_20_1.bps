import "../../std/integers.bps"
import "../../std/varint.bps"
import "from_1_13.bps"

// protodef `nbt`: root tag type, root name (read even for TAG_End), payload.
encoding nbt = {
    tag_type: u8
    name:     nbt_string
    ...nbt_payload
}

// protodef `optionalNbt`: a first byte of 0 is the whole value; otherwise a named root.
encoding optional_nbt = {
    tag_type: u8
    if tag_type != 0 {
        name: nbt_string
    }
    ...nbt_payload
}

// --- packets ---

packet disconnect {
    reason: string
}

packet nbt_query_response {
    transaction_id: varint
    nbt: optional_nbt
}

packet resource_pack_receive {
    result: varint
}

packet scoreboard_display_objective {
    position: i8
    name: string
}

packet unload_chunk {
    chunk_x: i32be
    chunk_z: i32be
}

