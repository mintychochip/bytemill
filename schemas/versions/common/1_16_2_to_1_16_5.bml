packet declare_recipes {
    recipes_count: varint
    recipes: {
        type: string
        recipe_id: string
        data: {
            if type == "minecraft:crafting_shapeless" {
                group: string
                ingredients_count: varint
                ingredients: ingredient[] count = ingredients_count
                result: slot
            }
            if type == "minecraft:crafting_shaped" {
                width: varint
                height: varint
                group_2: string
                ingredients_2: {
                    value: ingredient[] count = width
                }[] count = height
                result_2: slot
            }
            if (((type == "minecraft:smelting") || (type == "minecraft:blasting")) || (type == "minecraft:smoking")) || (type == "minecraft:campfire_cooking") {
                value: minecraft_smelting_format
            }
            if type == "minecraft:stonecutting" {
                group_3: string
                ingredient: ingredient
                result_3: slot
            }
            if type == "minecraft:smithing" {
                base: ingredient
                addition: ingredient
                result_4: slot
            }
        }
    }[] count = recipes_count
}

packet login {
    entity_id: i32be
    is_hardcore: boolean
    game_mode: u8
    previous_game_mode: u8
    world_names_count: varint
    world_names: string[] count = world_names_count
    dimension_codec: nbt
    dimension: nbt
    world_name: string
    hashed_seed: i64be
    max_players: varint
    view_distance: varint
    reduced_debug_info: boolean
    enable_respawn_screen: boolean
    is_debug: boolean
    is_flat: boolean
}

packet map_chunk {
    x: i32be
    z: i32be
    ground_up: boolean
    bit_map: varint
    heightmaps: nbt
    biomes: match ground_up {
        0 => { }    // false
        1 => {
            biomes_count: varint
            biomes: varint[] count = biomes_count
        }    // true
        _ => { }
    }
    chunk_data_len: varint
    chunk_data: bytes(chunk_data_len)
    block_entities_count: varint
    block_entities: nbt[] count = block_entities_count
}

