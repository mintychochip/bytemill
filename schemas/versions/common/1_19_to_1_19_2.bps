// --- packets ---

packet chat_preview_play_clientbound {
    query_id: i32be
    has_message: boolean
    if has_message {
        message: string
    }
}

packet chat_preview_play_serverbound {
    query: i32be
    message: string
}

packet declare_commands {
    nodes_count: varint
    nodes: command_node[] count = nodes_count
    root_index: varint
}

packet encryption_begin_login_serverbound {
    shared_secret_len: varint
    shared_secret: bytes(shared_secret_len)
    has_verify_token: boolean
    crypto: match has_verify_token {
        1 => {
            verify_token_len: varint
            verify_token: bytes(verify_token_len)
        }    // true
        0 => {
            salt: i64be
            message_signature_len: varint
            message_signature: bytes(message_signature_len)
        }    // false
        _ => { }
    }
}

packet entity_sound_effect {
    sound_id: varint
    sound_category: varint
    entity_id: varint
    volume: f32be
    pitch: f32be
    seed: i64be
}

packet named_sound_effect {
    sound_name: string
    sound_category: varint
    x: i32be
    y: i32be
    z: i32be
    volume: f32be
    pitch: f32be
    seed: i64be
}

packet player_info {
    action: varint
    data_count: varint
    data: {
        uuid: uuid
        match action {
            0 => {
                name: string
                properties_count: varint
                properties: {
                    name: string
                    value: string
                    has_signature: boolean
                    if has_signature {
                        signature: string
                    }
                }[] count = properties_count
                gamemode: varint
                ping: varint
                has_display_name: boolean
                if has_display_name {
                    display_name: string
                }
                has_crypto: boolean
                if has_crypto {
                    crypto: {
                        timestamp: i64be
                        public_key: byte_array
                        signature: byte_array
                    }
                }
            }    // add_player
            1 => {
                gamemode_2: varint
            }    // update_game_mode
            2 => {
                ping_2: varint
            }    // update_latency
            3 => {
                has_display_name_2: boolean
                if has_display_name_2 {
                    display_name_2: string
                }
            }    // update_display_name
            4 => { }    // remove_player
            _ => { }
        }
    }[] count = data_count
}

packet should_display_chat_preview {
    should_display_chat_preview: boolean
}

packet sound_effect {
    sound_id: varint
    sound_category: varint
    x: i32be
    y: i32be
    z: i32be
    volume: f32be
    pitch: f32be
    seed: i64be
}

