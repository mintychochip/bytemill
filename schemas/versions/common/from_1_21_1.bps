import "../../std/integers.bps"
import "../../std/varint.bps"
import "from_1_13.bps"
import "from_1_19_3.bps"
import "from_1_20_2.bps"

encoding chat_type = {
    translation_key: string
    parameters_count: varint
    parameters: chat_type_parameter_type[] count = parameters_count
    style: anonymous_nbt
}

encoding chat_type_parameter_type = varint

encoding chat_types = {
    chat: chat_type
    narration: chat_type
}

encoding chat_types_holder = {
    value: {
        id: varint
        if id == 0 {
            data: chat_types
        }
    }
}

encoding jukebox_song_data = {
    sound_event: item_sound_holder
    description: anonymous_nbt
    length_in_seconds: f32be
    comparator_output: varint
}

encoding server_link_type = varint

encoding vec2f = {
    x: f32be
    y: f32be
}

// --- packets ---

packet custom_report_details_configuration_clientbound {
    details_count: varint
    details: {
        key: string
        value: string
    }[] count = details_count
}

packet custom_report_details_play_clientbound {
    details_count: varint
    details: {
        key: string
        value: string
    }[] count = details_count
}

packet entity_update_attributes {
    entity_id: varint
    properties_count: varint
    properties: {
        key: varint
        value: f64be
        modifiers_count: varint
        modifiers: {
            uuid: string
            amount: f64be
            operation: i8
        }[] count = modifiers_count
    }[] count = properties_count
}

packet profileless_chat {
    message: anonymous_nbt
    type: chat_types_holder
    name: anonymous_nbt
    has_target: boolean
    if has_target {
        target: anonymous_nbt
    }
}

packet server_links_configuration_clientbound {
    links_count: varint
    links: {
        has_known_type: boolean
        known_type: match has_known_type {
            1 => server_link_type    // true
            _ => { }
        }
        unknown_type: match has_known_type {
            0 => anonymous_nbt    // false
            _ => { }
        }
        link: string
    }[] count = links_count
}

packet server_links_play_clientbound {
    links_count: varint
    links: {
        has_known_type: boolean
        known_type: match has_known_type {
            1 => server_link_type    // true
            _ => { }
        }
        unknown_type: match has_known_type {
            0 => anonymous_nbt    // false
            _ => { }
        }
        link: string
    }[] count = links_count
}

packet set_projectile_power {
    id: varint
    acceleration_power: f64be
}

packet use_item {
    hand: varint
    sequence: varint
    rotation: vec2f
}

