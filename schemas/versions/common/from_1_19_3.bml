// Shared by: 1.19.3 (protocol 761) onwards.
// GENERATED by `bml import-versions` from data/minecraft-data (PrismarineJS/minecraft-data).
// Do not edit: change the importer or schemas/versions/manifest.json and regenerate.

import "../../std/integers.bml"
import "../../std/varint.bml"
import "from_1_13.bml"

encoding chat_session = {
    has_value: boolean
    if has_value {
        value: {
            uuid: uuid
            public_key: {
                expire_time: i64be
                key_bytes_len: varint
                key_bytes: bytes(key_bytes_len)
                key_signature_len: varint
                key_signature: bytes(key_signature_len)
            }
        }
    }
}

encoding item_sound_event = {
    sound_name: string
    has_fixed_range: boolean
    if has_fixed_range {
        fixed_range: f32be
    }
}

encoding item_sound_holder = {
    value: {
        id: varint
        if id == 0 {
            data: item_sound_event
        }
    }
}

encoding previous_messages = {
    value_count: varint
    value: {
        id: varint
        signature: match id {
            0 => {
                signature: bytes(256)
            }    // 0
            _ => { }
        }
    }[] count = value_count
}

encoding sound_source = varint

// --- packets ---

packet feature_flags {
    features_count: varint
    features: string[] count = features_count
}

packet hide_message {
    id: varint
    signature: match id {
        0 => {
            signature: bytes(256)
        }    // 0
        _ => { }
    }
}

packet message_acknowledgement {
    count: varint
}

packet player_remove {
    players_count: varint
    players: uuid[] count = players_count
}

packet sound_effect {
    sound: item_sound_holder
    sound_category: sound_source
    x: i32be
    y: i32be
    z: i32be
    volume: f32be
    pitch: f32be
    seed: i64be
}

