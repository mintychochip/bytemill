// Shared by: 1.21.3 (protocol 768) onwards.
// GENERATED by `bml import-versions` from data/minecraft-data (PrismarineJS/minecraft-data).
// Do not edit: change the importer or schemas/versions/manifest.json and regenerate.

import "../../std/integers.bps"
import "../../std/varint.bps"
import "from_1_13.bps"
import "from_1_14.bps"
import "from_1_19_3.bps"
import "from_1_20_6.bps"

encoding container_id = varint

encoding item_consume_effect = {
    type: varint
    match type {
        0 => {
            effects_count: varint
            effects: item_potion_effect[] count = effects_count
            probability: f32be
        }    // apply_effects
        1 => {
            effects_2: id_set
        }    // remove_effects
        2 => { }    // clear_all_effects
        3 => {
            diameter: f32be
        }    // teleport_randomly
        4 => {
            sound: item_sound_holder
        }    // play_sound
        _ => { }
    }
}

encoding movement_flags = {
    raw: u8
    raw_on_ground = (raw & 1) != 0
    raw_has_horizontal_collision = (raw & 2) != 0
}

encoding position_update_relatives = {
    raw: u32be
    raw_x = (raw & 1) != 0
    raw_y = (raw & 2) != 0
    raw_z = (raw & 4) != 0
    raw_yaw = (raw & 8) != 0
    raw_pitch = (raw & 16) != 0
    raw_dx = (raw & 32) != 0
    raw_dy = (raw & 64) != 0
    raw_dz = (raw & 128) != 0
    raw_yaw_delta = (raw & 256) != 0
}

// --- packets ---

packet block_place {
    hand: varint
    location: position
    direction: varint
    cursor_x: f32be
    cursor_y: f32be
    cursor_z: f32be
    inside_block: boolean
    world_border_hit: boolean
    sequence: varint
}

packet close_window_play_clientbound {
    window_id: container_id
}

packet close_window_play_serverbound {
    window_id: container_id
}

packet craft_progress_bar {
    window_id: container_id
    property: i16be
    value: i16be
}

packet craft_recipe_request {
    window_id: container_id
    recipe_id: varint
    make_all: boolean
}

packet displayed_recipe {
    recipe_id: varint
}

packet entity_teleport {
    entity_id: varint
    x: f64be
    y: f64be
    z: f64be
    dx: f64be
    dy: f64be
    dz: f64be
    yaw: f32be
    pitch: f32be
    flags: position_update_relatives
    on_ground: boolean
}

packet flying {
    flags: movement_flags
}

packet look {
    yaw: f32be
    pitch: f32be
    flags: movement_flags
}

packet open_horse_window {
    window_id: container_id
    nb_slots: varint
    entity_id: i32be
}

packet player_input {
    inputs: u8
    inputs_forward = (inputs & 1) != 0
    inputs_backward = (inputs & 2) != 0
    inputs_left = (inputs & 4) != 0
    inputs_right = (inputs & 8) != 0
    inputs_jump = (inputs & 16) != 0
    inputs_shift = (inputs & 32) != 0
    inputs_sprint = (inputs & 64) != 0
}

packet position_look {
    x: f64be
    y: f64be
    z: f64be
    yaw: f32be
    pitch: f32be
    flags: movement_flags
}

packet position_play_clientbound {
    teleport_id: varint
    x: f64be
    y: f64be
    z: f64be
    dx: f64be
    dy: f64be
    dz: f64be
    yaw: f32be
    pitch: f32be
    flags: position_update_relatives
}

packet position_play_serverbound {
    x: f64be
    y: f64be
    z: f64be
    flags: movement_flags
}

packet recipe_book_remove {
    recipe_ids_count: varint
    recipe_ids: varint[] count = recipe_ids_count
}

packet select_bundle_item {
    slot_id: varint
    selected_item_index: varint
}

packet set_cooldown {
    cooldown_group: string
    cooldown_ticks: varint
}

packet set_slot_state {
    slot_id: varint
    window_id: container_id
    state: boolean
}

packet settings_configuration_serverbound {
    locale: string
    view_distance: i8
    chat_flags: varint
    chat_colors: boolean
    skin_parts: u8
    main_hand: varint
    enable_text_filtering: boolean
    enable_server_listing: boolean
    particle_status: varint
}

packet settings_play_serverbound {
    locale: string
    view_distance: i8
    chat_flags: varint
    chat_colors: boolean
    skin_parts: u8
    main_hand: varint
    enable_text_filtering: boolean
    enable_server_listing: boolean
    particle_status: varint
}

packet tick_end { }

