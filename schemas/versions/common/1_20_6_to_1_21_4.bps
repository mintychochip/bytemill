packet chat_command_signed {
    command: string
    timestamp: i64be
    salt: i64be
    argument_signatures_count: varint
    argument_signatures: {
        argument_name: string
        signature: bytes(256)
    }[] count = argument_signatures_count
    message_count: varint
    acknowledged: bytes(3)
}

packet declare_commands {
    nodes_count: varint
    nodes: command_node[] count = nodes_count
    root_index: varint
}

