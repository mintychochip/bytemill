encoding debug_structure_info = {
    bounding_box_min: position
    bounding_box_max: position
    pieces_count: varint
    pieces: {
        bounding_box_min: position
        bounding_box_max: position
        is_start: boolean
    }[] count = pieces_count
}

encoding debug_subscription_data_type = varint

encoding debug_subscription_event = {
    type: debug_subscription_data_type
    value: match type {
        0 | 10 => { }    // DedicatedServerTickTime, VillageSections
        1 => {
            has_hive_pos: boolean
            if has_hive_pos {
                hive_pos: position
            }
            has_flower_pos: boolean
            if has_flower_pos {
                flower_pos: position
            }
            travel_ticks: varint
            blacklisted_hives_count: varint
            blacklisted_hives: position[] count = blacklisted_hives_count
        }    // Bees
        2 => {
            name: string
            profession: string
            xp: i32be
            health: f32be
            max_health: f32be
            inventory: string
            wants_golem: boolean
            anger_level: i32be
            activities_count: varint
            activities: string[] count = activities_count
            behaviors_count: varint
            behaviors: string[] count = behaviors_count
            memories_count: varint
            memories: string[] count = memories_count
            gossips_count: varint
            gossips: string[] count = gossips_count
            pois_count: varint
            pois: position[] count = pois_count
            potential_pois_count: varint
            potential_pois: position[] count = potential_pois_count
        }    // Brains
        3 => {
            has_attack_target: boolean
            if has_attack_target {
                attack_target: varint
            }
            has_jump_target: boolean
            if has_jump_target {
                jump_target: position
            }
        }    // Breezes
        4 => {
            priority: varint
            running: boolean
            name: string
        }    // GoalSelectors
        5 => {
            path: path
            max_node_distance: f32be
        }    // EntityPaths
        6 => {
            id: varint
        }    // EntityBlockIntersections
        7 => {
            type: varint
            occupant_count: varint
            honey_level: varint
            sedated: boolean
        }    // BeeHives
        8 => {
            pos: position
            poi_type: varint
            free_ticket_count: varint
        }    // Pois
        9 => {
            index: varint
        }    // RedstoneWireOrientations
        11 => {
            positions_count: varint
            positions: position[] count = positions_count
        }    // Raids
        12 => {
            structures_count: varint
            structures: debug_structure_info[] count = structures_count
        }    // Structures
        13 => {
            listener_radius: varint
        }    // GameEventListeners
        14 => {
            pos: position
        }    // NeighborUpdates
        15 => {
            event: varint
            pos: vec3f64
        }    // GameEvents
        _ => { }
    }
}

encoding debug_subscription_update = {
    type: debug_subscription_data_type
    match type {
        0 => { }    // DedicatedServerTickTime
        _ => {
            has_payload: boolean
            match has_payload {
                1 => {
                    payload: {
                        payload: match type {
                            0 | 10 => { }    // DedicatedServerTickTime, VillageSections
                            1 => {
                                has_hive_pos: boolean
                                if has_hive_pos {
                                    hive_pos: position
                                }
                                has_flower_pos: boolean
                                if has_flower_pos {
                                    flower_pos: position
                                }
                                travel_ticks: varint
                                blacklisted_hives_count: varint
                                blacklisted_hives: position[] count = blacklisted_hives_count
                            }    // Bees
                            2 => {
                                name: string
                                profession: string
                                xp: i32be
                                health: f32be
                                max_health: f32be
                                inventory: string
                                wants_golem: boolean
                                anger_level: i32be
                                activities_count: varint
                                activities: string[] count = activities_count
                                behaviors_count: varint
                                behaviors: string[] count = behaviors_count
                                memories_count: varint
                                memories: string[] count = memories_count
                                gossips_count: varint
                                gossips: string[] count = gossips_count
                                pois_count: varint
                                pois: position[] count = pois_count
                                potential_pois_count: varint
                                potential_pois: position[] count = potential_pois_count
                            }    // Brains
                            3 => {
                                has_attack_target: boolean
                                if has_attack_target {
                                    attack_target: varint
                                }
                                has_jump_target: boolean
                                if has_jump_target {
                                    jump_target: position
                                }
                            }    // Breezes
                            4 => {
                                goals_count: varint
                                goals: {
                                    priority: varint
                                    running: boolean
                                    name: string
                                }[] count = goals_count
                            }    // GoalSelectors
                            5 => {
                                path: path
                                max_node_distance: f32be
                            }    // EntityPaths
                            6 => {
                                id: varint
                            }    // EntityBlockIntersections
                            7 => {
                                type: varint
                                occupant_count: varint
                                honey_level: varint
                                sedated: boolean
                            }    // BeeHives
                            8 => {
                                pos: position
                                poi_type: varint
                                free_ticket_count: varint
                            }    // Pois
                            9 => {
                                index: varint
                            }    // RedstoneWireOrientations
                            11 => {
                                positions_count: varint
                                positions: position[] count = positions_count
                            }    // Raids
                            12 => {
                                structures_count: varint
                                structures: debug_structure_info[] count = structures_count
                            }    // Structures
                            13 => {
                                listener_radius: varint
                            }    // GameEventListeners
                            14 => {
                                pos: position
                            }    // NeighborUpdates
                            15 => {
                                event: varint
                                pos: vec3f64
                            }    // GameEvents
                            _ => { }
                        }
                    }
                }
                _ => { }
            }
        }
    }
}

encoding game_profile_name_prop = {
    name: string
    properties_count: varint
    properties: game_profile_property[] count = properties_count
}

encoding game_profile_property = {
    name: string
    value: string
    has_signature: boolean
    if has_signature {
        signature: string
    }
}

encoding global_pos = {
    dimension_name: string
    location: position
}

// protodef `lpVec3`: one zero byte for the zero vector; otherwise 6 packed bytes, plus a
// VarInt scale extension when bit 2 of the first byte is set.
encoding lp_vec3 = {
    lead: u8
    if lead != 0 {
        mid:    u8
        packed: u32be
        if (lead & 4) != 0 {
            scale_extension: varint
        }
    }
}

encoding node = {
    position: vec3i32
    walked_distance: f32be
    cost_malus: f32be
    closed: boolean
    type: varint
    f: f32be
}

encoding path = {
    reached: boolean
    next_node_index: i32be
    target: position
    nodes_count: varint
    nodes: node[] count = nodes_count
    debug_data: path_debug_data
}

encoding path_debug_data = {
    open_set_count: varint
    open_set: node[] count = open_set_count
    closed_set_count: varint
    closed_set: node[] count = closed_set_count
    target_nodes_count: varint
    target_nodes: node[] count = target_nodes_count
}

encoding player_skin_patch = {
    has_body: boolean
    if has_body {
        body: string
    }
    has_cape: boolean
    if has_cape {
        cape: string
    }
    has_elytra: boolean
    if has_elytra {
        elytra: string
    }
    has_model: boolean
    if has_model {
        model: varint
    }
}

encoding resolvable_profile = {
    type: varint
    match type {
        0 => {
            has_name: boolean
            if has_name {
                name: string
            }
            has_uuid: boolean
            if has_uuid {
                uuid: uuid
            }
            properties_count: varint
            properties: game_profile_property[] count = properties_count
        }    // partial
        1 => {
            uuid_2: uuid
            name_2: string
            properties_count_2: varint
            properties_2: game_profile_property[] count = properties_count_2
        }    // complete
        _ => { }
    }
    skin_patch: player_skin_patch
}

encoding vec3i32 = {
    x: i32be
    y: i32be
    z: i32be
}

// --- packets ---

packet accept_code_of_conduct { }

packet code_of_conduct {
    contents: string
}

packet debug_block_value {
    block_pos: position
    update: debug_subscription_update
}

packet debug_chunk_value {
    chunk_pos: packed_chunk_pos
    update: debug_subscription_update
}

packet debug_entity_value {
    entity_id: varint
    update: debug_subscription_update
}

packet debug_event {
    event: debug_subscription_event
}

packet debug_subscription_request {
    subscriptions_count: varint
    subscriptions: debug_subscription_data_type[] count = subscriptions_count
}

packet entity_velocity {
    entity_id: varint
    velocity: lp_vec3
}

packet game_test_highlight_pos {
    absolute_pos: position
    relative_pos: position
}

packet player_rotation {
    yaw: f32be
    relative_yaw: boolean
    pitch: f32be
    relative_pitch: boolean
}

packet spawn_entity {
    entity_id: varint
    object_uuid: uuid
    type: varint
    x: f64be
    y: f64be
    z: f64be
    velocity: lp_vec3
    pitch: i8
    yaw: i8
    head_pitch: i8
    object_data: varint
}

packet spawn_position {
    global_pos: global_pos
    yaw: f32be
    pitch: f32be
}

