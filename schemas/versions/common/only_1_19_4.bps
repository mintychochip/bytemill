packet declare_recipes {
    recipes_count: varint
    recipes: {
        type: string
        recipe_id: string
        data: {
            if type == "minecraft:crafting_shapeless" {
                group: string
                category: varint
                ingredients_count: varint
                ingredients: ingredient[] count = ingredients_count
                result: slot
            }
            if type == "minecraft:crafting_shaped" {
                width: varint
                height: varint
                group_2: string
                category_2: varint
                ingredients_2: {
                    value: ingredient[] count = height
                }[] count = width
                result_2: slot
                show_notification: boolean
