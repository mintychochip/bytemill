            if ((((((((((((((type == "minecraft:crafting_special_armordye") || (type == "minecraft:crafting_special_bookcloning")) || (type == "minecraft:crafting_special_mapcloning")) || (type == "minecraft:crafting_special_mapextending")) || (type == "minecraft:crafting_special_firework_rocket")) || (type == "minecraft:crafting_special_firework_star")) || (type == "minecraft:crafting_special_firework_star_fade")) || (type == "minecraft:crafting_special_repairitem")) || (type == "minecraft:crafting_special_tippedarrow")) || (type == "minecraft:crafting_special_bannerduplicate")) || (type == "minecraft:crafting_special_banneraddpattern")) || (type == "minecraft:crafting_special_shielddecoration")) || (type == "minecraft:crafting_special_shulkerboxcoloring")) || (type == "minecraft:crafting_special_suspiciousstew")) || (type == "minecraft:crafting_decorated_pot") {
                value: minecraft_simple_recipe_format
            }
            if (((type == "minecraft:smelting") || (type == "minecraft:blasting")) || (type == "minecraft:smoking")) || (type == "minecraft:campfire_cooking") {
                value: minecraft_smelting_format
            }
            if type == "minecraft:stonecutting" {
                group_3: string
                ingredient: ingredient
                result_3: slot
            }
            if type == "minecraft:smithing" {
                base: ingredient
                addition: ingredient
                result_4: slot
            }
            if type == "minecraft:smithing_transform" {
                template: ingredient
                base_2: ingredient
                addition_2: ingredient
                result_5: slot
            }
            if type == "minecraft:smithing_trim" {
                template_2: ingredient
                base_3: ingredient
                addition_3: ingredient
            }
        }
    }[] count = recipes_count
}

packet entity_metadata {
