// Shared by: 1.14 (protocol 477) onwards.
// GENERATED by `bml import-versions` from data/minecraft-data (PrismarineJS/minecraft-data).
// Do not edit: change the importer or schemas/versions/manifest.json and regenerate.

import "../../std/integers.bps"
import "../../std/varint.bps"
import "from_1_13.bps"

encoding optvarint = varint

encoding position = {
    raw: u64be
    x = sign_extend(raw >> 38, 26)
    z = sign_extend((raw >> 12) & 67108863, 26)
    y = sign_extend(raw & 4095, 12)
}

// --- packets ---

packet block_action {
    location: position
    byte1: u8
    byte2: u8
    block_id: varint
}

packet block_break_animation {
    entity_id: varint
    location: position
    destroy_stage: i8
}

packet block_change {
    location: position
    type: varint
}

packet lock_difficulty {
    locked: boolean
}

packet open_book {
    hand: varint
}

packet query_block_nbt {
    transaction_id: varint
    location: position
}

packet update_command_block {
    location: position
    command: string
    mode: varint
    flags: u8
}

packet update_view_distance {
    view_distance: varint
}

packet update_view_position {
    chunk_x: varint
    chunk_z: varint
}

packet world_event {
    effect_id: i32be
    location: position
    data: i32be
    global: boolean
}

