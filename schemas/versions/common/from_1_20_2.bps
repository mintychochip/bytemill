import "../../std/integers.bps"
import "../../std/varint.bps"
import "from_1_13.bps"
import "from_1_14.bps"

// protodef `anonOptionalNbt`: a lone 00 is absent, which is `anonymous_nbt` with TAG_End.
encoding anon_optional_nbt = anonymous_nbt

// protodef `anonymousNbt` (protocol >= 764 wire): root tag type, then the payload, no name.
encoding anonymous_nbt = {
    tag_type: u8
    ...nbt_payload
}

encoding chunk_block_entity = {
    bits: u8
    x = bits >> 4
    z = bits & 15
    y: i16be
    type: varint
    nbt_data: anon_optional_nbt
}

// --- packets ---

packet chunk_batch_finished {
    batch_size: varint
}

packet chunk_batch_received {
    chunks_per_tick: f32be
}

packet chunk_batch_start { }

packet configuration_acknowledged { }

