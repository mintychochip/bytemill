packet tags_configuration_clientbound {
    tags_count: varint
    tags: {
        tag_type: string
        tags: tags
    }[] count = tags_count
}

packet tags_play_clientbound {
    tags_count: varint
    tags: {
        tag_type: string
        tags: tags
    }[] count = tags_count
