// Shared by: 1.20.6 (protocol 766) to 1.21.1 (protocol 767).
// GENERATED by `bml import-versions` from data/minecraft-data (PrismarineJS/minecraft-data).
// Do not edit: change the importer or schemas/versions/manifest.json and regenerate.

import "../../std/integers.bps"
import "../../std/varint.bps"
import "from_1_13.bps"
import "from_1_14.bps"

encoding container_id = u8

encoding position_update_relatives = {
    raw: u8
    raw_x = (raw & 1) != 0
    raw_y = (raw & 2) != 0
    raw_z = (raw & 4) != 0
    raw_yaw = (raw & 8) != 0
    raw_pitch = (raw & 16) != 0
}

encoding spawn_info = {
    dimension: varint
    name: string
    hashed_seed: i64be
    gamemode: i8
    previous_gamemode: u8
    is_debug: boolean
    is_flat: boolean
    has_death: boolean
    if has_death {
        death: {
            dimension_name: string
            location: position
        }
    }
    portal_cooldown: varint
}

// --- packets ---

packet close_window_play_clientbound {
    window_id: container_id
}

packet close_window_play_serverbound {
    window_id: container_id
}

packet craft_progress_bar {
    window_id: container_id
    property: i16be
    value: i16be
}

packet craft_recipe_response {
    window_id: container_id
    recipe: string
}

packet login {
    entity_id: i32be
    is_hardcore: boolean
    world_names_count: varint
    world_names: string[] count = world_names_count
    max_players: varint
    view_distance: varint
    simulation_distance: varint
    reduced_debug_info: boolean
    enable_respawn_screen: boolean
    do_limited_crafting: boolean
    world_state: spawn_info
    enforces_secure_chat: boolean
}

packet open_horse_window {
    window_id: container_id
    nb_slots: varint
    entity_id: i32be
}

packet position_play_clientbound {
    x: f64be
    y: f64be
    z: f64be
    yaw: f32be
    pitch: f32be
    flags: position_update_relatives
    teleport_id: varint
}

packet respawn {
    world_state: spawn_info
    copy_metadata: u8
}

packet success {
    uuid: uuid
    username: string
    properties_count: varint
    properties: {
        name: string
        value: string
        has_signature: boolean
        if has_signature {
            signature: string
        }
    }[] count = properties_count
    strict_error_handling: boolean
}

