                ticks_in_hive: varint
                min_ticks_in_hive: varint
            }[] count = bees_count
        }    // bees
        83 => item_sound_holder    // break_sound
        87 => {
            entities: id_set
            multiplier: f32be
        }    // mob_visibility
        104 | 105 | 106 => {
            data: {
                id: varint
                if id == 0 {
                    variant_data: string
                }
            }
        }    // chicken/variant, chicken/sound_variant, zombie_nautilus/variant
        109 => {
            data: {
                id: varint
                if id == 0 {
                    data: entity_metadata_painting_variant
                }
            }
        }    // painting/variant
        118 | 119 => {
            messages: anonymous_nbt[] count = 4
            has_filtered_messages: boolean
            match has_filtered_messages {
                1 => {
                    filtered_messages: {
                        filtered_messages: anonymous_nbt[] count = 4
                    }
                }
                _ => { }
            }
            color: varint
            has_glowing_text: boolean
        }    // sign_text_front, sign_text_back
        84 => {
            layers: {
                is_constant: boolean
                value: match is_constant {
                    1 => i32be    // true
                    0 => string    // false
                    _ => { }
                }
            }
        }    // compostable
        85 => {
            burn_time: {
                is_constant: boolean
                value: match is_constant {
                    1 => i32be    // true
                    0 => string    // false
                    _ => { }
                }
            }
            speed_multiplier: {
                is_constant: boolean
                value: match is_constant {
                    1 => f32be    // true
                    0 => string    // false
                    _ => { }
                }
            }
        }    // cooking_fuel
        86 => {
            uses: {
                is_constant: boolean
                value: match is_constant {
                    1 => i32be    // true
                    0 => string    // false
                    _ => { }
                }
            }
            speed_multiplier: {
                is_constant: boolean
                value: match is_constant {
                    1 => f32be    // true
                    0 => string    // false
                    _ => { }
                }
            }
        }    // brewing_fuel
        _ => { }
    }
}

encoding slot_display = {
    type: varint
    data: match type {
        0 | 1 => { }    // empty, any_fuel
        2 => {
            base: slot_display
        }    // with_any_potion
        3 => {
            source: slot_display
            component: slot_component_type
        }    // only_with_component
        4 => varint    // item
        5 => item_stack_template    // item_stack
        6 => id_set    // tag
        7 => {
            dye: slot_display
            target: slot_display
        }    // dyed_slot_demo
        8 => {
            base: slot_display
            material: slot_display
            pattern: {
                id: varint
                if id == 0 {
                    data: armor_trim_pattern
                }
            }
        }    // smithing_trim
        9 => {
            input: slot_display
            remainder: slot_display
        }    // with_remainder
        10 => {
            data_count: varint
            data: slot_display[] count = data_count
        }    // composite
        _ => { }
    }
}

// --- packets ---

packet add_transient_block {
    location: position
    type: varint
}

packet advancements {
    reset: boolean
    advancement_mapping_count: varint
    advancement_mapping: {
        key: string
        value: {
            has_parent_id: boolean
            if has_parent_id {
                parent_id: string
            }
            has_display_data: boolean
            if has_display_data {
                display_data: {
                    title: anonymous_nbt
                    description: anonymous_nbt
                    icon: item_stack_template
                    frame_type: varint
                    flags: u32be
                    flags_unused = flags >> 3
                    flags_hidden = (flags >> 2) & 1
                    flags_show_toast = (flags >> 1) & 1
                    flags_has_background_texture = flags & 1
                    background_texture: match flags_has_background_texture {
                        1 => string    // 1
                        _ => { }
                    }
                }
            }
            requirements_count: varint
            requirements: {
                value_count: varint
                value: string[] count = value_count
            }[] count = requirements_count
            sends_telemtry_data: boolean
        }
        x: f32be
        y: f32be
    }[] count = advancement_mapping_count
    identifiers_count: varint
    identifiers: string[] count = identifiers_count
    progress_mapping_count: varint
    progress_mapping: {
        key: string
        value_count: varint
        value: {
            criterion_identifier: string
            has_criterion_progress: boolean
            if has_criterion_progress {
                criterion_progress: i64be
            }
        }[] count = value_count
    }[] count = progress_mapping_count
    show_advancements: boolean
}

packet craft_recipe_response {
    window_id: container_id
    recipe_display: recipe_display
}

packet declare_commands {
    nodes_count: varint
    nodes: command_node[] count = nodes_count
    root_index: varint
}

packet declare_recipes {
    recipes_count: varint
    recipes: {
        name: string
        items_count: varint
        items: varint[] count = items_count
    }[] count = recipes_count
    stone_cutter_recipes_count: varint
    stone_cutter_recipes: {
        input: id_set
        slot_display: slot_display
    }[] count = stone_cutter_recipes_count
}

packet entity_equipment {
    entity_id: varint
    equipments: entity_equipment_equipments
}

packet entity_look {
    entity_id: varint
    on_ground: boolean
    yaw: i8
    pitch: i8
}

packet entity_metadata {
    entity_id: varint
    metadata: entity_metadata
}

packet entity_move_look {
    entity_id: varint
    move: entity_delta
    yaw: i8
    pitch: i8
}

packet explosion {
    center: vec3f64
    radius: f32be
    block_count: i32be
    has_player_knockback: boolean
    if has_player_knockback {
        player_knockback: vec3f64
    }
    explosion_particle: particle
    sound: item_sound_holder
    block_particles_count: varint
    block_particles: explosion_particle_entry[] count = block_particles_count
    play_sound: boolean
}

packet login {
    entity_id: i32be
    is_hardcore: boolean
    world_names_count: varint
    world_names: string[] count = world_names_count
    max_players: varint
    view_distance: varint
    simulation_distance: varint
    reduced_debug_info: boolean
    enable_respawn_screen: boolean
    do_limited_crafting: boolean
    world_state: spawn_info
    online_mode: boolean
    enforces_secure_chat: boolean
}

packet map_chunk {
    x: i32be
    z: i32be
    heightmaps_count: varint
    heightmaps: {
        type: varint
        data_count: varint
        data: i64be[] count = data_count
    }[] count = heightmaps_count
    chunk_data: byte_array
    block_entities_count: varint
    block_entities: chunk_block_entity[] count = block_entities_count
    sky_light_mask: byte_array
    block_light_mask: byte_array
    empty_sky_light_mask: byte_array
    empty_block_light_mask: byte_array
    sky_light_count: varint
    sky_light: {
        value_count: varint
        value: u8[] count = value_count
    }[] count = sky_light_count
    block_light_count: varint
    block_light: {
        value_count: varint
        value: u8[] count = value_count
    }[] count = block_light_count
}

packet open_sign_entity {
    location: position
    slot: varint
}

packet player_chat {
    global_index: varint
    sender_uuid: uuid
    index: varint
    has_signature: boolean
    match has_signature {
        1 => {
            signature: {
                signature: bytes(256)
            }
        }
        _ => { }
    }
    plain_message: string
    timestamp: i64be
    salt: i64be
    previous_messages: previous_messages
    has_unsigned_chat_content: boolean
    if has_unsigned_chat_content {
        unsigned_chat_content: anonymous_nbt
    }
    filter_type: varint
    filter_type_mask: match filter_type {
        2 => {
            filter_type_mask_len: varint
            filter_type_mask: bytes(filter_type_mask_len)
        }    // 2
        _ => { }
    }
    type: chat_types_holder
    network_name: anonymous_nbt
    has_network_target_name: boolean
    if has_network_target_name {
        network_target_name: anonymous_nbt
    }
}

packet post_effects_configuration_clientbound {
    post_effects_count: varint
    post_effects: string[] count = post_effects_count
}

packet post_effects_play_clientbound {
    post_effects_count: varint
    post_effects: string[] count = post_effects_count
}

packet punch { }

packet recipe_book_add {
    entries_count: varint
    entries: {
        recipe: {
            display_id: varint
            display: recipe_display
            group: optvarint
            category: varint
            has_crafting_requirements: boolean
            if has_crafting_requirements {
                crafting_requirements: {
                    crafting_requirements_count: varint
                    crafting_requirements: id_set[] count = crafting_requirements_count
                }
            }
        }
        flags: u8
        flags_notification = (flags & 1) != 0
        flags_highlight = (flags & 2) != 0
    }[] count = entries_count
    replace: boolean
}

packet rel_entity_move {
    entity_id: varint
    move: entity_delta
}

packet set_cursor_item {
    contents: slot
}

packet set_player_inventory {
    slot_id: varint
    contents: slot
}

packet set_slot {
    window_id: container_id
    state_id: varint
    slot: i16be
    item: slot
}

packet swing_animation {
    entity_id: varint
    hand: varint
    animation_type: varint
    duration: varint
}

packet sync_entity_position {
    entity_id: varint
    position_type: varint
    match position_type {
        0 => {
            x: f64be
            y: f64be
            z: f64be
        }    // linear
        1 => {
            steps_count: varint
            steps: {
                x: f64be
                y: f64be
                z: f64be
                tick_offset: varint
            }[] count = steps_count
        }    // stepped
        _ => { }
    }
    yaw: f32be
    pitch: f32be
    on_ground: boolean
}

packet teleport_confirm {
    teleport_id: varint
    x: f64be
    y: f64be
    z: f64be
    y_rot: f32be
    x_rot: f32be
}

packet trade_list {
    window_id: container_id
    trades_count: varint
    trades: {
        input_item1: {
            item_id: varint
            item_count: varint
            components: exact_component_matcher
        }
        output_item: slot
        has_input_item2: boolean
        if has_input_item2 {
            input_item2: {
                item_id: varint
                item_count: varint
                components: exact_component_matcher
            }
        }
        trade_disabled: boolean
        nb_trade_uses: i32be
        maximum_nb_trade_uses: i32be
        xp: i32be
        special_price: i32be
        price_multiplier: f32be
        demand: i32be
    }[] count = trades_count
    villager_level: varint
    experience: varint
    is_regular_villager: boolean
    can_restock: boolean
}

packet update_light {
    chunk_x: varint
    chunk_z: varint
    sky_light_mask: byte_array
    block_light_mask: byte_array
    empty_sky_light_mask: byte_array
    empty_block_light_mask: byte_array
    sky_light_count: varint
    sky_light: {
        value_count: varint
        value: u8[] count = value_count
    }[] count = sky_light_count
    block_light_count: varint
    block_light: {
        value_count: varint
        value: u8[] count = value_count
    }[] count = block_light_count
}

packet update_sign {
    location: position
    text1: string
    text2: string
    text3: string
    text4: string
    slot: varint
}

packet window_items {
    window_id: container_id
    state_id: varint
    items_count: varint
    items: slot[] count = items_count
    carried_item: slot
}

packet world_particles {
    particle: particle
    long_distance: boolean
    always_show: boolean
    x: f64be
    y: f64be
    z: f64be
    offset_x: f32be
    offset_y: f32be
    offset_z: f32be
    x_max_speed: f32be
    y_max_speed: f32be
    z_max_speed: f32be
    amount: varint
    randomization_type: varint
}

