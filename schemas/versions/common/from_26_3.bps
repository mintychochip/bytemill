// protodef `entityDelta` (26.3 `VecDelta`): `properties` is the on-ground bit plus the step
// count shifted left once. No steps is one linear delta; otherwise each step is a tick offset
// and a delta.
encoding entity_delta = {
    properties: varint
    if (properties >> 1) == 0 {
        delta_x: i16be
        delta_y: i16be
        delta_z: i16be
    }
    if (properties >> 1) > 0 {
        steps: {
            tick_offset: varint
            delta_x: i16be
            delta_y: i16be
            delta_z: i16be
        }[] count = (properties >> 1)
    }
}

encoding entity_equipment_equipments = {
    slot_byte: u8
    slot = slot_byte & 127
    item: slot
    if (slot_byte & 128) != 0 {
        next: entity_equipment_equipments
    }
}

