packet login {
    entity_id: i32be
    game_mode: u8
    previous_game_mode: u8
    world_names_count: varint
    world_names: string[] count = world_names_count
    dimension_codec: nbt
    dimension: string
    world_name: string
    hashed_seed: i64be
    max_players: u8
    view_distance: varint
    reduced_debug_info: boolean
    enable_respawn_screen: boolean
    is_debug: boolean
    is_flat: boolean
}

packet map_chunk {
    x: i32be
    z: i32be
    ground_up: boolean
    ignore_old_data: boolean
    bit_map: varint
    heightmaps: nbt
    biomes: match ground_up {
        0 => { }    // false
        1 => {
            biomes: i32be[] count = 1024
        }    // true
        _ => { }
    }
    chunk_data_len: varint
    chunk_data: bytes(chunk_data_len)
    block_entities_count: varint
    block_entities: nbt[] count = block_entities_count
}

packet respawn {
    dimension: string
    world_name: string
    hashed_seed: i64be
    gamemode: u8
    previous_gamemode: u8
    is_debug: boolean
    is_flat: boolean
    copy_metadata: boolean
}

