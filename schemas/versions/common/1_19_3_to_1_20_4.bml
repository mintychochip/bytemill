import "../../std/integers.bml"
import "../../std/varint.bml"
import "from_1_13.bml"
import "from_1_19_3.bml"

packet chat_command {
    command: string
    timestamp: i64be
    salt: i64be
    argument_signatures_count: varint
    argument_signatures: {
        argument_name: string
        signature: bytes(256)
    }[] count = argument_signatures_count
    message_count: varint
    acknowledged: bytes(3)
}

packet chat_session_update {
    session_uuid: uuid
    expire_time: i64be
    public_key_len: varint
    public_key: bytes(public_key_len)
    signature_len: varint
    signature: bytes(signature_len)
}

packet entity_sound_effect {
    sound_id: varint
    sound_event: match sound_id {
        0 => {
            resource: string
            has_range: boolean
            if has_range {
                range: f32be
            }
        }    // 0
        _ => { }
    }
    sound_category: sound_source
    entity_id: varint
    volume: f32be
    pitch: f32be
    seed: i64be
}

