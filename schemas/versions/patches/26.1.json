    {
      "reason": "move_minecart: vanilla 26.1 NewMinecartBehavior.MinecartStep writes position and movement as Vec3 (three doubles each) and both rotations as ROTATION_BYTE; the description has floats (net/minecraft/world/entity/vehicle/minecart/NewMinecartBehavior.java)",
      "scope": "play.toClient",
      "types": {
        "packet_move_minecart": [
          "container",
          [
            {
              "name": "entityId",
              "type": "varint"
            },
            {
              "name": "steps",
              "type": [
                "array",
                {
                  "countType": "varint",
                  "type": [
                    "container",
                    [
                      {
                        "name": "position",
                        "type": "vec3f64"
                      },
                      {
                        "name": "velocity",
                        "type": "vec3f64"
                      },
                      {
                        "name": "yaw",
                        "type": "i8"
                      },
                      {
                        "name": "pitch",
                        "type": "i8"
                      },
                      {
                        "name": "weight",
                        "type": "f32"
                      }
                    ]
                  ]
                }
              ]
            }
          ]
        ]
      }
    },
