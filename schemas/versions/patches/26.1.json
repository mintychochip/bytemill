                              "true": "bool"
                            },
                            "default": "void"
                          }
                        ]
                      },
                      {
                        "name": "latency",
                        "type": [
                          "switch",
                          {
                            "compareTo": "../action/update_latency",
                            "fields": {
                              "true": "varint"
                            },
                            "default": "void"
                          }
