    y: i32be
    z: i32be
    volume: f32be
    pitch: f32be
    seed: i64be
}

packet start_configuration { }

packet stop_sound {
    flags: i8
    source: match flags {
        1 | 3 => varint    // 1, 3
        _ => { }
    }
    sound: match flags {
        2 | 3 => string    // 2, 3
        _ => { }
    }
}

packet store_cookie_play_clientbound {
    key: string
    value: byte_array
}

packet system_chat {
    content: anonymous_nbt
