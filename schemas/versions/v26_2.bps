    route configuration.clientbound 0x0f => custom_report_details_configuration_clientbound
    route configuration.clientbound 0x10 => server_links_configuration_clientbound
    route configuration.clientbound 0x11 => clear_dialog_configuration_clientbound
    route configuration.clientbound 0x12 => show_dialog_configuration_clientbound
    route configuration.clientbound 0x13 => code_of_conduct
    route configuration.serverbound 0x00 => settings_configuration_serverbound
