packet teams {
    team: string
    mode: i8
    match mode {
        0 | 2 => {
            name: anonymous_nbt
            prefix: anonymous_nbt
            suffix: anonymous_nbt
            name_tag_visibility: varint
            collision_rule: varint
            has_formatting: boolean
            if has_formatting {
                formatting: varint
            }
            flags: u8
            flags_friendly_fire = (flags & 1) != 0
            flags_see_friendly_invisible = (flags & 2) != 0
        }    // add, change
        _ => { }
    }
    players: match mode {
        0 | 3 | 4 => {
            players_count: varint
            players: string[] count = players_count
        }    // add, join, leave
        _ => { }
    }
}

packet scoreboard_score {
    item_name: string
    score_name: string
    value: varint
    has_display_name: boolean
    if has_display_name {
        display_name: anonymous_nbt
    }
    has_number_format: boolean
    if has_number_format {
        number_format: varint
    }
    styling: match has_number_format ? number_format : -1 {
        1 | 2 => anonymous_nbt    // 1, 2
        _ => { }
    }
}

packet simulation_distance {
    distance: varint
}

packet set_title_subtitle {
    text: anonymous_nbt
}

packet update_time {
    age: i64be
    clock_updates_count: varint
    clock_updates: {
        id: varint
        total_ticks: varlong
        partial_tick: f32be
        rate: f32be
    }[] count = clock_updates_count
}

packet set_title_text {
    text: anonymous_nbt
}

packet set_title_time {
    fade_in: i32be
    stay: i32be
    fade_out: i32be
}

packet entity_sound_effect {
