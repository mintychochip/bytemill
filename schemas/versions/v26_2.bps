    argument_signatures: {
        argument_name: string
        signature: bytes(256)
    }[] count = argument_signatures_count
    message_count: varint
    acknowledged: bytes(3)
    checksum: u8
}

packet chat_message {
    message: string
    timestamp: i64be
    salt: i64be
    has_signature: boolean
    match has_signature {
        1 => {
            signature: {
                signature: bytes(256)
            }
        }
        _ => { }
    }
    offset: varint
    acknowledged: bytes(3)
    checksum: u8
}

