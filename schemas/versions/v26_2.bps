    is_frozen: boolean
}

packet step_tick {
    tick_steps: varint
}

packet transfer_play_clientbound {
    host: string
    port: varint
}

packet advancements {
    reset: boolean
    advancement_mapping_count: varint
    advancement_mapping: {
        key: string
        value: {
            has_parent_id: boolean
            if has_parent_id {
                parent_id: string
            }
            has_display_data: boolean
            if has_display_data {
                display_data: {
                    title: anonymous_nbt
                    description: anonymous_nbt
                    icon: item_stack_template
                    frame_type: varint
                    flags: u32be
                    flags_unused = flags >> 3
                    flags_hidden = (flags >> 2) & 1
                    flags_show_toast = (flags >> 1) & 1
                    flags_has_background_texture = flags & 1
                    background_texture: match flags_has_background_texture {
                        1 => string    // 1
                        _ => { }
                    }
                    x_cord: f32be
                    y_cord: f32be
                }
            }
            requirements_count: varint
            requirements: {
                value_count: varint
                value: string[] count = value_count
            }[] count = requirements_count
            sends_telemtry_data: boolean
        }
    }[] count = advancement_mapping_count
    identifiers_count: varint
    identifiers: string[] count = identifiers_count
    progress_mapping_count: varint
    progress_mapping: {
        key: string
        value_count: varint
        value: {
            criterion_identifier: string
            has_criterion_progress: boolean
            if has_criterion_progress {
                criterion_progress: i64be
            }
        }[] count = value_count
    }[] count = progress_mapping_count
    show_advancements: boolean
}

packet entity_update_attributes {
    entity_id: varint
    properties_count: varint
    properties: {
        key: varint
        value: f64be
        modifiers_count: varint
        modifiers: {
            uuid: string
            amount: f64be
            operation: i8
        }[] count = modifiers_count
    }[] count = properties_count
}

packet entity_effect {
    entity_id: varint
    effect_id: varint
    amplifier: varint
    duration: varint
    flags: u8
}

packet declare_recipes {
    recipes_count: varint
    recipes: {
        name: string
        items_count: varint
        items: varint[] count = items_count
    }[] count = recipes_count
    stone_cutter_recipes_count: varint
    stone_cutter_recipes: {
        input: id_set
        slot_display: slot_display
    }[] count = stone_cutter_recipes_count
}

packet tags_play_clientbound {
    tags_count: varint
    tags: {
        tag_type: string
        tags: tags
    }[] count = tags_count
}

packet set_projectile_power {
    id: varint
    acceleration_power: f64be
}

packet custom_report_details_play_clientbound {
    details_count: varint
    details: {
        key: string
        value: string
    }[] count = details_count
}

packet server_links_play_clientbound {
    links_count: varint
    links: {
        has_known_type: boolean
        known_type: match has_known_type {
            1 => server_link_type    // true
            _ => { }
        }
        unknown_type: match has_known_type {
            0 => anonymous_nbt    // false
            _ => { }
        }
        link: string
    }[] count = links_count
}

packet tracked_waypoint {
    operation: varint
    waypoint: {
        has_uuid: boolean
        match has_uuid {
            1 => {
                uuid: uuid
            }    // true
            0 => {
                id: string
            }    // false
            _ => { }
        }
        icon: {
            style: string
            has_color: boolean
            if has_color {
                color: {
                    red: u8
                    green: u8
                    blue: u8
                }
            }
        }
        type: varint
        data: match type {
            1 => vec3i    // vec3i
            2 => {
                chunk_x: varint
                chunk_z: varint
            }    // chunk
            3 => f32be    // azimuth
            _ => { }
        }
    }
}

packet clear_dialog_play_clientbound { }

