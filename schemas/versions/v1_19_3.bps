                key_bytes: bytes(key_bytes_len)
                key_signature_len: varint
                key_signature: bytes(key_signature_len)
            }
        }
    }
}

encoding chunk_block_entity = {
    bits: u8
    x = bits >> 4
    z = bits & 15
    y: i16be
    type: varint
    nbt_data: optional_nbt
}

encoding command_node = {
    flags: u8
