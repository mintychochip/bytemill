}

encoding entity_metadata = {
    value: {
        key: u8
        type: varint
        value: match type {
            0 => i8    // 0
            1 | 12 | 14 | 19 | 20 | 21 | 23 => varint    // 1, 12, 14, 19, 20, 21, 23
