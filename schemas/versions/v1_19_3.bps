protocol minecraft @ v1_19_3 {
    id = 761
    frame default {
        length: varint
        id: varint
        payload: rest
    }

    route handshaking.serverbound 0x00 => set_protocol
    route handshaking.serverbound 0xfe => legacy_server_list_ping
    route login.clientbound 0x00 => disconnect
    route login.clientbound 0x01 => encryption_begin_login_clientbound
    route login.clientbound 0x02 => success
    route login.clientbound 0x03 => compress
    route login.clientbound 0x04 => login_plugin_request
    route login.serverbound 0x00 => login_start
    route login.serverbound 0x01 => encryption_begin_login_serverbound
    route login.serverbound 0x02 => login_plugin_response
    route play.clientbound 0x00 => spawn_entity
    route play.clientbound 0x01 => spawn_entity_experience_orb
    route play.clientbound 0x02 => named_entity_spawn
    route play.clientbound 0x03 => animation
    route play.clientbound 0x04 => statistics
    route play.clientbound 0x05 => acknowledge_player_digging
    route play.clientbound 0x06 => block_break_animation
    route play.clientbound 0x07 => tile_entity_data
    route play.clientbound 0x08 => block_action
    route play.clientbound 0x09 => block_change
    route play.clientbound 0x0a => boss_bar
    route play.clientbound 0x0b => difficulty
    route play.clientbound 0x0c => clear_titles
    route play.clientbound 0x0d => tab_complete_play_clientbound
    route play.clientbound 0x0e => declare_commands
    route play.clientbound 0x0f => close_window_play_clientbound
    route play.clientbound 0x10 => window_items
    route play.clientbound 0x11 => craft_progress_bar
    route play.clientbound 0x12 => set_slot
    route play.clientbound 0x13 => set_cooldown
    route play.clientbound 0x14 => chat_suggestions
    route play.clientbound 0x15 => custom_payload_play_clientbound
    route play.clientbound 0x16 => hide_message
    route play.clientbound 0x17 => kick_disconnect
    route play.clientbound 0x18 => profileless_chat
    route play.clientbound 0x19 => entity_status
    route play.clientbound 0x1a => explosion
    route play.clientbound 0x1b => unload_chunk
    route play.clientbound 0x1c => game_state_change
    route play.clientbound 0x1d => open_horse_window
    route play.clientbound 0x1e => initialize_world_border
    route play.clientbound 0x1f => keep_alive_play_clientbound
    route play.clientbound 0x20 => map_chunk
    route play.clientbound 0x21 => world_event
    route play.clientbound 0x22 => world_particles
    route play.clientbound 0x23 => update_light
    route play.clientbound 0x24 => login
    route play.clientbound 0x25 => map
    route play.clientbound 0x26 => trade_list
    route play.clientbound 0x27 => rel_entity_move
    route play.clientbound 0x28 => entity_move_look
    route play.clientbound 0x29 => entity_look
