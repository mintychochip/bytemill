// Minecraft Java Edition 1.13.2 (protocol 404).
// GENERATED by `bpsc import-versions` from data/minecraft-data/pc/1.13.2/protocol.json (PrismarineJS/minecraft-data).
// Do not edit: change the importer or schemas/versions/manifest.json and regenerate.

import "../std/integers.bps"
import "../std/varint.bps"

// 128-bit UUID, big endian.
encoding uuid = {
    msb: u64be
    lsb: u64be
}

// --- NBT (prismarine-nbt "big"): shared bodies ---

encoding nbt_nothing = { }

encoding nbt_string = {
    byte_len: u16be
    value:    bytes(byte_len) as utf8
}

encoding nbt_byte_array = {
    byte_len: i32be
    data:     bytes(byte_len)
}

encoding nbt_int_array = {
    count: i32be
    data:  bytes(count * 4)
}

encoding nbt_long_array = {
    count: i32be
    data:  bytes(count * 8)
}

// A compound entry: tag type, name, payload. TAG_End (0) ends a compound before this is read.
encoding nbt_entry = {
    tag_type: u8
    name:     nbt_string
    ...nbt_payload
}

encoding nbt_compound_body = {
    entries: nbt_entry[] until 0x00
}

// A list: element type, count, then count payloads without type bytes.
encoding nbt_list_body = {
    elem_type: u8
    count:     i32be
    items: { v: match elem_type {
        0  => nbt_nothing
        1  => i8
        2  => i16be
        3  => i32be
        4  => i64be
        5  => f32be
        6  => f64be
        7  => nbt_byte_array
        8  => nbt_string
        9  => nbt_list_body
        10 => nbt_compound_body
        11 => nbt_int_array
        12 => nbt_long_array
    } }[] count = count
}

// The payload of the tag whose type is the enclosing block's `tag_type`.
encoding nbt_payload = {
    value: match tag_type {
        0  => nbt_nothing
        1  => i8
        2  => i16be
        3  => i32be
        4  => i64be
        5  => f32be
        6  => f64be
        7  => nbt_byte_array
        8  => nbt_string
        9  => nbt_list_body
        10 => nbt_compound_body
        11 => nbt_int_array
        12 => nbt_long_array
    }
}

// protodef `nbt`: root tag type, root name (read even for TAG_End), payload.
encoding nbt = {
    tag_type: u8
    name:     nbt_string
    ...nbt_payload
}

// protodef `optionalNbt`: a first byte of 0 is the whole value; otherwise a named root.
encoding optional_nbt = {
    tag_type: u8
    if tag_type != 0 {
        name: nbt_string
    }
    ...nbt_payload
}

// --- named types ---

encoding command_node = {
    flags: u8
    flags_unused = flags >> 5
    flags_has_custom_suggestions = (flags >> 4) & 1
    flags_has_redirect_node = (flags >> 3) & 1
    flags_has_command = (flags >> 2) & 1
    flags_command_node_type = flags & 3
    children_count: varint
    children: varint[] count = children_count
    redirect_node: match flags_has_redirect_node {
        1 => varint    // 1
        _ => { }
    }
    extra_node_data: match flags_command_node_type {
        0 => { }    // 0
        1 => {
            name: string
        }    // 1
        2 => {
            name: string
            parser: string
            properties: {
                if parser == "brigadier:float" {
                    flags: u8
                    flags_unused = flags >> 2
                    flags_max_present = (flags >> 1) & 1
                    flags_min_present = flags & 1
                    min: match flags_min_present {
                        1 => f32be    // 1
                        _ => { }
                    }
                    max: match flags_max_present {
                        1 => f32be    // 1
                        _ => { }
                    }
                }
                if parser == "brigadier:double" {
                    flags_2: u8
                    flags_unused_2 = flags_2 >> 2
                    flags_max_present_2 = (flags_2 >> 1) & 1
                    flags_min_present_2 = flags_2 & 1
                    min_2: match flags_min_present_2 {
                        1 => f64be    // 1
                        _ => { }
                    }
                    max_2: match flags_max_present_2 {
                        1 => f64be    // 1
                        _ => { }
                    }
                }
                if parser == "brigadier:integer" {
                    flags_3: u8
                    flags_unused_3 = flags_3 >> 2
                    flags_max_present_3 = (flags_3 >> 1) & 1
                    flags_min_present_3 = flags_3 & 1
                    min_3: match flags_min_present_3 {
                        1 => i32be    // 1
                        _ => { }
                    }
                    max_3: match flags_max_present_3 {
                        1 => i32be    // 1
                        _ => { }
                    }
                }
                if parser == "brigadier:long" {
                    flags_4: u8
                    flags_unused_4 = flags_4 >> 2
                    flags_max_present_4 = (flags_4 >> 1) & 1
                    flags_min_present_4 = flags_4 & 1
                    min_4: match flags_min_present_4 {
                        1 => i64be    // 1
                        _ => { }
                    }
                    max_4: match flags_max_present_4 {
                        1 => i64be    // 1
                        _ => { }
                    }
                }
                if parser == "brigadier:string" {
                    value: varint
                }
                if parser == "minecraft:entity" {
                    value: {
                        value: u8
                        value_unused = value >> 2
                        value_only_allow_players = (value >> 1) & 1
                        value_only_allow_entities = value & 1
                    }
                }
                if parser == "minecraft:score_holder" {
                    value: {
                        value: u8
                        value_unused = value >> 1
                        value_allow_multiple = value & 1
                    }
                }
                if parser == "minecraft:range" {
                    allow_decimals: boolean
                }
                if (parser == "minecraft:resource_or_tag") || (parser == "minecraft:resource") {
                    registry: string
                }
            }
            suggestion_type: match flags_has_custom_suggestions {
                1 => string    // 1
                _ => { }
            }
        }    // 2
        _ => { }
    }
}

encoding entity_metadata = {
    value: {
        key: u8
        type: varint
        value: match type {
            0 => i8    // 0
            1 | 11 | 13 => varint    // 1, 11, 13
            2 => f32be    // 2
            3 | 4 => string    // 3, 4
            5 => {
                has_value: boolean
                if has_value {
                    value: string
                }
            }    // 5
            6 => slot    // 6
            7 => boolean    // 7
            8 => {
                pitch: f32be
                yaw: f32be
                roll: f32be
            }    // 8
            9 => position    // 9
            10 => {
                has_value: boolean
                if has_value {
                    value: position
                }
            }    // 10
            12 => {
                has_value: boolean
                if has_value {
                    value: uuid
                }
            }    // 12
            14 => nbt    // 14
            15 => particle    // 15
            _ => { }
        }
    }[] until 0xff
}

encoding ingredient = {
    value_count: varint
    value: slot[] count = value_count
}

encoding particle = {
    particle_id: varint
    data: match particle_id {
        3 | 20 => {
            block_state: varint
        }    // 3, 20
        11 => {
            red: f32be
            green: f32be
            blue: f32be
            scale: f32be
        }    // 11
        27 => {
            item: slot
        }    // 27
        _ => { }
    }
}

encoding position = {
    raw: u64be
    x = sign_extend(raw >> 38, 26)
    y = sign_extend((raw >> 26) & 4095, 12)
    z = sign_extend(raw & 67108863, 26)
}

encoding slot = {
    present: boolean
    match present {
        0 => { }    // false
        1 => {
            item_id: varint
            item_count: i8
            nbt_data: optional_nbt
        }    // true
        _ => { }
    }
}

encoding string = {
    byte_len: varint
    value: bytes(byte_len) as utf8
}

encoding tags = {
    value_count: varint
    value: {
        tag_name: string
        entries_count: varint
        entries: varint[] count = entries_count
    }[] count = value_count
}

encoding vec3i16 = {
    x: i16be
    y: i16be
    z: i16be
}

