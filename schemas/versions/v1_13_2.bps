                }[] count = properties_count
                gamemode: varint
                ping: varint
                has_display_name: boolean
                if has_display_name {
                    display_name: string
                }
            }    // add_player
            1 => {
                gamemode_2: varint
            }    // update_game_mode
            2 => {
                ping_2: varint
            }    // update_latency
            3 => {
                has_display_name_2: boolean
                if has_display_name_2 {
                    display_name_2: string
                }
            }    // update_display_name
            4 => { }    // remove_player
            _ => { }
        }
    }[] count = data_count
}

