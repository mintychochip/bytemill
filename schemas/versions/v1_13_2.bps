packet title {
    action: varint
    text: match action {
        0 | 1 | 2 => string    // 0, 1, 2
        _ => { }
    }
    fade_in: match action {
        3 => i32be    // 3
        _ => { }
    }
    stay: match action {
        3 => i32be    // 3
        _ => { }
    }
    fade_out: match action {
        3 => i32be    // 3
        _ => { }
    }
}

packet stop_sound {
    flags: i8
    source: match flags {
        1 | 3 => varint    // 1, 3
        _ => { }
    }
    sound: match flags {
        2 | 3 => string    // 2, 3
        _ => { }
    }
}

packet sound_effect {
    sound_id: varint
    sound_category: varint
    x: i32be
    y: i32be
    z: i32be
    volume: f32be
    pitch: f32be
}

packet playerlist_header {
    header: string
    footer: string
}

packet collect {
    collected_entity_id: varint
    collector_entity_id: varint
    pickup_item_count: varint
}

packet entity_teleport {
    entity_id: varint
    x: f64be
    y: f64be
    z: f64be
    yaw: i8
    pitch: i8
    on_ground: boolean
}

packet advancements {
    reset: boolean
    advancement_mapping_count: varint
    advancement_mapping: {
        key: string
        value: {
            has_parent_id: boolean
            if has_parent_id {
                parent_id: string
            }
            has_display_data: boolean
            if has_display_data {
                display_data: {
                    title: string
                    description: string
                    icon: slot
                    frame_type: varint
                    flags: u32be
                    flags_unused = flags >> 3
                    flags_hidden = (flags >> 2) & 1
                    flags_show_toast = (flags >> 1) & 1
                    flags_has_background_texture = flags & 1
                    background_texture: match flags_has_background_texture {
                        1 => string    // 1
                        _ => { }
                    }
                    x_cord: f32be
                    y_cord: f32be
                }
            }
            criteria_count: varint
            criteria: {
                key: string
            }[] count = criteria_count
            requirements_count: varint
            requirements: {
                value_count: varint
                value: string[] count = value_count
            }[] count = requirements_count
        }
    }[] count = advancement_mapping_count
    identifiers_count: varint
    identifiers: string[] count = identifiers_count
    progress_mapping_count: varint
    progress_mapping: {
        key: string
        value_count: varint
        value: {
            criterion_identifier: string
            has_criterion_progress: boolean
            if has_criterion_progress {
                criterion_progress: i64be
            }
        }[] count = value_count
    }[] count = progress_mapping_count
}

packet entity_update_attributes {
    entity_id: varint
    properties_count: i32be
    properties: {
        key: string
        value: f64be
        modifiers_count: varint
        modifiers: {
            uuid: uuid
            amount: f64be
            operation: i8
        }[] count = modifiers_count
    }[] count = properties_count
}

packet entity_effect {
    entity_id: varint
    effect_id: i8
    amplifier: i8
    duration: varint
    hide_particles: i8
}

packet declare_recipes {
    recipes_count: varint
    recipes: {
        recipe_id: string
        type: string
        data: {
            if type == "crafting_shapeless" {
                group: string
                ingredients_count: varint
                ingredients: ingredient[] count = ingredients_count
                result: slot
            }
            if type == "crafting_shaped" {
                width: varint
                height: varint
                group_2: string
                ingredients_2: {
                    value: ingredient[] count = height
                }[] count = width
                result_2: slot
            }
            if type == "smelting" {
                group_3: string
                ingredient: ingredient
                result_3: slot
                experience: f32be
                cook_time: varint
            }
        }
    }[] count = recipes_count
}

packet tags {
    block_tags: tags
    item_tags: tags
    fluid_tags: tags
}

packet teleport_confirm {
    teleport_id: varint
}

packet query_block_nbt {
    transaction_id: varint
    location: position
}

packet chat_play_serverbound {
    message: string
}

packet client_command {
    action_id: varint
}

packet settings {
    locale: string
    view_distance: i8
    chat_flags: varint
    chat_colors: boolean
    skin_parts: u8
    main_hand: varint
}

packet tab_complete_play_serverbound {
    transaction_id: varint
    text: string
}

packet transaction_play_serverbound {
    window_id: i8
    action: i16be
    accepted: boolean
}

packet enchant_item {
    window_id: i8
    enchantment: i8
}

packet window_click {
    window_id: u8
    slot: i16be
    mouse_button: i8
    action: i16be
    mode: i8
    item: slot
}

packet close_window_play_serverbound {
    window_id: u8
}

packet custom_payload_play_serverbound {
    channel: string
    data: rest
}

packet edit_book {
    new_book: slot
    signing: boolean
    hand: varint
}

packet query_entity_nbt {
    transaction_id: varint
    entity_id: varint
}

packet use_entity {
    target: varint
    mouse: varint
    x: match mouse {
        2 => f32be    // 2
        _ => { }
    }
    y: match mouse {
        2 => f32be    // 2
        _ => { }
    }
    z: match mouse {
        2 => f32be    // 2
        _ => { }
    }
    hand: match mouse {
        0 | 2 => varint    // 0, 2
        _ => { }
    }
}

packet keep_alive_play_serverbound {
    keep_alive_id: i64be
}

packet flying {
    on_ground: boolean
}

packet position_play_serverbound {
    x: f64be
    y: f64be
    z: f64be
    on_ground: boolean
}

packet position_look {
    x: f64be
    y: f64be
    z: f64be
    yaw: f32be
    pitch: f32be
    on_ground: boolean
}

packet look {
    yaw: f32be
    pitch: f32be
    on_ground: boolean
}

packet vehicle_move_play_serverbound {
    x: f64be
    y: f64be
    z: f64be
    yaw: f32be
    pitch: f32be
}

packet steer_boat {
    left_paddle: boolean
    right_paddle: boolean
}

packet pick_item {
    slot: varint
}

packet craft_recipe_request {
    window_id: i8
    recipe: string
    make_all: boolean
}

packet abilities_play_serverbound {
    flags: i8
    flying_speed: f32be
    walking_speed: f32be
}

packet block_dig {
    status: varint
    location: position
    face: i8
}

packet entity_action {
    entity_id: varint
    action_id: varint
    jump_boost: varint
}

packet steer_vehicle {
    sideways: f32be
    forward: f32be
    jump: u8
}

packet crafting_book_data {
    type: varint
    match type {
        0 => {
            displayed_recipe: string
        }    // 0
        1 => {
            crafting_book_open: boolean
            crafting_filter: boolean
            smelting_book_open: boolean
            smelting_filter: boolean
        }    // 1
        _ => { }
    }
}

packet name_item {
    name: string
}

packet resource_pack_receive {
    result: varint
}

packet advancement_tab {
    action: varint
    tab_id: match action {
        0 => string    // 0
        1 => { }    // 1
        _ => { }
    }
}

packet select_trade {
    slot: varint
}

packet set_beacon_effect {
    primary_effect: varint
    secondary_effect: varint
}

packet held_item_slot_play_serverbound {
    slot_id: i16be
}

packet update_command_block {
    location: position
    command: string
    mode: varint
    flags: u8
}

packet update_command_block_minecart {
    entity_id: varint
    command: string
    track_output: boolean
}

packet set_creative_slot {
    slot: i16be
    item: slot
}

packet update_structure_block {
    location: position
    action: varint
    mode: varint
    name: string
    offset_x: i8
    offset_y: i8
    offset_z: i8
    size_x: i8
    size_y: i8
    size_z: i8
    mirror: varint
    rotation: varint
    metadata: string
    integrity: f32be
    seed: varlong
    flags: u8
}

packet update_sign {
    location: position
    text1: string
    text2: string
    text3: string
    text4: string
}

packet arm_animation {
    hand: varint
}

packet spectate {
    target: uuid
}

packet block_place {
    location: position
    direction: varint
    hand: varint
    cursor_x: f32be
    cursor_y: f32be
    cursor_z: f32be
}

packet use_item {
    hand: varint
}

packet server_info {
    response: string
}

packet ping_status_clientbound {
    time: i64be
}

packet ping_start { }

packet ping_status_serverbound {
    time: i64be
}

protocol minecraft @ v1_13_2 {
    id = 404
    frame default {
        length: varint
        id: varint
        payload: rest
    }

    route handshaking.serverbound 0x00 => set_protocol
    route handshaking.serverbound 0xfe => legacy_server_list_ping
    route login.clientbound 0x00 => disconnect
    route login.clientbound 0x01 => encryption_begin_login_clientbound
    route login.clientbound 0x02 => success
    route login.clientbound 0x03 => compress
    route login.clientbound 0x04 => login_plugin_request
    route login.serverbound 0x00 => login_start
    route login.serverbound 0x01 => encryption_begin_login_serverbound
    route login.serverbound 0x02 => login_plugin_response
    route play.clientbound 0x00 => spawn_entity
    route play.clientbound 0x01 => spawn_entity_experience_orb
    route play.clientbound 0x02 => spawn_entity_weather
    route play.clientbound 0x03 => spawn_entity_living
    route play.clientbound 0x04 => spawn_entity_painting
    route play.clientbound 0x05 => named_entity_spawn
    route play.clientbound 0x06 => animation
    route play.clientbound 0x07 => statistics
    route play.clientbound 0x08 => block_break_animation
    route play.clientbound 0x09 => tile_entity_data
    route play.clientbound 0x0a => block_action
    route play.clientbound 0x0b => block_change
    route play.clientbound 0x0c => boss_bar
    route play.clientbound 0x0d => difficulty
    route play.clientbound 0x0e => chat_play_clientbound
    route play.clientbound 0x0f => multi_block_change
    route play.clientbound 0x10 => tab_complete_play_clientbound
    route play.clientbound 0x11 => declare_commands
    route play.clientbound 0x12 => transaction_play_clientbound
    route play.clientbound 0x13 => close_window_play_clientbound
    route play.clientbound 0x14 => open_window
    route play.clientbound 0x15 => window_items
    route play.clientbound 0x16 => craft_progress_bar
    route play.clientbound 0x17 => set_slot
    route play.clientbound 0x18 => set_cooldown
    route play.clientbound 0x19 => custom_payload_play_clientbound
    route play.clientbound 0x1a => named_sound_effect
    route play.clientbound 0x1b => kick_disconnect
    route play.clientbound 0x1c => entity_status
    route play.clientbound 0x1d => nbt_query_response
    route play.clientbound 0x1e => explosion
    route play.clientbound 0x1f => unload_chunk
    route play.clientbound 0x20 => game_state_change
    route play.clientbound 0x21 => keep_alive_play_clientbound
    route play.clientbound 0x22 => map_chunk
    route play.clientbound 0x23 => world_event
    route play.clientbound 0x24 => world_particles
    route play.clientbound 0x25 => login
    route play.clientbound 0x26 => map
    route play.clientbound 0x27 => entity
    route play.clientbound 0x28 => rel_entity_move
    route play.clientbound 0x29 => entity_move_look
    route play.clientbound 0x2a => entity_look
    route play.clientbound 0x2b => vehicle_move_play_clientbound
    route play.clientbound 0x2c => open_sign_entity
    route play.clientbound 0x2d => craft_recipe_response
    route play.clientbound 0x2e => abilities_play_clientbound
    route play.clientbound 0x2f => combat_event
    route play.clientbound 0x30 => player_info
    route play.clientbound 0x31 => face_player
    route play.clientbound 0x32 => position_play_clientbound
    route play.clientbound 0x33 => bed
    route play.clientbound 0x34 => unlock_recipes
    route play.clientbound 0x35 => entity_destroy
    route play.clientbound 0x36 => remove_entity_effect
    route play.clientbound 0x37 => resource_pack_send
    route play.clientbound 0x38 => respawn
    route play.clientbound 0x39 => entity_head_rotation
    route play.clientbound 0x3a => select_advancement_tab
    route play.clientbound 0x3b => world_border
    route play.clientbound 0x3c => camera
    route play.clientbound 0x3d => held_item_slot_play_clientbound
    route play.clientbound 0x3e => scoreboard_display_objective
    route play.clientbound 0x3f => entity_metadata
    route play.clientbound 0x40 => attach_entity
    route play.clientbound 0x41 => entity_velocity
    route play.clientbound 0x42 => entity_equipment
    route play.clientbound 0x43 => experience
    route play.clientbound 0x44 => update_health
    route play.clientbound 0x45 => scoreboard_objective
    route play.clientbound 0x46 => set_passengers
    route play.clientbound 0x47 => teams
    route play.clientbound 0x48 => scoreboard_score
    route play.clientbound 0x49 => spawn_position
    route play.clientbound 0x4a => update_time
    route play.clientbound 0x4b => title
    route play.clientbound 0x4c => stop_sound
    route play.clientbound 0x4d => sound_effect
    route play.clientbound 0x4e => playerlist_header
    route play.clientbound 0x4f => collect
    route play.clientbound 0x50 => entity_teleport
    route play.clientbound 0x51 => advancements
    route play.clientbound 0x52 => entity_update_attributes
    route play.clientbound 0x53 => entity_effect
    route play.clientbound 0x54 => declare_recipes
    route play.clientbound 0x55 => tags
    route play.serverbound 0x00 => teleport_confirm
    route play.serverbound 0x01 => query_block_nbt
    route play.serverbound 0x02 => chat_play_serverbound
    route play.serverbound 0x03 => client_command
    route play.serverbound 0x04 => settings
    route play.serverbound 0x05 => tab_complete_play_serverbound
    route play.serverbound 0x06 => transaction_play_serverbound
    route play.serverbound 0x07 => enchant_item
    route play.serverbound 0x08 => window_click
    route play.serverbound 0x09 => close_window_play_serverbound
    route play.serverbound 0x0a => custom_payload_play_serverbound
    route play.serverbound 0x0b => edit_book
    route play.serverbound 0x0c => query_entity_nbt
    route play.serverbound 0x0d => use_entity
    route play.serverbound 0x0e => keep_alive_play_serverbound
    route play.serverbound 0x0f => flying
    route play.serverbound 0x10 => position_play_serverbound
    route play.serverbound 0x11 => position_look
    route play.serverbound 0x12 => look
    route play.serverbound 0x13 => vehicle_move_play_serverbound
    route play.serverbound 0x14 => steer_boat
    route play.serverbound 0x15 => pick_item
    route play.serverbound 0x16 => craft_recipe_request
    route play.serverbound 0x17 => abilities_play_serverbound
    route play.serverbound 0x18 => block_dig
    route play.serverbound 0x19 => entity_action
    route play.serverbound 0x1a => steer_vehicle
    route play.serverbound 0x1b => crafting_book_data
    route play.serverbound 0x1c => name_item
    route play.serverbound 0x1d => resource_pack_receive
    route play.serverbound 0x1e => advancement_tab
    route play.serverbound 0x1f => select_trade
    route play.serverbound 0x20 => set_beacon_effect
    route play.serverbound 0x21 => held_item_slot_play_serverbound
    route play.serverbound 0x22 => update_command_block
    route play.serverbound 0x23 => update_command_block_minecart
    route play.serverbound 0x24 => set_creative_slot
    route play.serverbound 0x25 => update_structure_block
    route play.serverbound 0x26 => update_sign
    route play.serverbound 0x27 => arm_animation
    route play.serverbound 0x28 => spectate
    route play.serverbound 0x29 => block_place
    route play.serverbound 0x2a => use_item
    route status.clientbound 0x00 => server_info
    route status.clientbound 0x01 => ping_status_clientbound
    route status.serverbound 0x00 => ping_start
    route status.serverbound 0x01 => ping_status_serverbound
}
