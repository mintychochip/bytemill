// Connection packets from the same 2026.02.17 decompile.
//
// com.hypixel.hytale.protocol.packets.connection.{Connect,Disconnect,Ping,Pong}
// and the enums ClientType, DisconnectType, PongType.
//
// Nullable fields are a leading bitset, not a skipped encoding. Ping and Pong
// always occupy the 12-byte InstantData slot: bit 0 says whether those bytes
// are a timestamp or padding. Connect's variable tail is an offset table
// (fixed block is 66 bytes, VARIABLE_BLOCK_START). Java seeks to each offset;
// serialize writes the present fields packed, in order, and stores -1 for an
// absent one. This schema reads that packed order. A payload whose offsets
// point elsewhere is not this layout.

import "../std/integers.bml"
import "../std/varint.bml"
import "core.bml"

packet connect {
    null_bits:                u8
    protocol_crc:             i32le
    protocol_build_number:    i32le
    client_version:           bytes(20)
    client_type:              u8
    uuid_msb:                 i64be
    uuid_lsb:                 i64be
    username_offset:          i32le
    identity_token_offset:    i32le
    language_offset:          i32le
    referral_data_offset:     i32le
    referral_source_offset:   i32le
    username:                 string(16)
    if (null_bits & 1) != 0 {
        identity_token: string(8192)
    }
    language: string(16)
    if (null_bits & 2) != 0 {
        referral_len:  varint
        referral_data: bytes(referral_len)
    }
    if (null_bits & 4) != 0 {
        referral_source: host_address
    }
}

packet disconnect {
    null_bits: u8
    type:      u8
    if (null_bits & 1) != 0 {
        reason: string(4096000)
    }
}

packet ping {
    null_bits:               u8
    id:                      i32le
    time_seconds:            i64le
    time_nanos:              i32le
    last_ping_value_raw:     i32le
    last_ping_value_direct:  i32le
    last_ping_value_tick:    i32le
    time_present = (null_bits & 1) != 0
}

packet pong {
    null_bits:          u8
    id:                 i32le
    time_seconds:       i64le
    time_nanos:         i32le
    type:               u8
    packet_queue_size:  i16le
    time_present = (null_bits & 1) != 0
}
