// Hytale dedicated-server protocol, build pinned by the decompile
// soksx/hytale-protocol version/2026.02.17-255364b8e.
//
// There is no Minecraft-style protocol number. Connect.protocolCrc and
// protocolBuildNumber identify the build. `id = 0` is a placeholder so the
// protocol block parses.
//
// Frame, from PacketDecoder / PacketIO.writeFramedPacket: int32le payload
// length (the bytes AFTER the id, not including it), int32le packet id, then
// that many payload bytes. Zstd wraps the payload only when the packet's
// IS_COMPRESSED flag is set; none of these four are compressed.
//
// bml's frame decoder reads this block: `payload: bytes(length)` takes
// exactly `length` bytes. `--state` takes the whole frame;
// `--packet` takes the payload after the id.

import "../std/integers.bml"
import "connection.bml"

protocol hytale @ v2026_02_17 {
    id = 0
    frame default {
        length:  i32le
        id:      i32le
        payload: bytes(length)
    }

    route default.serverbound 0 => connect
    route default.serverbound 1 => disconnect
    route default.clientbound 1 => disconnect
    route default.clientbound 2 => ping
    route default.serverbound 3 => pong
}
