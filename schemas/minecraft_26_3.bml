// Minecraft Java Edition 26.3 — protocol 777 (see minecraft.wiki)

import "std/integers.bml"
import "std/varint.bml"
import "minecraft_core.bml"

enum intent : varint {
    status = 1
    login = 2
    transfer = 3
}

packet handshake {
    protocol_version: varint
    server_address:   string(255)
    server_port:      u16be
    intent:           varint
    require           protocol_version == 777
}

packet legacy_server_list_ping {
    payload: u8
}

packet status_request { }

packet status_response {
    json: string(32767)
}

packet ping_request {
    timestamp: i64be
}

packet pong_response {
    timestamp: i64be
}

packet login_start {
    name:        string(16)
    player_uuid: uuid
}

packet encryption_response {
    secret_length:       varint
    secret:              i8[] count = secret_length
    verify_token_length: varint
    verify_token:        i8[] count = verify_token_length
}

packet keep_alive {
    keep_alive_id: i64be
}

// Routes: schemas/minecraft_26_3_wiki.bml (full protocol 777 surface from minecraft.wiki)
