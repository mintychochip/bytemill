// Minecraft Java Edition — shared wire encodings (protocol-family stable).
// Integers, boolean, and VarInt live in schemas/std and are imported.

import "std/integers.bps"
import "std/varint.bps"

encoding string(max_chars = 32767) {
    byte_len: varint
    value:    bytes(byte_len) as utf8
    require   utf16_units(value) <= max_chars
}

encoding identifier = {
    ...string(32767)
}

encoding uuid = {
    msb: u64be
    lsb: u64be
}

// Player profile: UUID, username, then Mojang-style properties.
encoding game_profile = {
    profile_uuid: uuid
    username:     string(16)
    properties_count: varint
    properties: {
        name:  string(64)
        value: string(32767)
        has_signature: boolean
        if has_signature {
            signature: string(1024)
        }
    }[] count = properties_count
}

encoding position = {
    raw: u64be
    x = sign_extend(raw >> 38, 26)
    y = sign_extend(raw % 4096, 12)
    z = sign_extend((raw >> 12) % 67108864, 26)
}

// Entity metadata entries. The `kind` tag selects the value layout; ids follow
// minecraft.wiki (Byte=0 … Dye Color=43). Types with registry-dependent
// payloads (Particle, Particles, Slot, Text Component, Resolvable Profile)
// carry their fixed framing and stop at the registry boundary.
encoding meta_entry = {
    index: u8
    kind:  varint
    value: match kind {
        0  => i8
        1  => varint
        2  => varlong
        3  => f32be
        4  => string(32767)
        5  => text_component
        6  => { has_value: boolean, if has_value { value: text_component } }
        7  => slot
        8  => boolean
        9  => { x: f32be, y: f32be, z: f32be }
        10 => position
        11 => { has_value: boolean, if has_value { value: position } }
        12 => varint
        13 => { has_value: boolean, if has_value { value: uuid } }
        14 => varint
        15 => varint
        16 => particle_data
        17 => { count: varint, items: particle_data[] count = count }
        18 => { villager_type: varint, profession: varint, level: varint }
        19 => varint
        20 => varint
        21 => varint
        22 => varint
        23 => varint
        24 => varint
        25 => varint
        26 => varint
        27 => varint
        28 => varint
        29 => varint
        30 => varint
        31 => varint
        32 => varint
        33 => {
            has_dimension: boolean
            if has_dimension {
                dimension: identifier
                position: position
            }
        }
        34 => { id: varint, if id == 0 { value: rest } }
        35 => varint
        36 => varint
        37 => varint
        38 => varint
        39 => { x: f32be, y: f32be, z: f32be }
        40 => { x: f32be, y: f32be, z: f32be, w: f32be }
        41 => rest
        42 => varint
        43 => varint
    }
}

encoding entity_metadata = {
    entries: meta_entry[] until 0xFF
}

// --- NBT (network format, protocol >= 764: root compound carries no name) ---

encoding nbt_nothing = {
}

encoding nbt_string = {
    byte_len: u16be
    value:    bytes(byte_len) as utf8
}

encoding nbt_entry = {
    tag_type: u8
    name:     nbt_string
    ...nbt_payload
}

// TAG_Compound payload (records until the TAG_End terminator).
encoding nbt_compound_body = {
    entries: nbt_entry[] until 0x00
}

// TAG_List payload: element type, then count, then elements without type prefixes.
encoding nbt_list_body = {
    elem_type: u8
    count:     i32be
    items: { v: match elem_type {
        1  => i8
        2  => i16be
        3  => i32be
        4  => i64be
        5  => f32be
        6  => f64be
        7  => { byte_len: i32be, data: bytes(byte_len) }
        8  => nbt_string
        9  => nbt_list_body
        10 => nbt_compound_body
        0 => nbt_nothing
    } }[] count = count
}

// Payload of a tag; the tag type is read from the enclosing scope's tag_type field.
// NBT ids: 1 byte, 2 short, 3 int, 4 long, 5 float, 6 double, 7 byte array,
// 8 string, 9 list, 10 compound, 11 int array, 12 long array.
encoding nbt_payload = {
    value: match tag_type {
        1  => i8
        2  => i16be
        3  => i32be
        4  => i64be
        5  => f32be
        6  => f64be
        7  => { byte_len: i32be, data: bytes(byte_len) }
        8  => nbt_string
        9  => nbt_list_body
        10 => nbt_compound_body
        11 => { byte_len: i32be, data: bytes(byte_len * 4) }
        12 => { byte_len: i32be, data: bytes(byte_len * 8) }
        0 => nbt_nothing
    }
}

// Network NBT (protocol >= 764): the root tag's id, then its payload with no root
// name. A compound root is `0a`, its entries, then `00`; a null tag is a lone
// `00` (TAG_End has no payload). Java's NbtIo.writeAnyTag.
encoding nbt = {
    tag_type: u8
    ...nbt_payload
}

// 26.3 Text Component: an NBT tag — String Tag for plain text, Compound otherwise.
encoding text_component = {
    ...nbt
}

// Scoreboard number format: registry dispatch (0 blank, 1 styled, 2 fixed).
// Styled carries a Style and fixed a Component; both are network NBT.
encoding number_format = {
    format_type: varint
    if format_type == 1 {
        style: nbt
    }
    if format_type == 2 {
        content: text_component
    }
}

// Update Teams settings block (create + update info actions).
encoding team_settings = {
    display_name:        text_component
    prefix:              text_component
    suffix:              text_component
    name_tag_visibility: varint
    collision_rule:      varint
    has_team_color:      boolean
    if has_team_color {
        team_color: varint
    }
    friendly_flags: i8
}

// Holder<ChatType>: registry id + 1, or 0 followed by an inline ChatType: two
// ChatTypeDecorations (chat, narration), each a translation key, parameter ids
// (sender/target/content) and a Style (network NBT). They are spelled out because
// a generated packet struct has one namespace, so an encoding cannot be used twice.
encoding chat_type_holder = {
    holder_id: varint
    if holder_id == 0 {
        chat_translation_key:       string(32767)
        chat_parameters_count:      varint
        chat_parameters:            varint[] count = chat_parameters_count
        chat_style:                 nbt
        narration_translation_key:  string(32767)
        narration_parameters_count: varint
        narration_parameters:       varint[] count = narration_parameters_count
        narration_style:            nbt
    }
}

// ChatType.Bound: the chat type, the sender name, an optional target name.
encoding chat_type_bound = {
    chat_type:       chat_type_holder
    sender_name:     text_component
    has_target_name: boolean
    if has_target_name {
        target_name: text_component
    }
}

// Rotation angle in steps of 1/256 of a full turn.
encoding angle = u8

// Sound Event: either an inline definition or a registry reference + 1.
encoding sound_event = {
    name:             identifier
    has_fixed_range:  boolean
    if has_fixed_range {
        fixed_range: f32be
    }
}

// --- Registry-tagged payloads (v1 stops at the registry boundary) ---

// "ID or X": 0 means the value follows inline; otherwise registry ID + 1.
// The inline body is registry-keyed, so v1 records the id and stops.
encoding id_or_sound_event = {
    id: varint
    if id == 0 {
        value: sound_event
    }
}

// ID Set: either a tag name (Type 0) or an inline list of `Type - 1` ids.
encoding id_set = {
    type: varint
    if type == 0 {
        tag_name: identifier
    }
    if type > 0 {
        ids: varint[] count = type - 1
    }
}

// Material ingredient: RegistryTag<Material> on the wire (same layout as id_set).
encoding ingredient = id_set

// Item stack template (item, count, component patch). Stops at the patch's
// added/removed counts: a non-empty patch carries registry-keyed component
// payloads BPS cannot walk, the same boundary `slot` has.
encoding item_stack_template = {
    item_id: varint
    item_count: varint
    component_added: varint
    component_removed: varint
}

// Slot Display: minecraft:slot_display registry ordinal, then variant payload.
encoding slot_display = {
    type: varint
    value: match type {
        0  => nbt_nothing
        1  => nbt_nothing
        2  => { display: slot_display }
        3  => { source: slot_display, component_type: varint }
        4  => { item_id: varint }
        5  => item_stack_template
        6  => ingredient
        7  => { dye: slot_display, target: slot_display }
        8  => {
            base: slot_display
            trim_material: slot_display
            // Holder<TrimPattern>: registry id + 1, or 0 and an inline pattern.
            trim_pattern_id: varint
            if trim_pattern_id == 0 {
                trim_pattern_asset: identifier
                trim_pattern_description: text_component
                trim_pattern_decal: boolean
            }
        }
        9  => { input: slot_display, remainder: slot_display }
        10 => {
            contents_count: varint
            contents: slot_display[] count = contents_count
        }
    }
}

// Recipe Display: minecraft:recipe_display registry ordinal, then variant payload.
encoding recipe_display = {
    type: varint
    value: match type {
        0 => {
            ingredients_count: varint
            ingredients: slot_display[] count = ingredients_count
            result: slot_display
            crafting_station: slot_display
        }
        1 => {
            width: varint
            height: varint
            ingredients_count: varint
            ingredients: slot_display[] count = ingredients_count
            result: slot_display
            crafting_station: slot_display
        }
        2 => {
            ingredient: slot_display
            fuel: slot_display
            result: slot_display
            crafting_station: slot_display
            duration: varint
            experience: f32be
        }
        3 => {
            ingredient: slot_display
            result: slot_display
            crafting_station: slot_display
        }
        4 => {
            template: slot_display
            base: slot_display
            addition: slot_display
            result: slot_display
            crafting_station: slot_display
        }
    }
}

// --- Bit sets ---
//
// A bit set as ByteBufCodecs.BIT_SET writes it: a length-prefixed byte array
// (BitSet.toByteArray()). Chat filter masks and chunk light masks use this form.

encoding bitset = {
    byte_len: varint
    data:     bytes(byte_len)
}

// FilterMask (chat): enum ordinal, then a length-prefixed byte array when
// PARTIALLY_FILTERED (Java BITSET = BYTE_ARRAY of BitSet.toByteArray()).
encoding filter_mask = {
    mask_type: varint
    if mask_type == 2 {
        mask_byte_len: varint
        mask_bytes: bytes(mask_byte_len)
    }
}

encoding fixed_bitset(bits = 64) {
    data: bytes(1 + (bits - 1) / 8)
}

// --- Particles ---
//
// Particle data is keyed by the particle_type registry id: the order vanilla's
// ParticleTypes registers them in (128 types in 26.3). Only 22 carry a payload;
// the rest send none. The tag is read inside the encoding so the match resolves
// in scope.
encoding particle_data = {
    particle_type: varint
    value: match particle_type {
        1   => block_state           // block
        2   => block_state           // block_marker
        7   => water_blocks          // geyser
        8   => water_blocks_burst    // geyser_base
        9   => water_blocks_burst    // geyser_poof
        10  => water_blocks          // geyser_plume
        15  => power                 // dragon_breath
        21  => dust_color_scale      // dust
        22  => dust_color_transition // dust_color_transition
        23  => spell_particle        // effect
        28  => dust_color            // entity_effect
        36  => block_state           // falling_dust
        46  => dust_color            // tinted_leaves
        48  => sculk_charge_roll     // sculk_charge
        52  => dust_color            // flash
        56  => spell_particle        // instant_effect
        57  => item_stack_template   // item
        58  => vibration_particle    // vibration
        59  => trail_data            // trail
        115 => shriek_delay          // shriek
        121 => block_state           // dust_pillar
        125 => block_state           // block_crumble
        _ => nbt_nothing
    }
}

encoding block_state         = { block_state: varint }
encoding water_blocks        = { water_blocks: i32be }
encoding water_blocks_burst  = { water_blocks: i32be, burst_impulse_base: f32be }
encoding power               = { power: f32be }
encoding dust_color          = { color: i32be }
encoding dust_color_scale    = { color: i32be, scale: f32be }
encoding dust_color_transition = { from_color: i32be, to_color: i32be, scale: f32be }
encoding spell_particle      = { color: i32be, power: f32be }
encoding sculk_charge_roll   = { roll: f32be }
encoding shriek_delay        = { delay: varint }

// PositionSource: registry id (0 block, 1 entity), then that source's fields.
encoding position_source = {
    source_type: varint
    value: match source_type {
        0 => { block_position: position }
        1 => { entity_id: varint, y_offset: f32be }
    }
}
encoding vibration_particle = {
    destination:      position_source
    arrival_in_ticks: varint
}
encoding trail_data = {
    x: f64be
    y: f64be
    z: f64be
    color: i32be
    duration: varint
}

// A light section: ByteBufCodecs.byteArray(2048), a length-prefixed byte array.
encoding light_array = {
    byte_len: varint
    data:     bytes(byte_len)
}

// ClientboundLightUpdatePacketData: four bit sets (sky and block masks, then the
// empty sky and block masks), then the sky and block light arrays.
encoding light_data = {
    sky_light_mask:           bitset
    block_light_mask:         bitset
    empty_sky_light_mask:     bitset
    empty_block_light_mask:   bitset
    sky_light_arrays_count:   varint
    sky_light_arrays:         light_array[] count = sky_light_arrays_count
    block_light_arrays_count: varint
    block_light_arrays:       light_array[] count = block_light_arrays_count
}

// --- Registry-dependent (opaque ids in v1, see spec §2) ---

// Slot: fixed frame. Component payload formats are keyed by the
// minecraft:data_component_type registry, which v1 does not model; the add-array
// payloads are therefore not walked.
encoding slot = {
    item_count: varint
    if item_count > 0 {
        item_id:      varint
        add_count:    varint
        remove_count: varint
    }
}

// Hashed Slot (serverbound): a present flag, the item registry id and count, then
// the HashedPatchMap: the components added (type id + a 32-bit hash of the value)
// and removed (type ids). Unlike a Slot's patch, nothing here is registry-keyed.
encoding hashed_patch_map = {
    added_count: varint
    added: {
        component_type: varint
        hash:           i32be
    }[] count = added_count
    removed_count: varint
    removed:       varint[] count = removed_count
}

encoding hashed_slot = {
    has_item: boolean
    if has_item {
        item_id:    varint
        item_count: varint
        components: hashed_patch_map
    }
}
