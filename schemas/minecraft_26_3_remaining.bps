// Minecraft 26.3 (protocol 777) — final transcription batch.
// Remaining packets whose wiki layouts are registry-independent and fully
// documented. Registry-dependent payloads (component data, particle data,
// recipe/slot displays) keep their enclosing framing and stop at the opaque
// byte-array boundary, which is where the v1 registry boundary lies.

import "std/integers.bps"
import "std/varint.bps"
import "minecraft_core.bps"

// --- Spawn Entity (LpVec3 velocity) ---

// LpVec3: 1 byte when every component is zero, otherwise 2 bytes plus an
// optional continuation-flag tail. The wiki pins the bit layout:
//   byte1 & 0x04 -> the scale factor continues in a VarInt after byte 6.
// The packed doubles stay raw so the framing around them is exact. A zero
// vector (an entity with no velocity) is the single byte 0x00.

encoding lpvec3(bits = 46) {
    scale_byte: u8
    if scale_byte != 0 {
        packed_second:      u8
        packed_high_4:      u32be
        continuation_scale: varint if scale_byte & 0x04 != 0
    }
}

packet add_entity {
    entity_id: varint
    entity_uuid: uuid
    type: varint
    x: f64be
    y: f64be
    z: f64be
    velocity: lpvec3
    pitch: u8
    yaw: u8
    head_yaw: u8
    data: varint
}

// --- Particle ---

// Particle data is keyed by the particle_type registry id; the encoding reads
// the id itself so the match on the payload resolves in scope.
packet level_particles {
    particle: particle_data
    override_limiter: boolean
    always_visible: boolean
    x: f64be
    y: f64be
    z: f64be
    x_distance: f32be
    y_distance: f32be
    z_distance: f32be
    x_max_speed: f32be
    y_max_speed: f32be
    z_max_speed: f32be
    particle_count: varint
    randomization_type: varint
}

// --- Explosion ---

packet explode {
    center_x: f64be
    center_y: f64be
    center_z: f64be
    radius: f32be
    block_count: i32be
    has_player_knockback: boolean
    if has_player_knockback {
        player_knockback_x: f64be
        player_knockback_y: f64be
        player_knockback_z: f64be
    }
    particle: particle_data
    sound: id_or_sound_event
    block_particles_count: varint
    block_particles: {
        particle: particle_data
        scaling: f32be
        speed: f32be
        weight: varint
    }[] count = block_particles_count
    play_sound: boolean
}

// --- Chunk data + light ---

// Chunk payload: a serialized section blob. v1 keeps the framing; the palette
// and block-state bit packing are registry-dependent.
// Both payloads are byte arrays behind a VarInt length, the shape
// `NetworkBuffer.BYTE_ARRAY` writes; the length field is declared so the
// payload does not read to the end of the packet.
packet level_chunk_with_light {
    chunk_x: i32be
    chunk_z: i32be
    chunk_data_len: varint
    chunk_data: bytes(chunk_data_len)
    light_data_len: varint
    light_data: bytes(light_data_len)
}

packet light_update {
    chunk_x: varint
    chunk_z: varint
    data: rest
}

// --- Merchant offers ---

packet merchant_offers {
    window_id: varint
    trades_count: varint
    trades: {
        // Trade items are Slots; v1 reads the slot frame and stops at the
        // component-data boundary rather than guessing a length.
        input_item_1: slot
        output_item: slot
        has_input_item_2: boolean
        if has_input_item_2 {
            input_item_2: slot
        }
        trade_disabled: boolean
        trade_uses: i32be
        max_trade_uses: i32be
        xp: i32be
        special_price: i32be
        price_multiplier: f32be
        demand: i32be
    }[] count = trades_count
    villager_level: varint
    experience: varint
    is_regular_villager: boolean
    can_restock: boolean
}

// --- Recipe book add / ghost recipe / recipes ---

// Recipe Display is a registry-tagged union: the id names the shape, and the
// shape's fields are registry-dependent. The schema reads the tag and stops at
// the registry boundary rather than guessing a length.
packet place_ghost_recipe {
    window_id: varint
    recipe_display: recipe_display
}

packet recipe_book_add {
    recipes_count: varint
    recipes: {
        recipe_id: varint
        recipe_display: recipe_display
        // Java OPTIONAL_VAR_INT: 0 absent, otherwise stored value + 1.
        group_encoded: varint
        category_id: varint
        has_crafting_requirements: boolean
        if has_crafting_requirements {
            crafting_requirements_count: varint
            crafting_requirements: ingredient[] count = crafting_requirements_count
        }
        flags: i8
    }[] count = recipes_count
    replace: boolean
}

packet update_recipes {
    property_sets_count: varint
    property_sets: {
        property_set_id: identifier
        items_count: varint
        items: varint[] count = items_count
    }[] count = property_sets_count
    stonecutter_recipes_count: varint
    stonecutter_recipes: {
        ingredients: ingredient
        slot_display: slot_display
    }[] count = stonecutter_recipes_count
}

// --- Player info update ---

// Player Actions are a flag-masked variable layout (Add Player, Initialize
// Chat, Game Mode, Listed, Latency, Display Name, List Priority, Hat).
packet player_info_update {
    actions: u8
    players_count: varint
    players: {
        uuid: uuid
        if actions & 0x01 != 0 {
            name: string(16)
            properties_count: varint
            properties: {
                name:  string(64)
                value: string(32767)
                has_signature: boolean
                if has_signature {
                    signature: string(1024)
                }
            }[] count = properties_count
        }
        if actions & 0x02 != 0 {
            has_chat_session: boolean
            if has_chat_session {
                chat_session_id: uuid
                public_key_expiry: i64be
                public_key_byte_len: varint
                public_key: bytes(public_key_byte_len)
                key_signature_byte_len: varint
                key_signature: bytes(key_signature_byte_len)
            }
        }
        if actions & 0x04 != 0 {
            game_mode: varint
        }
        if actions & 0x08 != 0 {
            listed: boolean
        }
        if actions & 0x10 != 0 {
            ping: varint
        }
        if actions & 0x20 != 0 {
            has_display_name: boolean
            if has_display_name {
                display_name: text_component
            }
        }
        if actions & 0x40 != 0 {
            list_order: varint
        }
        if actions & 0x80 != 0 {
            show_hat: boolean
        }
    }[] count = players_count
}

// --- Chat ---

// Player Chat Message: an optional 256-byte header signature, the signed body
// (message, timestamp, salt, previous-message signatures), an optional unsigned
// component, the FilterMask, then ChatType.Bound.
packet player_chat {
    global_index: varint
    sender: uuid
    index: varint
    has_signature: boolean
    if has_signature {
        signature: bytes(256)
    }
    message: string(256)
    timestamp: i64be
    salt: i64be
    previous_messages_count: varint
    previous_messages: {
        packed_id: varint
        if packed_id == 0 {
            signature: bytes(256)
        }
    }[] count = previous_messages_count
    has_unsigned_content: boolean
    if has_unsigned_content {
        unsigned_content: text_component
    }
    filter_mask: filter_mask
    chat_type: chat_type_bound
}

packet disguised_chat {
    message: text_component
    chat_type: chat_type_bound
}

// --- Player position sync / vehicle ---

// Teleport Flags: a bit field where the low 8 bits mark relative application.
packet player_position {
    teleport_id: varint
    x:           f64be
    y:           f64be
    z:           f64be
    velocity_x:  f64be
    velocity_y:  f64be
    velocity_z:  f64be
    yaw:         f32be
    pitch:       f32be
    flags:       i32be
}

packet teleport_entity {
    entity_id: varint
    x:         f64be
    y:         f64be
    z:         f64be
    delta_x:   f64be
    delta_y:   f64be
    delta_z:   f64be
    yaw:       f32be
    pitch:     f32be
    flags:     i32be
    on_ground: boolean
}

// --- Scores and teams ---

packet set_entity_motion {
    entity_id: varint
    velocity:  lpvec3
}

packet set_score {
    entity_name:   string(32767)
    objective_name: string(32767)
    value:         varint
    has_display_name: boolean
    if has_display_name {
        display_name: text_component
    }
    has_number_format: boolean
    if has_number_format {
        number_format: number_format
    }
}

packet set_objective {
    objective_name: string(32767)
    mode:           i8
    if mode == 0 || mode == 2 {
        objective_value: text_component
        type:            varint
        has_number_format: boolean
        if has_number_format {
            number_format: number_format
        }
    }
}

packet set_player_team {
    team_name: string(32767)
    action:    i8
    if action == 0 || action == 2 {
        settings: team_settings
    }
    if action == 0 || action == 3 || action == 4 {
        entities_count: varint
        entities: string(32767)[] count = entities_count
    }
}

// --- Advancements ---

// Advancement display data (DisplayInfo): title, description, icon, frame type,
// a flags int (0x1 background present, 0x2 show toast, 0x4 hidden), then the
// background texture when flagged. The tab coordinates are not here: vanilla's
// PositionedAdvancement writes x and y after the whole advancement, once per
// mapping (the wiki nests them under display).
encoding advancement_display = {
    title:       text_component
    description: text_component
    icon:        item_stack_template
    frame_type:  varint
    flags:       i32be
    if flags & 0x01 != 0 {
        background_texture: identifier
    }
}

// Advancement: an optional parent id, an optional display, requirement OR-groups
// of criterion names, and the telemetry flag.
encoding advancement_mapping_value = {
    has_parent_id: boolean
    if has_parent_id {
        parent_id: identifier
    }
    has_display_data: boolean
    if has_display_data {
        display_data: advancement_display
    }
    requirements_count: varint
    requirements: {
        criteria_count: varint
        criteria: string(32767)[] count = criteria_count
    }[] count = requirements_count
    sends_telemetry_data: boolean
}

packet update_advancements {
    reset: boolean
    advancement_mappings_count: varint
    advancement_mappings: {
        key:   identifier
        value: advancement_mapping_value
        x:     f32be
        y:     f32be
    }[] count = advancement_mappings_count
    identifiers_to_remove_count: varint
    identifiers_to_remove: identifier[] count = identifiers_to_remove_count
    progress_mappings_count: varint
    progress_mappings: {
        key: identifier
        criteria_count: varint
        criteria: {
            criterion_identifier: string(32767)
            has_date_of_achieving: boolean
            if has_date_of_achieving {
                date_of_achieving: i64be
            }
        }[] count = criteria_count
    }[] count = progress_mappings_count
    show_advancements: boolean
}

// --- Entity metadata + equipment ---

// Equipment: slot byte with the top bit marking "more entries follow", each
// followed by a Slot. Slot payloads stop at the v1 registry boundary
// (component data beyond count/id/add/remove is not represented), so the
// entry item is a v1 Slot frame.
packet set_equipment {
    entity_id: varint
    entries_count: varint
    entries: {
        slot: u8
        item: slot
    }[] count = entries_count
}

// --- Sound events (ID or X) ---

// --- Server links / dialog / waypoint ---

packet server_links {
    links_count: varint
    links: {
        is_builtin: boolean
        if is_builtin {
            label_id: varint
        }
        if !is_builtin {
            label: text_component
        }
        url: string(32767)
    }[] count = links_count
}

packet show_dialog {
    dialog_id: varint
    if dialog_id == 0 {
        dialog: nbt
    }
}

packet waypoint {
    operation: varint
    is_uuid: boolean
    if is_uuid {
        identifier_uuid: uuid
    }
    if !is_uuid {
        identifier: string(32767)
    }
    icon_style: identifier
    has_color: boolean
    if has_color {
        red:   u8
        green: u8
        blue:  u8
    }
    waypoint_type: varint
    if waypoint_type == 1 {
        x: varint
        y: varint
        z: varint
    }
    if waypoint_type == 2 {
        x: varint
        z: varint
    }
    if waypoint_type == 3 {
        angle: f32be
    }
}

// --- Debug subscriptions ---

packet debug_event {
    event_type: varint
    payload:   rest
}

// The block-state properties are the one payload whose layout this schema
// cannot transcribe: the value type is subscription-dependent and the wiki
// documents no boundary, so it stays a `rest` marker. That is the only packet
// without a pinned reference vector, and its test says so.
packet debug_block_value {
    subscription_type: varint
    if subscription_type == 2 {
        block_position: position
        block_state: varint
        block_states_count: varint
        block_states: {
            block_type: varint
            properties: rest
        }[] count = block_states_count
    }
}

packet debug_chunk_value {
    subscription_type: varint
    if subscription_type == 0 {
        x: i32be
        z: i32be
        block_position_y: i32be
        magma_count: i32be
        extra_bedrock_count: i32be
    }
    if subscription_type == 1 {
        x: i32be
        z: i32be
        block_states_count: varint
        block_states: {
            block_state: varint
            states_count: varint
        }[] count = block_states_count
    }
}

packet debug_entity_value {
    subscription_type: varint
    if subscription_type == 3 {
        x: f32be
        y: f32be
        z: f32be
    }
    if subscription_type == 4 {
        entities_count: varint
        entities: {
            entity_id:  i32be
            block_state: varint
            x: f64be
            y: f64be
            z: f64be
            has_passing: boolean
            if has_passing {
                passing: f64be
            }
        }[] count = entities_count
    }
}

// --- Commands (brigadier node tree) ---

// Commands: the Brigadier node graph. Node type is flags & 0x03
// (0 root, 1 literal, 2 argument); 0x04 executable; 0x08 has redirect;
// 0x10 has suggestions type (argument nodes only).
packet commands {
    nodes_count: varint
    nodes: {
        flags: u8
        node_type = flags & 0x03
        children_count: varint
        children: varint[] count = children_count
        if flags & 0x08 != 0 {
            redirect_node: varint
        }
        if node_type != 0 {
            name: string(32767)
        }
        if node_type == 2 {
            parser_id: varint
            // Parser Properties are registry-keyed and variable length. v1 stops
            // at the boundary rather than modelling Brigadier property shapes.
            payload: id_or_payload
        }
        if flags & 0x10 != 0 && node_type == 2 {
            suggestions_type: identifier
        }
    }[] count = nodes_count
    root_index: varint
}

// --- Interact (LpVec3 target offset) ---

packet interact {
    entity_id:     varint
    hand:          varint
    target_offset: lpvec3
    sneak:         boolean
}
